---
import { church } from '../data/church';
// Standalone "coming soon" splash. Does NOT use BaseLayout (no header/footer)
// and is excluded from the maintenance redirect so it never loops.
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Freedom Church — Em breve</title>
    <meta name="description" content="Freedom Church — em breve online. Igreja para todas as nações em Kensington, Maryland." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050505" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;1,9..144,300&family=Geist:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root { --gold: #C9A961; --ink: #050505; --cream: #FAFAF7; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: "Geist", system-ui, sans-serif;
        background: var(--ink);
        color: var(--cream);
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
        overflow: hidden;
        position: relative;
      }
      .glow {
        position: absolute;
        border-radius: 9999px;
        filter: blur(80px);
        opacity: 0.4;
        pointer-events: none;
        animation: float 8s ease-in-out infinite;
      }
      .glow-1 { width: 36rem; height: 36rem; top: -10rem; left: -8rem; background: radial-gradient(circle, rgba(201,169,97,0.45), transparent 70%); }
      .glow-2 { width: 32rem; height: 32rem; bottom: -10rem; right: -8rem; background: radial-gradient(circle, rgba(228,99,71,0.35), transparent 70%); animation-delay: -4s; }
      @keyframes float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-24px) } }
      @keyframes fade-up { from { opacity: 0; transform: translateY(24px) } to { opacity: 1; transform: translateY(0) } }
      .wrap { position: relative; z-index: 1; max-width: 36rem; animation: fade-up 1s cubic-bezier(0.16,1,0.3,1) both; }
      .logo { width: 96px; height: 96px; margin: 0 auto 2rem; filter: invert(1); animation: float 6s ease-in-out infinite; }
      .eyebrow { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.3em; color: var(--gold); margin-bottom: 1.25rem; }
      h1 { font-family: "Fraunces", serif; font-weight: 400; line-height: 0.95; letter-spacing: -0.03em; font-size: clamp(3rem, 12vw, 6rem); }
      h1 em { font-style: italic; font-weight: 300; color: var(--gold); }
      .langs { margin-top: 1.5rem; color: #9A9786; font-size: 1.05rem; line-height: 1.6; }
      .info { margin-top: 2rem; color: #C8C5B8; font-size: 0.95rem; line-height: 1.7; }
      .ig {
        display: inline-flex; align-items: center; gap: 0.6rem;
        margin-top: 2.5rem; padding: 1rem 1.75rem; border-radius: 9999px;
        font-weight: 500; color: #050505; text-decoration: none;
        background: linear-gradient(135deg, #DCB967, #C9A961);
        transition: transform .25s, box-shadow .25s;
      }
      .ig:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -12px rgba(201,169,97,0.7); }
      .ig svg { transition: transform .25s; }
      .ig:hover svg { transform: rotate(12deg); }
    </style>
  </head>
  <body>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="wrap">
      <img class="logo" src="/logo.png" alt="Freedom Church" />
      <div class="eyebrow">Freedom Church · Kensington, MD</div>
      <h1>Em <em>breve</em>.</h1>
      <p class="langs">Coming soon · Muy pronto<br />Estamos preparando algo especial.</p>
      <p class="info">
        Cultos aos domingos · 10h30<br />
        {church.address.street} — {church.address.city}, {church.address.state}
      </p>
      <a class="ig" href={church.social.instagram} target="_blank" rel="noopener">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Z"/></svg>
        {church.social.instagramHandle}
      </a>
    </div>
  </body>
</html>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { church } from '../data/church';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = 'Freedom Church';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t('hero.eyebrow')}`;
const desc =
  description ??
  (lang === 'pt'
    ? 'Igreja para todas as nações em Kensington, Maryland. Cultos aos domingos 10h30. Liberdade em Cristo.'
    : lang === 'en'
      ? 'A church for every nation in Kensington, Maryland. Sunday services 10:30 AM. Find freedom in Christ.'
      : 'Iglesia para todas las naciones en Kensington, Maryland. Cultos los domingos 10:30 AM. Libérate en Cristo.');
const ogImage = image ?? '/logo.png';
const canonical = new URL(Astro.url.pathname, Astro.site);

// JSON-LD structured data: Church + Organization
const churchSchema = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: church.name,
  alternateName: church.brandHandle,
  url: 'https://ourfreedomchurch.com',
  logo: 'https://ourfreedomchurch.com/logo.png',
  image: 'https://ourfreedomchurch.com/logo.png',
  description: desc,
  email: church.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: church.address.street,
    addressLocality: church.address.city,
    addressRegion: church.address.state,
    postalCode: church.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '10:30',
      closes: '12:00',
    },
  ],
  sameAs: [
    church.social.instagram,
    church.social.youtube,
  ].filter(Boolean),
  founder: church.pastors.map((p) => ({
    '@type': 'Person',
    name: p.name,
    jobTitle: p.role[lang],
    sameAs: p.instagram,
  })),
  knowsLanguage: ['pt-BR', 'en-US', 'es-ES'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Maintenance gate: public visitors on the live domain see /em-breve/.
         The .workers.dev test URL is never blocked. ?preview unlocks a browser. -->
    <script is:inline define:vars={{ maint: SITE.maintenance, hosts: SITE.liveHosts }}>
      (function () {
        if (!maint) return;
        if (location.pathname.indexOf('/em-breve') === 0) return;
        var params = new URLSearchParams(location.search);
        try { if (params.has('preview')) localStorage.setItem('fc_preview', '1'); } catch (e) {}
        var bypass = params.has('preview');
        try { if (localStorage.getItem('fc_preview') === '1') bypass = true; } catch (e) {}
        if (hosts.indexOf(location.hostname) > -1 && !bypass) {
          location.replace('/em-breve/');
        }
      })();
    </script>

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A0908" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,500&family=Geist:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <!-- Alternate language links -->
    <link rel="alternate" hreflang="pt-BR" href={`https://ourfreedomchurch.com${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="en-US" href={`https://ourfreedomchurch.com/en${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="es-ES" href={`https://ourfreedomchurch.com/es${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`https://ourfreedomchurch.com${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />

    <!-- Structured data: Church schema -->
    <script type="application/ld+json" set:html={JSON.stringify(churchSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ink-950 focus:text-cream-50 focus:px-4 focus:py-2 focus:rounded-md"
    >
      Skip to content
    </a>
    <!-- Scroll progress bar -->
    <div
      class="fixed top-0 left-0 z-50 h-[3px] origin-left"
      style="width:100%; transform:scaleX(0); background:linear-gradient(90deg,#C9A961,#E46347);"
      data-scroll-progress
    ></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-triggered fade-up
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -50px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Parallax + scroll progress bar
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        parallaxEls.forEach((el) => {
          const speed = parseFloat(el.dataset.parallax ?? '0.2');
          el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
        });
        if (progressBar) {
          const docH = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docH > 0 ? y / docH : 0;
          progressBar.style.transform = `scaleX(${pct})`;
        }
      }, { passive: true });

      // Scroll-triggered scale reveal (more dramatic than fade-up)
      const scaleObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              scaleObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' },
      );
      document.querySelectorAll('[data-reveal-scale]').forEach((el) => scaleObserver.observe(el));

      // 3D Tilt on hover for .tilt-card
      const tiltCards = document.querySelectorAll<HTMLElement>('.tilt-card');
      if (window.matchMedia('(pointer: fine)').matches) {
        tiltCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            const rotX = -y * 6;
            const rotY = x * 6;
            card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-4px)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      }

      // Live status detection
      // Strategy: fetch /api/live-status.json (Cloudflare Worker that checks YouTube
      // in real-time). Falls back to Sunday 10:00-12:30 ET heuristic if API fails.
      function setLiveDot(isLive: boolean) {
        document.querySelectorAll('[data-live-cta]').forEach((cta) => {
          const dot = cta.querySelector<HTMLElement>('[data-live-dot]');
          if (!dot) return;

          const allColors = ['bg-ink-400', 'bg-ink-500', 'bg-clay-500', 'bg-red-500', 'bg-gold-500'];
          dot.querySelectorAll('span').forEach((s) => {
            allColors.forEach((c) => s.classList.remove(c));
          });
          allColors.forEach((c) => dot.classList.remove(c));

          if (isLive) {
            const spans = dot.querySelectorAll('span');
            if (spans.length > 0) {
              spans.forEach((s) => s.classList.add('bg-red-500'));
              spans[0]?.classList.add('animate-ping');
            } else {
              dot.classList.add('bg-red-500', 'animate-pulse');
            }
            cta.setAttribute('data-status', 'live');
          } else {
            const spans = dot.querySelectorAll('span');
            if (spans.length > 0) {
              spans.forEach((s) => s.classList.add('bg-ink-400'));
              spans[0]?.classList.remove('animate-ping');
            } else {
              dot.classList.add('bg-ink-400');
            }
            cta.setAttribute('data-status', 'offline');
          }
        });
      }

      const YT_CHANNEL = 'UCmItF2T27GJFT6gFJti_9SA';

      async function detectLiveFromYouTube(): Promise<boolean> {
        // Strategy: try multiple CORS proxies to fetch the channel's /live page.
        // YouTube serves a video page if live, channel page if not.
        const targetUrl = `https://www.youtube.com/channel/${YT_CHANNEL}/live`;
        const proxies = [
          `https://api.allorigins.win/raw?url=${encodeURIComponent(targetUrl)}`,
          `https://corsproxy.io/?${encodeURIComponent(targetUrl)}`,
        ];

        for (const proxyUrl of proxies) {
          try {
            const r = await fetch(proxyUrl, { cache: 'no-store' });
            if (!r.ok) continue;
            const html = await r.text();
            // Detect live indicators in the HTML
            if (
              /"isLive":true/.test(html) ||
              /"liveBroadcastDetails":\{"isLiveNow":true/.test(html) ||
              /<meta itemprop="isLiveBroadcast" content="True">/i.test(html)
            ) {
              return true;
            }
            // If the page is clearly the channel home (not a live), short-circuit false
            if (/"videoTab"|"playlistTab"/.test(html) && !/"isLive":true/.test(html)) {
              return false;
            }
          } catch {
            // try next proxy
          }
        }
        // All proxies failed — fall through to heuristic
        throw new Error('live-check unavailable');
      }

      function heuristicLive(): boolean {
        const nowET = new Date(
          new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }),
        );
        const day = nowET.getDay();
        const minutes = nowET.getHours() * 60 + nowET.getMinutes();
        return day === 0 && minutes >= 600 && minutes <= 750;
      }

      async function checkLiveStatus() {
        try {
          const live = await detectLiveFromYouTube();
          setLiveDot(live);
        } catch {
          // Fallback: schedule-based heuristic
          setLiveDot(heuristicLive());
        }
      }

      checkLiveStatus();
      // Re-check every 60 seconds
      setInterval(checkLiveStatus, 60_000);
    </script>

    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1), transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-reveal].in-view {
        opacity: 1;
        transform: translateY(0);
      }
      [data-reveal-delay="1"] { transition-delay: 80ms; }
      [data-reveal-delay="2"] { transition-delay: 160ms; }
      [data-reveal-delay="3"] { transition-delay: 240ms; }
      [data-reveal-delay="4"] { transition-delay: 320ms; }
    </style>
  </body>
</html>

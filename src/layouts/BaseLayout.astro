---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { church } from '../data/church';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = 'Freedom Church';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t('hero.eyebrow')}`;
const desc =
  description ??
  (lang === 'pt'
    ? 'Comunidade brasileira de fé em Kensington, Maryland. Cultos aos domingos 10h30. Liberte-se em Cristo.'
    : lang === 'en'
      ? 'Brazilian community of faith in Kensington, Maryland. Sunday services 10:30 AM. Find freedom in Christ.'
      : 'Comunidad brasileña de fe en Kensington, Maryland. Cultos los domingos 10:30 AM. Libérate en Cristo.');
const ogImage = image ?? '/logo.png';
const canonical = new URL(Astro.url.pathname, Astro.site);

// JSON-LD structured data: Church + Organization
const churchSchema = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: church.name,
  alternateName: church.brandHandle,
  url: 'https://ourfreedomchurch.com',
  logo: 'https://ourfreedomchurch.com/logo.png',
  image: 'https://ourfreedomchurch.com/logo.png',
  description: desc,
  email: church.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: church.address.street,
    addressLocality: church.address.city,
    addressRegion: church.address.state,
    postalCode: church.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '10:30',
      closes: '12:00',
    },
  ],
  sameAs: [
    church.social.instagram,
    church.social.youtube,
  ].filter(Boolean),
  founder: church.pastors.map((p) => ({
    '@type': 'Person',
    name: p.name,
    jobTitle: p.role[lang],
    sameAs: p.instagram,
  })),
  knowsLanguage: ['pt-BR', 'en-US', 'es-ES'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A0908" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,500&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <!-- Alternate language links -->
    <link rel="alternate" hreflang="pt-BR" href={`https://ourfreedomchurch.com${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="en-US" href={`https://ourfreedomchurch.com/en${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="es-ES" href={`https://ourfreedomchurch.com/es${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`https://ourfreedomchurch.com${Astro.url.pathname.replace(/^\/(en|es)/, '')}`} />

    <!-- Structured data: Church schema -->
    <script type="application/ld+json" set:html={JSON.stringify(churchSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ink-950 focus:text-cream-50 focus:px-4 focus:py-2 focus:rounded-md"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-triggered fade-up
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -50px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Parallax
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        parallaxEls.forEach((el) => {
          const speed = parseFloat(el.dataset.parallax ?? '0.2');
          el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
        });
      }, { passive: true });

      // Live status detection
      // Strategy: Sunday between 10:00 and 12:30 America/New_York → assume live
      // (the actual stream stays up during/after; this just controls the "pulse")
      function checkLiveStatus() {
        const nowET = new Date(
          new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }),
        );
        const day = nowET.getDay(); // 0 = Sunday
        const minutes = nowET.getHours() * 60 + nowET.getMinutes();
        const start = 10 * 60;       // 10:00 AM
        const end = 12 * 60 + 30;    // 12:30 PM
        const isLive = day === 0 && minutes >= start && minutes <= end;

        document.querySelectorAll('[data-live-cta]').forEach((cta) => {
          const dot = cta.querySelector<HTMLElement>('[data-live-dot]');
          const label = cta.querySelector<HTMLElement>('[data-live-label]');
          if (!dot) return;

          // Clear existing color classes
          const allColors = ['bg-ink-400', 'bg-ink-500', 'bg-clay-500', 'bg-red-500', 'bg-gold-500'];
          dot.querySelectorAll('span').forEach((s) => {
            allColors.forEach((c) => s.classList.remove(c));
          });
          if (dot.classList.contains('w-2')) {
            // it's the simple dot (mobile)
            allColors.forEach((c) => dot.classList.remove(c));
          }

          if (isLive) {
            // Make it pulse RED
            dot.classList.add('animate-pulse');
            const spans = dot.querySelectorAll('span');
            if (spans.length > 0) {
              spans.forEach((s) => s.classList.add('bg-red-500'));
              // Restore ping animation on first child
              spans[0]?.classList.add('animate-ping');
            } else {
              dot.classList.add('bg-red-500');
            }
            cta.setAttribute('data-status', 'live');
          } else {
            // Gray dot, no animation
            dot.classList.remove('animate-pulse');
            const spans = dot.querySelectorAll('span');
            if (spans.length > 0) {
              spans.forEach((s) => s.classList.add('bg-ink-400'));
              spans[0]?.classList.remove('animate-ping');
            } else {
              dot.classList.add('bg-ink-400');
            }
            cta.setAttribute('data-status', 'offline');
          }
        });
      }
      checkLiveStatus();
      // Re-check every 60 seconds
      setInterval(checkLiveStatus, 60_000);
    </script>

    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1), transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-reveal].in-view {
        opacity: 1;
        transform: translateY(0);
      }
      [data-reveal-delay="1"] { transition-delay: 80ms; }
      [data-reveal-delay="2"] { transition-delay: 160ms; }
      [data-reveal-delay="3"] { transition-delay: 240ms; }
      [data-reveal-delay="4"] { transition-delay: 320ms; }
    </style>
  </body>
</html>

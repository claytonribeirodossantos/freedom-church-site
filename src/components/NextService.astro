---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = {
  pt: [
    { num: '6', label: 'Anos de ministério' },
    { num: '300+', label: 'Famílias alcançadas' },
    { num: '3', label: 'Idiomas' },
    { num: '7', label: 'Ministérios ativos' },
  ],
  en: [
    { num: '6', label: 'Years of ministry' },
    { num: '300+', label: 'Families reached' },
    { num: '3', label: 'Languages' },
    { num: '7', label: 'Active ministries' },
  ],
  es: [
    { num: '6', label: 'Años de ministerio' },
    { num: '300+', label: 'Familias alcanzadas' },
    { num: '3', label: 'Idiomas' },
    { num: '7', label: 'Ministerios activos' },
  ],
}[lang];

const labels = {
  pt: { eyebrow: 'Quem somos em números', title: 'Uma família que cresce em fé.', cta: 'Conheça nossa história' },
  en: { eyebrow: 'Who we are in numbers', title: 'A family growing in faith.', cta: 'Discover our story' },
  es: { eyebrow: 'Quiénes somos en números', title: 'Una familia que crece en fe.', cta: 'Conoce nuestra historia' },
}[lang];
---

<section class="relative py-32 lg:py-40 bg-cream-100 overflow-hidden">
  <div class="container-page">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end mb-16 lg:mb-20">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow">{labels.eyebrow}</span>
        <h2
          class="mt-6 font-display font-medium tracking-tight leading-[0.95] text-ink-950"
          style="font-size: clamp(2.5rem, 6vw, 5.5rem)"
        >
          {labels.title}
        </h2>
      </div>
      <div class="lg:col-span-5" data-reveal data-reveal-delay="1">
        <a href={localizedPath(lang, '/sobre')} class="inline-flex btn btn-ghost">
          {labels.cta}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-4">
      {stats.map((s, i) => (
        <div data-reveal data-reveal-delay={i + 1} class="border-l-2 border-clay-500 pl-6">
          <div class="display-num text-6xl lg:text-7xl xl:text-8xl">{s.num}</div>
          <div class="mt-3 text-sm uppercase tracking-[0.18em] text-ink-600 font-medium">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

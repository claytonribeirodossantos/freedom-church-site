---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const labels = {
  pt: {
    name: 'Nome', namePh: 'Como podemos te chamar',
    email: 'Email', emailPh: 'voce@email.com',
    subject: 'Assunto', subjectPh: 'Sobre o que é?',
    message: 'Mensagem', messagePh: 'Conte para a gente...',
    submit: 'Enviar mensagem',
    sending: 'Enviando...',
    success: 'Recebemos sua mensagem. Respondemos em até 48h.',
    error: 'Houve um problema. Tente novamente ou escreva direto pra ' + church.contact.email,
    info: 'Outras formas de falar com a gente',
    address: 'Endereço', emailLabel: 'Email', social: 'Instagram',
  },
  en: {
    name: 'Name', namePh: 'What we can call you',
    email: 'Email', emailPh: 'you@email.com',
    subject: 'Subject', subjectPh: 'What is it about?',
    message: 'Message', messagePh: 'Tell us...',
    submit: 'Send message',
    sending: 'Sending...',
    success: 'We received your message. We respond within 48h.',
    error: 'There was a problem. Try again or write directly to ' + church.contact.email,
    info: 'Other ways to reach us',
    address: 'Address', emailLabel: 'Email', social: 'Instagram',
  },
  es: {
    name: 'Nombre', namePh: 'Cómo podemos llamarte',
    email: 'Correo', emailPh: 'tu@email.com',
    subject: 'Asunto', subjectPh: '¿De qué se trata?',
    message: 'Mensaje', messagePh: 'Cuéntanos...',
    submit: 'Enviar mensaje',
    sending: 'Enviando...',
    success: 'Recibimos tu mensaje. Respondemos en hasta 48h.',
    error: 'Hubo un problema. Inténtalo de nuevo o escribe a ' + church.contact.email,
    info: 'Otras formas de contactarnos',
    address: 'Dirección', emailLabel: 'Correo', social: 'Instagram',
  },
}[lang];
---

<PageHero pageKey="contact" />

<Section bg="light">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal>
      <form id="contact-form" class="space-y-6 w-full">
        <input type="hidden" name="access_key" value={church.web3FormsAccessKey} />
        <input type="hidden" name="subject" value="Contato — Freedom Church" />
        <input type="hidden" name="from_name" value="Freedom Church (Site)" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="c-name" class="block text-sm font-medium text-ink-900 mb-2">{labels.name}</label>
            <input id="c-name" name="name" type="text" required placeholder={labels.namePh}
              class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900" />
          </div>
          <div>
            <label for="c-email" class="block text-sm font-medium text-ink-900 mb-2">{labels.email}</label>
            <input id="c-email" name="email" type="email" required placeholder={labels.emailPh}
              class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900" />
          </div>
        </div>
        <div>
          <label for="c-topic" class="block text-sm font-medium text-ink-900 mb-2">{labels.subject}</label>
          <input id="c-topic" name="topic" type="text" placeholder={labels.subjectPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900" />
        </div>
        <div>
          <label for="c-message" class="block text-sm font-medium text-ink-900 mb-2">{labels.message}</label>
          <textarea id="c-message" name="message" rows="6" required placeholder={labels.messagePh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900 resize-none"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" data-submit-btn data-label-submit={labels.submit} data-label-sending={labels.sending}>
          {labels.submit}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div id="contact-success" class="hidden p-5 rounded-xl bg-green-50 border border-green-200 text-green-900 text-sm">
          ✓ {labels.success}
        </div>
        <div id="contact-error" class="hidden p-5 rounded-xl bg-red-50 border border-red-200 text-red-900 text-sm">
          ✗ {labels.error}
        </div>
      </form>
    </div>

    <div class="lg:col-span-5" data-reveal data-reveal-delay="1">
      <div class="bg-ink-100 rounded-2xl p-8 lg:sticky lg:top-28">
        <div class="text-xs uppercase tracking-widest text-gold-600 mb-4">{labels.info}</div>
        <dl class="space-y-5 text-sm">
          <div>
            <dt class="font-medium text-ink-900">{labels.address}</dt>
            <dd class="mt-1 text-ink-700 leading-relaxed">
              {church.address.street}<br />
              {church.address.city}, {church.address.state} {church.address.zip}<br />
              {church.address.country}
            </dd>
            <a href={church.address.googleMapsUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-1 text-xs text-gold-600 hover:text-gold-700 font-medium">
              {lang === 'pt' ? 'Ver no Google Maps' : lang === 'en' ? 'View on Google Maps' : 'Ver en Google Maps'}
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div>
            <dt class="font-medium text-ink-900">{labels.emailLabel}</dt>
            <dd class="mt-1 text-ink-700">
              <a href={`mailto:${church.contact.email}`} class="hover:text-gold-600 transition-colors">{church.contact.email}</a>
            </dd>
          </div>
          <div>
            <dt class="font-medium text-ink-900">{labels.social}</dt>
            <dd class="mt-1 text-ink-700">
              <a href={church.social.instagram} target="_blank" rel="noopener" class="hover:text-gold-600 transition-colors">{church.social.instagramHandle}</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('contact-success');
  const errorEl = document.getElementById('contact-error');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit-btn]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    successEl?.classList.add('hidden');
    errorEl?.classList.add('hidden');

    const sendingLabel = submitBtn.dataset.labelSending ?? 'Sending...';
    const submitLabel = submitBtn.dataset.labelSubmit ?? 'Send';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.6';
    submitBtn.innerHTML = sendingLabel;

    try {
      const formData = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (data.success) {
        successEl?.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error(data.message || 'submit failed');
      }
    } catch (err) {
      console.warn('contact submit error:', err);
      errorEl?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '';
      submitBtn.innerHTML = submitLabel + ' <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }
  });
</script>

---
import { getLangFromUrl, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const hero = {
  pt: { kicker: 'Freedom Kids', title: 'Onde as crianças', titleEm: 'amam estar', sub: 'Apresentamos Jesus de um jeito divertido, seguro e cheio de cor — pra cada criança viver a transformação em Cristo.', cta: 'Planeje sua visita' },
  en: { kicker: 'Freedom Kids', title: 'Where kids', titleEm: 'love to be', sub: 'We present Jesus in a fun, safe and colorful way — so every child can live the transformation in Christ.', cta: 'Plan your visit' },
  es: { kicker: 'Freedom Kids', title: 'Donde los niños', titleEm: 'aman estar', sub: 'Presentamos a Jesús de una manera divertida, segura y llena de color — para que cada niño viva la transformación en Cristo.', cta: 'Planea tu visita' },
}[lang];

const valueIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9"><path d="M12 21s-7-4.4-9.5-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.5 6C19 16.6 12 21 12 21Z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9"><path d="M12 3l7 3v5c0 4.2-3 7.4-7 8.6C8 18.4 5 15.2 5 11V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9"><circle cx="12" cy="12" r="9"/><path d="M8.5 14a4.5 4.5 0 0 0 7 0"/><path d="M9 9.5h.01"/><path d="M15 9.5h.01"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M15 19a4 4 0 0 1 5.5-3.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="currentColor" class="w-9 h-9"><path d="M10 2.5h4V8h5v4h-5v9.5h-4V12H5V8h5V2.5Z"/></svg>',
];
// classes literais (Tailwind precisa do nome completo)
const valueStyles = [
  'bg-amber-100 text-amber-600',
  'bg-sky-100 text-sky-600',
  'bg-rose-100 text-rose-600',
  'bg-emerald-100 text-emerald-600',
  'bg-violet-100 text-violet-600',
];
const values = {
  pt: [
    { t: 'Cada criança é vista', d: 'Conhecida pelo nome, acolhida e amada.' },
    { t: 'Segurança em 1º lugar', d: 'A segurança é a prioridade número um, sempre.' },
    { t: 'Diversão de verdade', d: 'A gente brinca, ri e aproveita cada momento.' },
    { t: 'Amizades que duram', d: 'Amizades verdadeiras pra vida toda.' },
    { t: 'Jesus no centro', d: 'Conhecer a Jesus é sempre o nosso alvo.' },
  ],
  en: [
    { t: 'Every child is seen', d: 'Known by name, welcomed and loved.' },
    { t: 'Safety first', d: 'Safety is the number one priority, always.' },
    { t: 'Real fun', d: 'We play, laugh and enjoy every moment.' },
    { t: 'Friendships that last', d: 'Real, lifelong friendships.' },
    { t: 'Jesus at the center', d: 'Knowing Jesus is always our goal.' },
  ],
  es: [
    { t: 'Cada niño es visto', d: 'Conocido por su nombre, acogido y amado.' },
    { t: 'Seguridad primero', d: 'La seguridad es la prioridad número uno, siempre.' },
    { t: 'Diversión de verdad', d: 'Jugamos, reímos y disfrutamos cada momento.' },
    { t: 'Amistades que duran', d: 'Amistades verdaderas para toda la vida.' },
    { t: 'Jesús en el centro', d: 'Conocer a Jesús es siempre nuestra meta.' },
  ],
}[lang];

const ageStyles = [
  'bg-gradient-to-br from-orange-400 to-rose-500',
  'bg-gradient-to-br from-sky-400 to-indigo-500',
  'bg-gradient-to-br from-violet-400 to-fuchsia-500',
];
const ageEmoji = ['🧸', '🎨', '🚀'];
const ages = {
  pt: [
    { age: '0 – 3 anos', t: 'Bebês & Maternal', d: 'Salas acolhedoras e seguras, com equipe carinhosa cuidando dos pequeninos.' },
    { age: '4 – 6 anos', t: 'Pré-escola', d: 'Histórias bíblicas com música, brincadeiras e arte que mostram o amor de Deus.' },
    { age: '7 – 11 anos', t: 'Crianças', d: 'Lições interativas, louvor e amizades. Uma fé que faz sentido pra eles.' },
  ],
  en: [
    { age: '0 – 3 yrs', t: 'Babies & Toddlers', d: 'Warm, safe rooms with a loving team caring for the little ones.' },
    { age: '4 – 6 yrs', t: 'Preschool', d: 'Bible stories with music, play and art that show God\'s love.' },
    { age: '7 – 11 yrs', t: 'Elementary', d: 'Interactive lessons, worship and friendships. A faith that makes sense for them.' },
  ],
  es: [
    { age: '0 – 3 años', t: 'Bebés y Maternal', d: 'Salas acogedoras y seguras, con un equipo cariñoso cuidando a los pequeños.' },
    { age: '4 – 6 años', t: 'Preescolar', d: 'Historias bíblicas con música, juegos y arte que muestran el amor de Dios.' },
    { age: '7 – 11 años', t: 'Niños', d: 'Lecciones interactivas, alabanza y amistades. Una fe que tiene sentido para ellos.' },
  ],
}[lang];

const stepStyles = ['bg-rose-400', 'bg-amber-400', 'bg-emerald-400'];
const steps = {
  pt: [
    { t: 'Check-in', d: 'Um voluntário te recebe e cadastra seu filho. A criança ganha um adesivo com um número único — e você recebe a etiqueta com o mesmo número.' },
    { t: 'Curta o culto', d: 'Enquanto você adora, seu filho se diverte e aprende sobre Jesus na sala da idade dele.' },
    { t: 'Retirada', d: 'A criança só é entregue a quem apresentar o número correspondente. Sem o número, não liberamos.' },
  ],
  en: [
    { t: 'Check-in', d: 'A volunteer welcomes you and registers your child. They get a sticker with a unique number — and you get the matching tag.' },
    { t: 'Enjoy the service', d: 'While you worship, your child has fun and learns about Jesus in their age-group room.' },
    { t: 'Check-out', d: 'Your child is only released to whoever presents the matching number. No number, no pickup.' },
  ],
  es: [
    { t: 'Check-in', d: 'Un voluntario te recibe y registra a tu hijo. El niño recibe una calcomanía con un número único — y tú la etiqueta con el mismo número.' },
    { t: 'Disfruta el culto', d: 'Mientras adoras, tu hijo se divierte y aprende sobre Jesús en la sala de su edad.' },
    { t: 'Retiro', d: 'El niño solo se entrega a quien presente el número correspondiente. Sin número, no lo liberamos.' },
  ],
}[lang];

const faq = {
  pt: [
    { q: 'Em que idade meu filho participa?', a: 'De 0 a 11 anos, divididos em três turmas: bebês & maternal, pré-escola e crianças.' },
    { q: 'Como funciona o check-in?', a: 'Seu filho recebe um adesivo com um número único e você recebe a etiqueta com o mesmo número. Ao final, a criança só é entregue a quem apresentar o número correspondente. Sem o número, não liberamos — é a nossa garantia de segurança.' },
    { q: 'É seguro?', a: 'Sim! Todos os voluntários passam por triagem e treinamento. Equipe dedicada à segurança, proporção de adultos por criança e protocolo de emergência.' },
    { q: 'E se for a primeira vez?', a: 'Chegue 15 minutos antes. Nossa equipe te recebe, apresenta o espaço, faz o cadastro e tira todas as dúvidas.' },
  ],
  en: [
    { q: 'What age can my child join?', a: 'Ages 0–11, in three groups: babies & toddlers, preschool and elementary.' },
    { q: 'How does check-in work?', a: 'Your child gets a sticker with a unique number and you get the matching tag. At the end, your child is only released to whoever presents the matching number. No number, no pickup — that is our safety guarantee.' },
    { q: 'Is it safe?', a: 'Yes! All volunteers are screened and trained. Dedicated safety team, adult-to-child ratios and an emergency protocol.' },
    { q: 'What if it is our first time?', a: 'Arrive 15 minutes early. Our team welcomes you, shows the space, registers your child and answers all questions.' },
  ],
  es: [
    { q: '¿A qué edad puede participar mi hijo?', a: 'De 0 a 11 años, en tres grupos: bebés y maternal, preescolar y niños.' },
    { q: '¿Cómo funciona el check-in?', a: 'Tu hijo recibe una calcomanía con un número único y tú la etiqueta con el mismo número. Al final, el niño solo se entrega a quien presente el número correspondiente. Sin número, no lo liberamos — es nuestra garantía de seguridad.' },
    { q: '¿Es seguro?', a: '¡Sí! Todos los voluntarios pasan por evaluación y entrenamiento. Equipo dedicado a la seguridad, proporción de adultos por niño y protocolo de emergencia.' },
    { q: '¿Y si es la primera vez?', a: 'Llega 15 minutos antes. Nuestro equipo te recibe, muestra el espacio, registra a tu hijo y aclara todas las dudas.' },
  ],
}[lang];

const heading = {
  pt: { values: 'Um lugar feito pra eles', ages: 'Cada idade no seu espaço', how: 'Como funciona', faq: 'Perguntas dos pais', cta: 'Traga seu filho neste domingo', sub: 'Chega 15 minutinhos antes e a gente cuida de todo o resto. Vai ser uma festa receber a sua família!', btn: 'Planeje sua visita', galleryTitle: 'Momentos Freedom Kids', gallerySub: 'Sorrisos, brincadeiras e muita alegria — assim é o nosso domingo!' },
  en: { values: 'A place made for them', ages: 'Every age in its space', how: 'How it works', faq: 'Parents’ questions', cta: 'Bring your child this Sunday', sub: 'Arrive 15 minutes early and we take care of the rest. It will be a party to welcome your family!', btn: 'Plan your visit', galleryTitle: 'Freedom Kids moments', gallerySub: 'Smiles, play and lots of joy — that’s our Sunday!' },
  es: { values: 'Un lugar hecho para ellos', ages: 'Cada edad en su espacio', how: 'Cómo funciona', faq: 'Preguntas de los padres', cta: 'Trae a tu hijo este domingo', sub: '¡Llega 15 minutos antes y cuidamos del resto. Será una fiesta recibir a tu familia!', btn: 'Planea tu visita', galleryTitle: 'Momentos Freedom Kids', gallerySub: 'Sonrisas, juegos y mucha alegría — ¡así es nuestro domingo!' },
}[lang];

// Galeria divertida — fotos reais (public/kids/gallery). Rotações e cores alternadas dão o clima infantil.
const galleryPhotos = Array.from({ length: 10 }, (_, i) => `/kids/gallery/kids-${String(i + 1).padStart(2, '0')}.jpg`);
const galleryRotations = ['-rotate-2', 'rotate-1', 'rotate-2', '-rotate-1', 'rotate-1', '-rotate-2', 'rotate-2', '-rotate-1', 'rotate-1', '-rotate-2'];
const galleryRings = ['ring-amber-300', 'ring-sky-300', 'ring-rose-300', 'ring-violet-300', 'ring-emerald-300'];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" />

<div class="kids">
  <!-- HERO -->
  <section class="relative overflow-hidden pt-28 lg:pt-36 pb-16 lg:pb-24" style="background: linear-gradient(180deg,#FFF7E6 0%, #FDEEF6 50%, #EAF4FF 100%);">
    <!-- formas flutuantes -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-24 left-[6%] w-16 h-16 rounded-full bg-amber-300/70 animate-(--animate-float)"></div>
      <div class="absolute top-40 right-[10%] w-24 h-24 rounded-full bg-sky-300/60 animate-(--animate-float)" style="animation-delay:-2s"></div>
      <div class="absolute bottom-16 left-[14%] w-12 h-12 rounded-2xl rotate-12 bg-rose-300/70 animate-(--animate-float)" style="animation-delay:-4s"></div>
      <svg class="absolute bottom-24 right-[20%] w-12 h-12 text-violet-400/70 animate-(--animate-float)" style="animation-delay:-1s" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 6.3L21 9l-5 4.3L17.5 21 12 17.3 6.5 21 8 13.3 3 9l6.4-.7L12 2z"/></svg>
    </div>

    <div class="container-page relative z-10 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <img src="/kids/logo-color.jpg" alt="Freedom Church" width="76" height="76" class="w-[68px] h-[68px] lg:w-[76px] lg:h-[76px] rounded-full shadow-md ring-4 ring-white mb-5" />
        <span class="kids-display inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-rose-500 font-semibold shadow-sm text-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>{hero.kicker}
        </span>
        <h1 class="kids-display mt-6 font-bold text-ink-950 leading-[0.95]" style="font-size: clamp(2.75rem, 8vw, 5.5rem)">
          {hero.title}<br /><span class="text-transparent bg-clip-text" style="background-image:linear-gradient(90deg,#F97316,#EC4899,#8B5CF6)">{hero.titleEm}</span> ✨
        </h1>
        <p class="mt-6 text-lg text-ink-700 max-w-md leading-relaxed">{hero.sub}</p>
        <a href={localizedPath(lang, '/sou-novo-aqui')} class="kids-display mt-8 inline-flex items-center gap-2 px-7 py-4 rounded-full bg-rose-500 text-white font-semibold text-lg shadow-lg shadow-rose-500/30 hover:bg-rose-400 hover:-translate-y-1 transition-all">
          {hero.cta}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- vídeo em moldura divertida -->
      <div class="relative">
        <div class="absolute -top-5 -right-3 z-20 kids-display bg-amber-400 text-ink-950 font-bold px-5 py-2 rounded-full rotate-6 shadow-lg">0–11 anos</div>
        <div class="relative rounded-[2.5rem] overflow-hidden border-8 border-white shadow-2xl rotate-2 bg-ink-900 aspect-[4/3]">
          <video src="/kids/freedom-kids.mp4" autoplay loop muted playsinline preload="auto" class="absolute inset-0 w-full h-full object-cover"></video>
        </div>
        <div class="absolute -bottom-5 -left-4 w-20 h-20 rounded-full bg-sky-400/80 -z-0 animate-(--animate-float)"></div>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container-page">
      <h2 class="kids-display text-center font-bold text-ink-950 mb-12 lg:mb-16" style="font-size: clamp(2rem,5vw,3.25rem)">{heading.values}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
        {values.map((v, i) => (
          <div class="rounded-3xl p-6 bg-cream-50 border-2 border-ink-100 text-center hover:-translate-y-2 hover:shadow-xl transition-all duration-300" data-reveal data-reveal-delay={(i % 5) + 1}>
            <span class:list={['mx-auto mb-4 w-16 h-16 rounded-full inline-flex items-center justify-center', valueStyles[i]]} set:html={valueIcons[i]} />
            <h3 class="kids-display font-semibold text-ink-950 leading-snug">{v.t}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAIXAS ETÁRIAS -->
  <section class="py-20 lg:py-28" style="background:#FFF7E6">
    <div class="container-page">
      <h2 class="kids-display text-center font-bold text-ink-950 mb-12 lg:mb-16" style="font-size: clamp(2rem,5vw,3.25rem)">{heading.ages}</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {ages.map((a, i) => (
          <div class:list={['relative overflow-hidden rounded-[2rem] p-8 text-white shadow-lg hover:-translate-y-2 transition-all duration-300 min-h-[16rem] flex flex-col', ageStyles[i]]} data-reveal data-reveal-delay={i + 1}>
            <div class="text-5xl mb-3">{ageEmoji[i]}</div>
            <div class="kids-display inline-block self-start px-3 py-1 rounded-full bg-white/25 text-sm font-semibold mb-2">{a.age}</div>
            <h3 class="kids-display text-2xl font-bold">{a.t}</h3>
            <p class="mt-2 text-white/90 leading-relaxed text-sm">{a.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container-page">
      <h2 class="kids-display text-center font-bold text-ink-950 mb-12 lg:mb-16" style="font-size: clamp(2rem,5vw,3.25rem)">{heading.how}</h2>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {steps.map((s, i) => (
          <div class="text-center" data-reveal data-reveal-delay={i + 1}>
            <div class:list={['kids-display mx-auto w-20 h-20 rounded-full inline-flex items-center justify-center text-white text-3xl font-bold shadow-lg', stepStyles[i]]}>{i + 1}</div>
            <h3 class="kids-display mt-5 text-xl font-semibold text-ink-950">{s.t}</h3>
            <p class="mt-2 text-ink-600 leading-relaxed text-sm">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERIA DIVERTIDA -->
  <section class="py-20 lg:py-28 bg-white overflow-hidden">
    <div class="container-page">
      <h2 class="kids-display text-center font-bold text-ink-950" style="font-size: clamp(2rem,5vw,3.25rem)">{heading.galleryTitle}</h2>
      <p class="text-center text-lg text-ink-600 mt-3 mb-12 lg:mb-16 max-w-xl mx-auto">{heading.gallerySub}</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-5">
        {galleryPhotos.map((src, i) => (
          <div class="group" data-reveal data-reveal-delay={(i % 5) + 1}>
            <div class:list={['aspect-square rounded-3xl overflow-hidden bg-white p-1.5 shadow-lg ring-4 transition-all duration-300 group-hover:rotate-0 group-hover:scale-105 group-hover:shadow-2xl', galleryRotations[i % galleryRotations.length], galleryRings[i % galleryRings.length]]}>
              <img src={src} alt="Freedom Kids" loading="lazy" class="w-full h-full object-cover rounded-[1.25rem]" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28" style="background:#EAF4FF">
    <div class="container-page">
      <h2 class="kids-display text-center font-bold text-ink-950 mb-10 lg:mb-14" style="font-size: clamp(2rem,5vw,3.25rem)">{heading.faq}</h2>
      <div class="max-w-3xl mx-auto space-y-3">
        {faq.map((f, i) => (
          <details class="group bg-white rounded-2xl border-2 border-sky-100 overflow-hidden" data-reveal data-reveal-delay={(i % 4) + 1}>
            <summary class="cursor-pointer p-5 lg:p-6 flex items-center justify-between gap-4 kids-display font-semibold text-ink-950">
              {f.q}
              <span class="shrink-0 w-7 h-7 rounded-full bg-sky-400 text-white inline-flex items-center justify-center transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <div class="px-5 lg:px-6 pb-5 text-ink-700 leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-20 lg:py-28 text-center" style="background:linear-gradient(120deg,#F97316,#EC4899 55%,#8B5CF6)">
    <div class="pointer-events-none absolute inset-0 opacity-30">
      <div class="absolute top-10 left-[12%] w-16 h-16 rounded-full bg-white animate-(--animate-float)"></div>
      <div class="absolute bottom-10 right-[14%] w-24 h-24 rounded-full bg-white animate-(--animate-float)" style="animation-delay:-3s"></div>
    </div>
    <div class="container-page relative z-10 max-w-2xl mx-auto">
      <h2 class="kids-display font-bold text-white" style="font-size: clamp(2rem,5vw,3.5rem)">{heading.cta}</h2>
      <p class="mt-5 text-lg text-white/90">{heading.sub}</p>
      <a href={localizedPath(lang, '/sou-novo-aqui')} class="kids-display mt-8 inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white text-rose-600 font-bold text-lg shadow-xl hover:-translate-y-1 transition-all">
        {heading.btn}
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
</div>

<style>
  .kids-display { font-family: 'Fredoka', system-ui, sans-serif; }
</style>

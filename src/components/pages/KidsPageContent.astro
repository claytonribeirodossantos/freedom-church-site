---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

// --- Tagline (estilo TC Kidz) ---
const intro = {
  pt: { lead: 'Apresentamos Jesus às crianças e às suas famílias de um jeito', em: 'divertido e criativo', tail: '— para uma vida transformada em Cristo.' },
  en: { lead: 'We present Jesus to kids and their families in a', em: 'fun and creative', tail: 'way — for a life transformed in Christ.' },
  es: { lead: 'Presentamos a Jesús a los niños y sus familias de una manera', em: 'divertida y creativa', tail: '— para una vida transformada en Cristo.' },
}[lang];

// --- 5 valores ---
const valueIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 21s-7-4.4-9.5-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.5 6C19 16.6 12 21 12 21Z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 3l7 3v5c0 4.2-3 7.4-7 8.6C8 18.4 5 15.2 5 11V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><circle cx="12" cy="12" r="9"/><path d="M8.5 14a4.5 4.5 0 0 0 7 0"/><path d="M9 9.5h.01"/><path d="M15 9.5h.01"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M15 19a4 4 0 0 1 5.5-3.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8"><path d="M10 2.5h4V8h5v4h-5v9.5h-4V12H5V8h5V2.5Z"/></svg>',
];
const values = {
  pt: [
    { t: 'Cada criança é vista', d: 'Um lugar onde cada criança é conhecida pelo nome, acolhida e amada.' },
    { t: 'Segurança em 1º lugar', d: 'Um lugar onde a segurança é a prioridade número um, sempre.' },
    { t: 'Diversão de verdade', d: 'Um lugar onde a gente brinca, ri e aproveita cada momento.' },
    { t: 'Amizades que duram', d: 'Um lugar onde nascem amizades verdadeiras pra vida toda.' },
    { t: 'Jesus no centro', d: 'Um lugar onde um relacionamento pessoal com Cristo é sempre o alvo.' },
  ],
  en: [
    { t: 'Every child is seen', d: 'A place where each child is known by name, welcomed and loved.' },
    { t: 'Safety first', d: 'A place where safety is the number one priority, always.' },
    { t: 'Real fun', d: 'A place where we play, laugh and enjoy every moment.' },
    { t: 'Friendships that last', d: 'A place where real, lifelong friendships are born.' },
    { t: 'Jesus at the center', d: 'A place where a personal relationship with Christ is always the goal.' },
  ],
  es: [
    { t: 'Cada niño es visto', d: 'Un lugar donde cada niño es conocido por su nombre, acogido y amado.' },
    { t: 'Seguridad primero', d: 'Un lugar donde la seguridad es la prioridad número uno, siempre.' },
    { t: 'Diversión de verdad', d: 'Un lugar donde jugamos, reímos y disfrutamos cada momento.' },
    { t: 'Amistades que duran', d: 'Un lugar donde nacen amistades verdaderas para toda la vida.' },
    { t: 'Jesús en el centro', d: 'Un lugar donde una relación personal con Cristo es siempre la meta.' },
  ],
}[lang];

// --- Faixas etárias ---
const ages = {
  pt: [
    { age: '0 – 3 anos', t: 'Bebês & Maternal', d: 'Salas acolhedoras, limpas e seguras, com equipe carinhosa cuidando dos pequeninos com todo amor.' },
    { age: '4 – 6 anos', t: 'Pré-escola', d: 'Histórias bíblicas com música, brincadeiras e arte que mostram o amor de Deus de um jeito que eles entendem.' },
    { age: '7 – 11 anos', t: 'Crianças', d: 'Lições interativas, louvor e momentos em grupo. Uma fé que faz sentido pra idade deles.' },
  ],
  en: [
    { age: '0 – 3 yrs', t: 'Babies & Toddlers', d: 'Warm, clean and safe rooms, with a loving team caring for the little ones.' },
    { age: '4 – 6 yrs', t: 'Preschool', d: 'Bible stories with music, play and art that show God\'s love in a way they understand.' },
    { age: '7 – 11 yrs', t: 'Elementary', d: 'Interactive lessons, worship and group moments. A faith that makes sense for their age.' },
  ],
  es: [
    { age: '0 – 3 años', t: 'Bebés y Maternal', d: 'Salas acogedoras, limpias y seguras, con un equipo cariñoso cuidando a los pequeños.' },
    { age: '4 – 6 años', t: 'Preescolar', d: 'Historias bíblicas con música, juegos y arte que muestran el amor de Dios.' },
    { age: '7 – 11 años', t: 'Niños', d: 'Lecciones interactivas, alabanza y momentos en grupo. Una fe que tiene sentido para su edad.' },
  ],
}[lang];

// --- Como funciona (3 passos) ---
const steps = {
  pt: [
    { t: 'Check-in', d: 'Na primeira vez, um voluntário te recebe e cadastra seu filho. A criança ganha um adesivo com um número único — e você recebe a etiqueta com o mesmo número.' },
    { t: 'Curta o culto', d: 'Enquanto você adora, seu filho se diverte e aprende sobre Jesus na sala da idade dele, com gente preparada e cuidadosa.' },
    { t: 'Retirada', d: 'A criança só é entregue a quem apresentar o número correspondente. Sem o número, não liberamos — é a nossa garantia de segurança.' },
  ],
  en: [
    { t: 'Check-in', d: 'On your first time, a volunteer welcomes you and registers your child. They get a sticker with a unique number — and you get the matching tag.' },
    { t: 'Enjoy the service', d: 'While you worship, your child has fun and learns about Jesus in their age-group room, with a prepared and caring team.' },
    { t: 'Check-out', d: 'Your child is only released to whoever presents the matching number. No number, no pickup — that is our safety guarantee.' },
  ],
  es: [
    { t: 'Check-in', d: 'La primera vez, un voluntario te recibe y registra a tu hijo. El niño recibe una calcomanía con un número único — y tú recibes la etiqueta con el mismo número.' },
    { t: 'Disfruta el culto', d: 'Mientras adoras, tu hijo se divierte y aprende sobre Jesús en la sala de su edad, con un equipo preparado y atento.' },
    { t: 'Retiro', d: 'El niño solo se entrega a quien presente el número correspondiente. Sin el número, no lo liberamos — es nuestra garantía de seguridad.' },
  ],
}[lang];

const faq = {
  pt: [
    { q: 'Em que idade meu filho participa?', a: 'De 0 a 11 anos, divididos em três turmas por faixa etária: bebês & maternal, pré-escola e crianças.' },
    { q: 'Como funciona o check-in?', a: 'Na entrada do Freedom Kids, seu filho recebe um adesivo de identificação com um número único. Você recebe uma etiqueta com o mesmo número. Ao final do culto, a criança só é entregue à pessoa que apresentar o número correspondente. Sem o número, não liberamos a criança — é a nossa garantia de segurança.' },
    { q: 'É seguro?', a: 'Sim. Todos os voluntários passam por triagem e treinamento. Há equipe dedicada à segurança, proporção de adultos por criança em cada sala e protocolo de emergência.' },
    { q: 'E se for a primeira vez?', a: 'Chegue 15 minutos antes. Nossa equipe te recebe, apresenta o espaço, faz o cadastro e tira todas as dúvidas.' },
  ],
  en: [
    { q: 'What age can my child join?', a: 'Ages 0–11, divided into three groups: babies & toddlers, preschool and elementary.' },
    { q: 'How does check-in work?', a: 'When you drop off your child at Freedom Kids, they receive an ID sticker with a unique number. You receive a matching tag with the same number. At the end of service, your child is only released to the person presenting the matching number. No matching number, no pickup — that is our safety guarantee.' },
    { q: 'Is it safe?', a: 'Yes. All volunteers go through screening and training. There is a dedicated safety team, adult-to-child ratios in every room, and an emergency protocol.' },
    { q: 'What if it is our first time?', a: 'Arrive 15 minutes early. Our team welcomes you, shows the space, registers your child, and answers all questions.' },
  ],
  es: [
    { q: '¿A qué edad puede participar mi hijo?', a: 'De 0 a 11 años, divididos en tres grupos: bebés y maternal, preescolar y niños.' },
    { q: '¿Cómo funciona el check-in?', a: 'Al dejar a tu hijo en Freedom Kids, recibe una calcomanía de identificación con un número único. Tú recibes una etiqueta con el mismo número. Al final del culto, el niño solo es entregado a quien presente el número correspondiente. Sin el número, no liberamos al niño — es nuestra garantía de seguridad.' },
    { q: '¿Es seguro?', a: 'Sí. Todos los voluntarios pasan por evaluación y entrenamiento. Hay equipo dedicado a la seguridad, proporción de adultos por niño en cada sala y protocolo de emergencia.' },
    { q: '¿Y si es la primera vez?', a: 'Llega 15 minutos antes. Nuestro equipo te recibe, muestra el espacio, registra a tu hijo y aclara todas las dudas.' },
  ],
}[lang];

const heading = {
  pt: { values: 'Nossos valores', valuesTitle: 'Um lugar feito para eles', ages: 'Por idade', agesTitle: 'Cada idade no seu espaço', how: 'Como funciona', howTitle: 'Simples, do começo ao fim', faq: 'Perguntas dos pais', cta: 'Traga seu filho neste domingo', sub: 'Chega 15 minutos antes e a gente cuida de todo o resto. Vai ser uma alegria receber a sua família.', btn: 'Planeje sua visita' },
  en: { values: 'Our values', valuesTitle: 'A place made for them', ages: 'By age', agesTitle: 'Every age in its own space', how: 'How it works', howTitle: 'Simple, from start to finish', faq: 'Parents’ questions', cta: 'Bring your child this Sunday', sub: 'Arrive 15 minutes early and we take care of the rest. We would love to welcome your family.', btn: 'Plan your visit' },
  es: { values: 'Nuestros valores', valuesTitle: 'Un lugar hecho para ellos', ages: 'Por edad', agesTitle: 'Cada edad en su espacio', how: 'Cómo funciona', howTitle: 'Simple, de principio a fin', faq: 'Preguntas de los padres', cta: 'Trae a tu hijo este domingo', sub: 'Llega 15 minutos antes y nosotros cuidamos del resto. Será una alegría recibir a tu familia.', btn: 'Planea tu visita' },
}[lang];
---

<PageHero pageKey="kids" video="/kids/freedom-kids.mp4" />

<!-- Tagline -->
<Section bg="light">
  <div class="max-w-4xl mx-auto text-center" data-reveal>
    <p class="mega text-ink-950" style="font-size: clamp(1.75rem, 4.5vw, 3rem); line-height: 1.15">
      {intro.lead} <em class="italic font-light text-gold-500">{intro.em}</em> {intro.tail}
    </p>
  </div>
</Section>

<!-- 5 valores -->
<Section bg="tint">
  <div class="max-w-2xl mb-12 lg:mb-16" data-reveal>
    <span class="eyebrow">{heading.values}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">{heading.valuesTitle}</h2>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
    {values.map((v, i) => (
      <div
        class="bg-ink-50 border border-ink-200 rounded-2xl p-6 hover:border-gold-500 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
        data-reveal
        data-reveal-delay={(i % 5) + 1}
      >
        <span class="inline-flex text-gold-500 mb-4" set:html={valueIcons[i]} />
        <h3 class="text-base font-medium text-ink-950 leading-snug">{v.t}</h3>
        <p class="mt-2 text-sm text-ink-600 leading-relaxed">{v.d}</p>
      </div>
    ))}
  </div>
</Section>

<!-- Faixas etárias -->
<Section bg="light">
  <div class="max-w-2xl mb-12 lg:mb-16" data-reveal>
    <span class="eyebrow">{heading.ages}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">{heading.agesTitle}</h2>
  </div>
  <div class="grid md:grid-cols-3 gap-6">
    {ages.map((a, i) => (
      <div
        class="relative overflow-hidden rounded-3xl bg-ink-950 text-ink-50 p-8 lg:p-10 min-h-[15rem] flex flex-col justify-end group"
        data-reveal
        data-reveal-delay={i + 1}
      >
        <div class="absolute inset-0 opacity-60 transition-opacity group-hover:opacity-80"
          style={`background: linear-gradient(150deg, ${['#2D2616,#0F0F0E','#4A3E25,#1C1917','#6B5832,#2D2616'][i]});`}></div>
        <div class="relative z-10">
          <div class="text-xs uppercase tracking-[0.2em] text-gold-400 mb-2">{a.age}</div>
          <h3 class="font-display text-2xl text-ink-50">{a.t}</h3>
          <p class="mt-3 text-sm text-ink-200 leading-relaxed">{a.d}</p>
        </div>
      </div>
    ))}
  </div>
</Section>

<!-- Como funciona (3 passos) -->
<Section bg="dark">
  <div class="max-w-2xl mb-12 lg:mb-16" data-reveal>
    <span class="eyebrow eyebrow-light">{heading.how}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-50 leading-tight">{heading.howTitle}</h2>
  </div>
  <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
    {steps.map((s, i) => (
      <div data-reveal data-reveal-delay={i + 1}>
        <div class="display-num text-6xl mb-4">{String(i + 1).padStart(2, '0')}</div>
        <h3 class="font-display text-2xl text-ink-50">{s.t}</h3>
        <p class="mt-3 text-ink-300 leading-relaxed">{s.d}</p>
      </div>
    ))}
  </div>
</Section>

<!-- FAQ -->
<Section bg="tint">
  <div class="max-w-2xl mb-10" data-reveal>
    <span class="eyebrow">{heading.faq}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">{heading.faq}</h2>
  </div>
  <div class="max-w-3xl space-y-3">
    {faq.map((f, i) => (
      <details class="group bg-ink-50 rounded-xl border border-ink-200 overflow-hidden" data-reveal data-reveal-delay={(i % 4) + 1}>
        <summary class="cursor-pointer p-5 lg:p-6 flex items-center justify-between gap-4 font-display text-lg text-ink-950">
          {f.q}
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180 shrink-0 text-gold-500">
            <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="px-5 lg:px-6 pb-5 text-ink-700 leading-relaxed">{f.a}</div>
      </details>
    ))}
  </div>
</Section>

<!-- CTA -->
<Section bg="dark">
  <div class="text-center max-w-2xl mx-auto" data-reveal>
    <h2 class="mega text-ink-50" style="font-size: clamp(2rem, 5vw, 3.5rem)">{heading.cta}</h2>
    <p class="mt-6 text-lg text-ink-300">{heading.sub}</p>
    <a href={localizedPath(lang, '/sou-novo-aqui')} class="mt-10 inline-flex btn btn-primary !bg-gold-500 !text-ink-950 hover:!bg-gold-400">
      {heading.btn}
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</Section>

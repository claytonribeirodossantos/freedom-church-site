---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const updated = {
  pt: 'Última atualização: 24 de maio de 2026',
  en: 'Last updated: May 24, 2026',
  es: 'Última actualización: 24 de mayo de 2026',
}[lang];

const sections = {
  pt: [
    { h: '1. Sobre este site', p: 'Este site é mantido pela Freedom Church (Kensington, MD) para informar a comunidade, divulgar cultos e eventos, receber pedidos de oração, ofertas e contatos.' },
    { h: '2. Uso permitido', p: 'Você pode usar o site para fins pessoais, devocionais e de informação. Compartilhar links é encorajado. Copiar conteúdos extensos requer crédito à Freedom Church.' },
    { h: '3. Doações', p: 'As doações são processadas via Stripe em USD. Doações não são reembolsáveis após processadas, exceto em caso de erro técnico comprovado. Para questões, escreva ao email abaixo.' },
    { h: '4. Conteúdo de terceiros', p: 'Embeds de YouTube, Spotify, Google Maps e outras integrações seguem as políticas dos respectivos serviços.' },
    { h: '5. Limitação de responsabilidade', p: 'O conteúdo é oferecido como é. Buscamos precisão, mas não garantimos que o site esteja sempre disponível ou livre de erros.' },
    { h: '6. Mudanças', p: 'Podemos atualizar estes termos. Mudanças relevantes serão comunicadas no site.' },
    { h: '7. Contato', p: `Dúvidas: ${church.contact.email}` },
  ],
  en: [
    { h: '1. About this site', p: 'This site is maintained by Freedom Church (Kensington, MD) to inform the community, share services and events, and receive prayer requests, offerings, and contacts.' },
    { h: '2. Permitted use', p: 'You may use the site for personal, devotional, and informational purposes. Sharing links is encouraged. Copying extensive content requires credit to Freedom Church.' },
    { h: '3. Donations', p: 'Donations are processed via Stripe in USD. Donations are non-refundable once processed, except in cases of verified technical error. For questions, email below.' },
    { h: '4. Third-party content', p: 'YouTube, Spotify, Google Maps and other embeds follow the respective service policies.' },
    { h: '5. Liability', p: 'Content is provided as-is. We aim for accuracy but do not guarantee constant availability or error-free site.' },
    { h: '6. Changes', p: 'We may update these terms. Relevant changes will be announced on the site.' },
    { h: '7. Contact', p: `Questions: ${church.contact.email}` },
  ],
  es: [
    { h: '1. Sobre este sitio', p: 'Este sitio es mantenido por Freedom Church (Kensington, MD) para informar a la comunidad, divulgar cultos y eventos, y recibir peticiones de oración, ofrendas y contactos.' },
    { h: '2. Uso permitido', p: 'Puedes usar el sitio para fines personales, devocionales e informativos. Compartir enlaces es alentado. Copiar contenidos extensos requiere crédito a Freedom Church.' },
    { h: '3. Donaciones', p: 'Las donaciones se procesan vía Stripe en USD. No son reembolsables una vez procesadas, salvo error técnico comprobado. Para dudas, escribe al correo abajo.' },
    { h: '4. Contenido de terceros', p: 'Los embeds de YouTube, Spotify, Google Maps y otras integraciones siguen las políticas de los respectivos servicios.' },
    { h: '5. Responsabilidad', p: 'El contenido se ofrece como está. Buscamos precisión, pero no garantizamos disponibilidad constante o ausencia de errores.' },
    { h: '6. Cambios', p: 'Podemos actualizar estos términos. Los cambios relevantes serán anunciados en el sitio.' },
    { h: '7. Contacto', p: `Dudas: ${church.contact.email}` },
  ],
}[lang];
---

<PageHero pageKey="terms" />

<Section bg="light">
  <article class="max-w-3xl mx-auto">
    <p class="text-sm text-ink-500 mb-10">{updated}</p>
    <div class="space-y-10">
      {sections.map((s) => (
        <section>
          <h2 class="font-display text-2xl text-ink-950 mb-3">{s.h}</h2>
          <p class="text-ink-700 leading-relaxed">{s.p}</p>
        </section>
      ))}
    </div>
  </article>
</Section>

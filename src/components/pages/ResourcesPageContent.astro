---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const studies = {
  pt: [
    { t: 'Plano de leitura: A Bíblia em 1 ano', d: 'PDF • 28 páginas', tag: 'Plano' },
    { t: 'Devocional: 21 dias com Jesus', d: 'PDF • 64 páginas', tag: 'Devocional' },
    { t: 'Guia de células: como liderar', d: 'PDF • 32 páginas', tag: 'Liderança' },
    { t: 'Estudo: Identidade em Cristo', d: 'PDF • 18 páginas', tag: 'Estudo' },
  ],
  en: [
    { t: 'Reading plan: The Bible in 1 year', d: 'PDF • 28 pages', tag: 'Plan' },
    { t: 'Devotional: 21 days with Jesus', d: 'PDF • 64 pages', tag: 'Devotional' },
    { t: 'Cell guide: how to lead', d: 'PDF • 32 pages', tag: 'Leadership' },
    { t: 'Study: Identity in Christ', d: 'PDF • 18 pages', tag: 'Study' },
  ],
  es: [
    { t: 'Plan de lectura: La Biblia en 1 año', d: 'PDF • 28 páginas', tag: 'Plan' },
    { t: 'Devocional: 21 días con Jesús', d: 'PDF • 64 páginas', tag: 'Devocional' },
    { t: 'Guía de células: cómo liderar', d: 'PDF • 32 páginas', tag: 'Liderazgo' },
    { t: 'Estudio: Identidad en Cristo', d: 'PDF • 18 páginas', tag: 'Estudio' },
  ],
}[lang];

const wallpapers = {
  pt: ['João 8:32', 'Filipenses 4:13', 'Salmos 23:1', 'Isaías 41:10'],
  en: ['John 8:32', 'Philippians 4:13', 'Psalm 23:1', 'Isaiah 41:10'],
  es: ['Juan 8:32', 'Filipenses 4:13', 'Salmos 23:1', 'Isaías 41:10'],
}[lang];

const headings = {
  pt: { studies: 'Estudos e devocionais', wallpapers: 'Wallpapers com versículos', download: 'Baixar', mobile: 'Mobile', desktop: 'Desktop' },
  en: { studies: 'Studies & devotionals', wallpapers: 'Wallpapers with verses', download: 'Download', mobile: 'Mobile', desktop: 'Desktop' },
  es: { studies: 'Estudios y devocionales', wallpapers: 'Fondos con versículos', download: 'Descargar', mobile: 'Mobile', desktop: 'Desktop' },
}[lang];
---

<PageHero pageKey="resources" />

<Section bg="light" watermark="dark">
  <SectionHeader eyebrow={headings.studies} title={headings.studies} />
  <div class="grid sm:grid-cols-2 gap-4">
    {studies.map((s) => (
      <article class="group bg-ink-50 border border-ink-200 rounded-2xl p-6 flex gap-4 hover:border-ink-950 hover:shadow-lg transition-all cursor-pointer">
        <div class="w-12 h-12 shrink-0 rounded-lg bg-gold-500/10 text-gold-600 flex items-center justify-center group-hover:bg-gold-500 group-hover:text-ink-950 transition-colors">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v16h16V8l-4-4H4z M16 4v4h4 M8 10h8 M8 14h8 M8 18h5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs uppercase tracking-widest text-gold-600 mb-1">{s.tag}</div>
          <h3 class="text-lg text-ink-950 leading-tight">{s.t}</h3>
          <div class="mt-2 flex items-center justify-between">
            <span class="text-sm text-ink-500">{s.d}</span>
            <span class="text-sm font-medium text-ink-950 inline-flex items-center gap-1">
              {headings.download}
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 2v8m0 0L3.5 6.5M7 10l3.5-3.5 M2 12h10" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<Section bg="tint">
  <SectionHeader eyebrow={headings.wallpapers} title={headings.wallpapers} />
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    {wallpapers.map((w, i) => (
      <div class="bg-ink-950 text-ink-50 rounded-2xl overflow-hidden">
        <div class="aspect-[9/16] flex items-center justify-center p-6 text-center"
          style={`background: linear-gradient(${135 + i * 30}deg, #050505, #2D2616);`}
        >
          <div>
            <div class="font-display text-xl text-gold-400 italic">"{w}"</div>
          </div>
        </div>
        <div class="p-4 flex gap-2">
          <button class="flex-1 text-xs font-medium text-ink-50 border border-ink-700 rounded-md py-2 hover:bg-gold-500 hover:text-ink-950 hover:border-gold-500 transition-colors">
            {headings.mobile}
          </button>
          <button class="flex-1 text-xs font-medium text-ink-50 border border-ink-700 rounded-md py-2 hover:bg-gold-500 hover:text-ink-950 hover:border-gold-500 transition-colors">
            {headings.desktop}
          </button>
        </div>
      </div>
    ))}
  </div>
</Section>

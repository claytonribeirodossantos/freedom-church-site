---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl, localizedPath } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const manifestoLines = {
  pt: [
    { text: 'Você não precisa', emph: false },
    { text: 'estar pronto.', emph: true },
    { text: 'Só precisa', emph: false },
    { text: 'aparecer.', emph: true },
  ],
  en: [
    { text: "You don't have to be", emph: false },
    { text: 'ready.', emph: true },
    { text: 'Just', emph: false },
    { text: 'show up.', emph: true },
  ],
  es: [
    { text: 'No tienes que', emph: false },
    { text: 'estar listo.', emph: true },
    { text: 'Solo necesitas', emph: false },
    { text: 'aparecer.', emph: true },
  ],
}[lang];

const journey = {
  pt: {
    eyebrow: 'Primeiros passos',
    title: 'Comece sua jornada de fé!',
    intro: [
      'Tudo começa com um passo de fé — crer. E nós estamos aqui para caminhar com você nessa nova etapa de crescimento espiritual.',
      'Na nossa igreja, somos mais do que um grupo de pessoas: somos uma família espiritual que ama Jesus, ama o próximo e vive em comunidade. Queremos que você também faça parte dessa família.',
      'Sabemos que todo começo pode gerar dúvidas e até um pouco de medo, mas lembre-se: você não está sozinho!',
    ],
    stepsTitle: 'Passos para sua caminhada de fé',
    steps: [
      { t: 'Entregue sua vida a Jesus', d: 'Tudo começa quando você reconhece Jesus Cristo como seu único e suficiente Salvador e Senhor. Esse é o primeiro e mais importante passo.' },
      { t: 'Dê o passo do batismo', d: 'O batismo é uma confissão pública da sua fé — uma expressão exterior do que o Espírito Santo já está fazendo dentro de você. É um momento de entrega, compromisso e celebração!' },
      { t: 'Fortaleça sua fé', d: 'Após o batismo, oferecemos as classes de Primeiros Passos chamada START; um tempo especial de aprendizado e crescimento para que você conheça mais sobre Jesus e se firme na fé.' },
    ],
    communityTitle: 'Cresça e viva em comunidade!',
    community: [
      'Nossa igreja oferece atividades semanais para crianças, adolescentes, jovens e adultos. Aqui, você e sua família encontrarão alimento espiritual através da Palavra de Deus, e serão ensinados a viver como verdadeiros discípulos de Jesus.',
      'Venha fazer parte dessa jornada — a sua nova vida em Cristo está apenas começando!',
    ],
  },
  en: {
    eyebrow: 'First steps',
    title: 'Start your journey of faith!',
    intro: [
      'It all begins with a step of faith — to believe. And we are here to walk with you in this new season of spiritual growth.',
      'In our church, we are more than a group of people: we are a spiritual family that loves Jesus, loves our neighbor and lives in community. We want you to be part of this family too.',
      'We know that every beginning can bring questions and even a little fear, but remember: you are not alone!',
    ],
    stepsTitle: 'Steps for your walk of faith',
    steps: [
      { t: 'Give your life to Jesus', d: 'It all starts when you recognize Jesus Christ as your only and sufficient Savior and Lord. This is the first and most important step.' },
      { t: 'Take the step of baptism', d: 'Baptism is a public confession of your faith — an outward expression of what the Holy Spirit is already doing within you. It is a moment of surrender, commitment and celebration!' },
      { t: 'Strengthen your faith', d: 'After baptism, we offer our First Steps classes called START; a special time of learning and growth so you get to know Jesus more and become firm in the faith.' },
    ],
    communityTitle: 'Grow and live in community!',
    community: [
      'Our church offers weekly activities for children, teens, youth and adults. Here, you and your family will find spiritual nourishment through the Word of God, and will be taught to live as true disciples of Jesus.',
      'Come be part of this journey — your new life in Christ is only beginning!',
    ],
  },
  es: {
    eyebrow: 'Primeros pasos',
    title: '¡Comienza tu jornada de fe!',
    intro: [
      'Todo comienza con un paso de fe — creer. Y estamos aquí para caminar contigo en esta nueva etapa de crecimiento espiritual.',
      'En nuestra iglesia, somos más que un grupo de personas: somos una familia espiritual que ama a Jesús, ama al prójimo y vive en comunidad. Queremos que tú también seas parte de esta familia.',
      'Sabemos que todo comienzo puede generar dudas e incluso un poco de miedo, pero recuerda: ¡no estás solo!',
    ],
    stepsTitle: 'Pasos para tu caminar de fe',
    steps: [
      { t: 'Entrega tu vida a Jesús', d: 'Todo comienza cuando reconoces a Jesucristo como tu único y suficiente Salvador y Señor. Este es el primer y más importante paso.' },
      { t: 'Da el paso del bautismo', d: 'El bautismo es una confesión pública de tu fe — una expresión exterior de lo que el Espíritu Santo ya está haciendo dentro de ti. ¡Es un momento de entrega, compromiso y celebración!' },
      { t: 'Fortalece tu fe', d: 'Después del bautismo, ofrecemos las clases de Primeros Pasos llamadas START; un tiempo especial de aprendizaje y crecimiento para que conozcas más a Jesús y te afirmes en la fe.' },
    ],
    communityTitle: '¡Crece y vive en comunidad!',
    community: [
      'Nuestra iglesia ofrece actividades semanales para niños, adolescentes, jóvenes y adultos. Aquí, tú y tu familia encontrarán alimento espiritual a través de la Palabra de Dios, y serán enseñados a vivir como verdaderos discípulos de Jesús.',
      'Ven a ser parte de esta jornada — ¡tu nueva vida en Cristo apenas está comenzando!',
    ],
  },
}[lang];

const faq = {
  pt: [
    { q: 'Preciso me cadastrar antes?', a: 'Não. É só chegar. Se quiser nos avisar, mandamos um WhatsApp lembrando do horário.' },
    { q: 'Vou ter que falar na frente das pessoas?', a: 'Jamais. Ninguém te apresenta sem você pedir. Você decide quando e como se conectar.' },
    { q: 'Posso levar minhas crianças?', a: 'Por favor, leve! O Freedom Kids cuida deles com segurança e diversão enquanto você está no culto.' },
    { q: 'É só pra brasileiros?', a: 'Não. Recebemos brasileiros, americanos, latinos, e qualquer pessoa que queira conhecer Jesus. O culto é em português mas com tradução visual.' },
    { q: 'E se eu tiver perguntas durante o culto?', a: 'Anote ou guarde pra depois. Tem sempre alguém disponível pra conversar ao final.' },
  ],
  en: [
    { q: 'Do I need to register first?', a: 'No. Just show up. If you let us know, we send a WhatsApp reminder.' },
    { q: 'Will I have to speak in front of people?', a: 'Never. No one introduces you unless you ask. You decide when and how to connect.' },
    { q: 'Can I bring my kids?', a: 'Please do! Freedom Kids takes care of them with safety and fun while you are in service.' },
    { q: 'Is it only for Brazilians?', a: 'No. We welcome Brazilians, Americans, Latinos, and anyone wanting to know Jesus. The service is in Portuguese with visual translation.' },
    { q: 'What if I have questions during service?', a: 'Write down or save for later. There is always someone available to talk afterward.' },
  ],
  es: [
    { q: '¿Necesito registrarme antes?', a: 'No. Solo aparece. Si nos avisas, te enviamos un recordatorio por WhatsApp.' },
    { q: '¿Tendré que hablar frente a las personas?', a: 'Jamás. Nadie te presenta sin que tú lo pidas. Tú decides cuándo y cómo conectarte.' },
    { q: '¿Puedo llevar a mis niños?', a: '¡Por favor, hazlo! Freedom Kids los cuida con seguridad y diversión mientras estás en el culto.' },
    { q: '¿Es solo para brasileños?', a: 'No. Recibimos a brasileños, americanos, latinos y a cualquier persona que quiera conocer a Jesús. El culto es en portugués con traducción visual.' },
    { q: '¿Y si tengo preguntas durante el culto?', a: 'Anota o guarda para después. Siempre hay alguien disponible para conversar al final.' },
  ],
}[lang];

const labels = {
  pt: { steps: 'Como vai ser', faq: 'Perguntas reais, respostas reais', cta: 'Quer que te esperemos?', sub: 'Mandamos um WhatsApp lembrando do horário e te recebemos pessoalmente na porta.', btn: 'Avise que vou', when: 'Domingo · 10h30', map: 'Como chegar' },
  en: { steps: 'How it will be', faq: 'Real questions, real answers', cta: 'Want us to expect you?', sub: 'We send a WhatsApp reminder and welcome you personally at the door.', btn: 'Let them know', when: 'Sunday · 10:30 AM', map: 'Get directions' },
  es: { steps: 'Cómo será', faq: 'Preguntas reales, respuestas reales', cta: '¿Quieres que te esperemos?', sub: 'Te enviamos un recordatorio por WhatsApp y te recibimos personalmente en la puerta.', btn: 'Avísales que voy', when: 'Domingo · 10:30 AM', map: 'Cómo llegar' },
}[lang];
---

<PageHero pageKey="newHere" />

<!-- Manifesto -->
<Section bg="light">
  <h2
    class="mega text-ink-950"
    style="font-size: clamp(2.5rem, 8vw, 7rem)"
    data-reveal
  >
    {manifestoLines.map((line) => (
      <span class="block">
        {line.emph
          ? <em class="italic font-light text-gold-500">{line.text}</em>
          : line.text}
      </span>
    ))}
  </h2>
</Section>

<!-- Comece sua jornada de fé -->
<Section bg="tint" watermark="dark">
  <div class="max-w-3xl mx-auto text-center mb-10" data-reveal>
    <span class="eyebrow justify-center">{journey.eyebrow}</span>
    <h2 class="mt-4 font-display text-4xl lg:text-5xl text-ink-950 leading-tight">{journey.title}</h2>
  </div>
  <div class="max-w-3xl mx-auto space-y-5 text-lg text-ink-700 leading-relaxed" data-reveal>
    {journey.intro.map((p) => <p>{p}</p>)}
  </div>

  <h3 class="mt-16 lg:mt-20 mb-8 text-center font-display text-2xl lg:text-3xl text-ink-950">{journey.stepsTitle}</h3>
  <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
    {journey.steps.map((s, i) => (
      <div class="bg-ink-50 border border-ink-200 rounded-2xl p-7 group hover:border-ink-950 hover:shadow-lg transition-all" data-reveal data-reveal-delay={i + 1}>
        <div class="display-num text-5xl mb-4 text-gold-500">{i + 1}</div>
        <h4 class="font-display text-lg text-ink-950">{s.t}</h4>
        <p class="mt-3 text-sm text-ink-600 leading-relaxed">{s.d}</p>
      </div>
    ))}
  </div>

  <div class="max-w-3xl mx-auto mt-16 lg:mt-20 text-center" data-reveal>
    <h3 class="font-display text-2xl lg:text-3xl text-gold-600">{journey.communityTitle}</h3>
    <div class="mt-5 space-y-4 text-lg text-ink-700 leading-relaxed">
      {journey.community.map((p) => <p>{p}</p>)}
    </div>
  </div>
</Section>

<!-- Address + map -->
<Section bg="light">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div data-reveal>
      <span class="eyebrow">{labels.when}</span>
      <h2 class="mt-4 mega text-ink-950" style="font-size: clamp(2rem, 5vw, 3.5rem)">
        {labels.when}
      </h2>
      <address class="not-italic mt-8 text-lg text-ink-700 leading-relaxed">
        {church.address.street}<br />
        {church.address.city}, {church.address.state} {church.address.zip}
      </address>
      <a href={church.address.googleMapsUrl} target="_blank" rel="noopener" class="mt-6 inline-flex btn btn-ghost">
        {labels.map}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="aspect-square lg:aspect-[4/5] rounded-3xl overflow-hidden bg-ink-200" data-reveal data-reveal-delay="1">
      <iframe
        src={`https://www.google.com/maps?q=${encodeURIComponent(church.address.full)}&output=embed`}
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        title="Freedom Church location"
      ></iframe>
    </div>
  </div>
</Section>

<!-- FAQ -->
<Section bg="tint">
  <div class="max-w-2xl mb-12" data-reveal>
    <span class="eyebrow">{labels.faq}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">{labels.faq}</h2>
  </div>
  <div class="max-w-3xl space-y-3">
    {faq.map((f, i) => (
      <details
        class="group bg-ink-50 rounded-xl border border-ink-200 overflow-hidden"
        data-reveal
        data-reveal-delay={(i % 4) + 1}
      >
        <summary class="cursor-pointer p-6 flex items-center justify-between gap-4 font-display text-lg text-ink-950">
          {f.q}
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180 shrink-0 text-gold-500">
            <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="px-6 pb-6 text-ink-700 leading-relaxed">{f.a}</div>
      </details>
    ))}
  </div>
</Section>

<!-- Final CTA -->
<Section bg="dark" watermark="light">
  <div class="text-center max-w-2xl mx-auto" data-reveal>
    <h2 class="mega text-ink-50" style="font-size: clamp(2rem, 5vw, 4rem)">
      {labels.cta}
    </h2>
    <p class="mt-6 text-lg text-ink-300">{labels.sub}</p>
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a
        href={`https://wa.me/?text=${encodeURIComponent(lang === 'pt' ? 'Olá! Vou visitar a Freedom Church neste domingo.' : lang === 'en' ? 'Hi! I will visit Freedom Church this Sunday.' : '¡Hola! Voy a visitar Freedom Church este domingo.')}`}
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        {labels.btn}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href={localizedPath(lang, '/contato')} class="btn btn-ghost-light">
        {lang === 'pt' ? 'Prefiro mandar uma mensagem' : lang === 'en' ? 'I prefer to send a message' : 'Prefiero enviar un mensaje'}
      </a>
    </div>
  </div>
</Section>

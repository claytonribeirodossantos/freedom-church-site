---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);
const services = church.services[lang];

const expect = {
  pt: [
    { icon: '✦', t: 'Música ao vivo', d: 'Adoração em português, inglês e espanhol.' },
    { icon: '✝', t: 'Palavra prática', d: 'Mensagens bíblicas que tocam a vida real.' },
    { icon: '☕', t: 'Café e conexão', d: 'Tempo de bater papo antes e depois do culto.' },
    { icon: '✚', t: 'Kids', d: 'Espaço seguro e divertido para os pequenos.' },
  ],
  en: [
    { icon: '✦', t: 'Live music', d: 'Worship in Portuguese, English and Spanish.' },
    { icon: '✝', t: 'Practical Word', d: 'Biblical messages that touch real life.' },
    { icon: '☕', t: 'Coffee & connection', d: 'Time to chat before and after the service.' },
    { icon: '✚', t: 'Kids', d: 'A safe and fun space for the little ones.' },
  ],
  es: [
    { icon: '✦', t: 'Música en vivo', d: 'Alabanza en portugués, inglés y español.' },
    { icon: '✝', t: 'Palabra práctica', d: 'Mensajes bíblicos que tocan la vida real.' },
    { icon: '☕', t: 'Café y conexión', d: 'Tiempo para conversar antes y después del culto.' },
    { icon: '✚', t: 'Niños', d: 'Espacio seguro y divertido para los pequeños.' },
  ],
}[lang];

const heading = {
  pt: { schedule: 'Horário', expect: 'O que esperar', location: 'Onde estamos', directions: 'Como chegar', videosEyebrow: 'Vídeos', videos: 'Um pouco dos nossos cultos' },
  en: { schedule: 'Schedule', expect: 'What to expect', location: 'Where we are', directions: 'Get directions', videosEyebrow: 'Videos', videos: 'A glimpse of our services' },
  es: { schedule: 'Horario', expect: 'Qué esperar', location: 'Dónde estamos', directions: 'Cómo llegar', videosEyebrow: 'Videos', videos: 'Un poco de nuestros cultos' },
}[lang];

// Vídeos dos cultos. Para adicionar mais: copie o arquivo em public/cultos/
// (ex: culto-2.mp4) e acrescente uma linha abaixo seguindo o mesmo formato.
const videos: { src: string; title?: { pt: string; en: string; es: string } }[] = [
  { src: '/cultos/culto-1.mp4' },
];

const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(church.address.full)}&output=embed`;
---

<PageHero pageKey="services" />

<Section bg="light">
  <SectionHeader eyebrow={heading.schedule} title={heading.schedule} />
  <div class:list={['grid gap-px bg-ink-200 rounded-2xl overflow-hidden', services.length === 1 ? 'md:grid-cols-1' : 'md:grid-cols-3']}>
    {services.map((s) => (
      <div class="bg-ink-50 p-8 lg:p-12">
        <div class="text-xs uppercase tracking-widest text-gold-600 mb-2">{s.day}</div>
        <div class="font-display text-5xl text-ink-950">{s.time}</div>
        <div class="mt-4 text-lg text-ink-900 font-medium">{s.name}</div>
        <p class="mt-2 text-base text-ink-600 leading-relaxed">{s.desc}</p>
      </div>
    ))}
  </div>
</Section>

<Section bg="tint">
  <SectionHeader eyebrow={heading.expect} title={heading.expect} />
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {expect.map((e) => (
      <div class="bg-ink-50 rounded-2xl p-6 hover:shadow-lg transition-shadow">
        <div class="text-3xl text-gold-500 mb-4">{e.icon}</div>
        <h3 class="text-lg text-ink-950">{e.t}</h3>
        <p class="mt-2 text-sm text-ink-600 leading-relaxed">{e.d}</p>
      </div>
    ))}
  </div>
</Section>

<Section bg="light">
  <SectionHeader eyebrow={heading.videosEyebrow} title={heading.videos} />
  <div class:list={['gap-6', videos.length === 1 ? 'max-w-3xl mx-auto' : 'grid md:grid-cols-2']}>
    {videos.map((v, i) => (
      <figure class="group" data-reveal data-reveal-delay={(i % 3) + 1}>
        <div class="relative aspect-video rounded-2xl overflow-hidden bg-ink-900 shadow-lg">
          <video
            src={v.src}
            controls
            playsinline
            preload="metadata"
            class="absolute inset-0 w-full h-full object-cover"
          ></video>
        </div>
        {v.title && <figcaption class="mt-3 text-sm text-ink-600 text-center">{v.title[lang]}</figcaption>}
      </figure>
    ))}
  </div>
</Section>

<Section bg="dark">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <span class="eyebrow !text-gold-400">{heading.location}</span>
      <h2 class="mt-4 text-3xl lg:text-4xl text-ink-50 leading-tight">{heading.location}</h2>
      <address class="not-italic mt-6 text-lg text-ink-300 leading-relaxed">
        {church.address.street}<br />
        {church.address.city}, {church.address.state} {church.address.zip}<br />
        {church.address.country}
      </address>
      <a href={church.address.googleMapsUrl} target="_blank" rel="noopener" class="mt-8 inline-flex btn btn-primary !bg-gold-500 !text-ink-950 hover:!bg-gold-400">
        {heading.directions}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="aspect-video bg-ink-800 rounded-2xl overflow-hidden">
      <iframe
        src={mapEmbed}
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Freedom Church location"
      ></iframe>
    </div>
  </div>
</Section>

---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

// Agenda oficial da igreja (Church Center), incorporada ao vivo.
const churchCenterEmbed = 'https://ourfreedomchurch.churchcenter.com/calendar?view=gallery&embed=true';

const labels = {
  pt: { eyebrow: 'Nossa agenda', heading: 'O que vem por aí', sub: 'Reserve a data e venha com a gente — tudo direto da nossa agenda oficial, sempre atualizado.' },
  en: { eyebrow: 'Our calendar', heading: 'What’s coming up', sub: 'Save the date and join us — straight from our official calendar, always up to date.' },
  es: { eyebrow: 'Nuestra agenda', heading: 'Lo que viene', sub: 'Reserva la fecha y ven con nosotros — directo de nuestra agenda oficial, siempre actualizada.' },
}[lang];
---

<PageHero pageKey="events" image="/cultos/gallery/cultos-02.jpg" />

<Section bg="light" watermark="dark">
  <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-14" data-reveal>
    <span class="eyebrow justify-center">{labels.eyebrow}</span>
    <h2 class="mt-3 font-display text-4xl lg:text-5xl text-ink-950 leading-tight">{labels.heading}</h2>
    <p class="mt-4 text-lg text-ink-600 leading-relaxed">{labels.sub}</p>
  </div>

  <div class="max-w-5xl mx-auto" data-reveal>
    <iframe
      src={churchCenterEmbed}
      title="Agenda Freedom Church"
      id="cc-calendar"
      class="w-full rounded-2xl bg-transparent"
      style="height: 900px; border: 0;"
      loading="lazy"
    ></iframe>
  </div>
</Section>

<script>
  // O embed do Church Center envia a própria altura ({ pageHeight }) —
  // ajusta o iframe pra caber todos os eventos, sem rolagem interna.
  window.addEventListener('message', (e) => {
    if (!e.origin.includes('churchcenter.com')) return;
    const h = e.data && e.data.pageHeight;
    if (typeof h === 'number' && h > 200) {
      const f = document.getElementById('cc-calendar');
      if (f) f.style.height = h + 'px';
    }
  });
</script>

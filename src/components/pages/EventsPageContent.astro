---
import { getCollection } from 'astro:content';
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { formatDate, pickLocalized } from '../../i18n/format';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);
const now = new Date();

const events = (await getCollection('events'))
  .filter((e) => e.data.date.valueOf() >= now.valueOf() - 24 * 60 * 60 * 1000)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const labels = {
  pt: { eyebrow: 'Nossa agenda', heading: 'O que vem por aí', sub: 'Reserve a data e venha com a gente — tem sempre algo acontecendo na Freedom Church.', next: 'Próximo evento', addCal: 'Adicionar ao calendário', empty: 'Nenhum evento agendado no momento. Volte em breve — tem novidade chegando!' },
  en: { eyebrow: 'Our calendar', heading: 'What’s coming up', sub: 'Save the date and join us — there’s always something happening at Freedom Church.', next: 'Next event', addCal: 'Add to calendar', empty: 'No upcoming events right now. Check back soon — something is on the way!' },
  es: { eyebrow: 'Nuestra agenda', heading: 'Lo que viene', sub: 'Reserva la fecha y ven con nosotros — siempre hay algo en Freedom Church.', next: 'Próximo evento', addCal: 'Añadir al calendario', empty: 'No hay eventos programados por ahora. ¡Vuelve pronto, viene algo nuevo!' },
}[lang];

// Cores por categoria — dão energia e identidade visual a cada tipo de evento.
const tagStyles = {
  'Conferência': { grad: 'from-violet-500 to-fuchsia-600', pill: 'bg-violet-100 text-violet-700', dot: 'bg-violet-500', accent: 'text-violet-600', ring: 'hover:border-violet-300' },
  'Comunhão':    { grad: 'from-amber-500 to-orange-600',   pill: 'bg-amber-100 text-amber-700',   dot: 'bg-amber-500',  accent: 'text-amber-600',  ring: 'hover:border-amber-300' },
  'Jovens':      { grad: 'from-pink-500 to-rose-600',      pill: 'bg-pink-100 text-pink-700',     dot: 'bg-pink-500',   accent: 'text-pink-600',   ring: 'hover:border-pink-300' },
  'Missão':      { grad: 'from-emerald-500 to-teal-600',   pill: 'bg-emerald-100 text-emerald-700', dot: 'bg-emerald-500', accent: 'text-emerald-600', ring: 'hover:border-emerald-300' },
};
const defaultStyle = { grad: 'from-amber-500 to-orange-600', pill: 'bg-amber-100 text-amber-700', dot: 'bg-amber-500', accent: 'text-amber-600', ring: 'hover:border-amber-300' };

const ymd = (d) => `${d.getUTCFullYear()}${String(d.getUTCMonth() + 1).padStart(2, '0')}${String(d.getUTCDate()).padStart(2, '0')}`;

const items = events.map((e) => {
  // Dates in the markdown are date-only (midnight UTC) — format them in UTC so
  // they don't shift to the previous day in timezones behind UTC.
  const day = formatDate(e.data.date, lang, { day: '2-digit', timeZone: 'UTC' });
  const month = formatDate(e.data.date, lang, { month: 'short', timeZone: 'UTC' }).replace('.', '').toUpperCase();
  const weekday = formatDate(e.data.date, lang, { weekday: 'long', timeZone: 'UTC' });
  const title = pickLocalized(e.data, 'title', lang);
  const desc = pickLocalized(e.data, 'description', lang);
  const year = e.data.date.getUTCFullYear();
  const start = ymd(e.data.date);
  const end = ymd(new Date(e.data.date.valueOf() + 24 * 60 * 60 * 1000));
  const calParams = new URLSearchParams({
    action: 'TEMPLATE',
    text: title,
    dates: start + '/' + end,
    details: desc + '\n\n' + church.name,
    location: e.data.place,
  });
  const gcal = 'https://calendar.google.com/calendar/render?' + calParams.toString();
  return { id: e.id, day, month, year, weekday, title, desc, tag: e.data.tag, time: e.data.time, place: e.data.place, style: tagStyles[e.data.tag] ?? defaultStyle, gcal };
});

const featured = items[0];
const rest = items.slice(1);
---

<PageHero pageKey="events" />

<Section bg="light" watermark="dark">
  {events.length === 0 ? (
    <div class="text-center py-16">
      <div class="mx-auto mb-6 w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center">
        <svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" class="text-amber-600"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4" stroke-linecap="round"/></svg>
      </div>
      <p class="text-lg text-ink-600 max-w-md mx-auto">{labels.empty}</p>
    </div>
  ) : (
    <div>
      {/* intro */}
      <div class="text-center max-w-2xl mx-auto mb-14 lg:mb-16" data-reveal>
        <span class="eyebrow justify-center">{labels.eyebrow}</span>
        <h2 class="mt-3 font-display text-4xl lg:text-5xl text-ink-950 leading-tight">{labels.heading}</h2>
        <p class="mt-4 text-lg text-ink-600 leading-relaxed">{labels.sub}</p>
      </div>

      {/* PRÓXIMO EVENTO em destaque */}
      <article class:list={['relative overflow-hidden rounded-[2rem] p-8 lg:p-12 text-white bg-gradient-to-br shadow-xl', featured.style.grad]} data-reveal>
        <div class="pointer-events-none absolute -top-16 -right-10 w-64 h-64 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-10 w-72 h-72 rounded-full bg-white/10"></div>
        <div class="relative z-10 flex flex-col md:flex-row gap-8 lg:gap-12 items-start">
          {/* data */}
          <div class="shrink-0 text-center bg-white/20 backdrop-blur rounded-2xl px-7 py-5 min-w-[120px]">
            <div class="text-xs uppercase tracking-[0.2em] opacity-90">{featured.month}</div>
            <div class="font-display text-6xl font-medium leading-none my-1">{featured.day}</div>
            <div class="text-xs opacity-90">{featured.year}</div>
          </div>
          {/* conteúdo */}
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wide bg-white/25 px-3 py-1.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>{labels.next}
              </span>
              <span class="text-xs uppercase tracking-widest font-medium opacity-90">{featured.tag}</span>
            </div>
            <h3 class="font-display text-3xl lg:text-4xl leading-tight">{featured.title}</h3>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium opacity-95 capitalize">
              <span class="inline-flex items-center gap-1.5"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7.5" cy="7.5" r="6"/><path d="M7.5 4v3.5L10 9" stroke-linecap="round"/></svg>{featured.weekday} · {featured.time}</span>
              <span class="inline-flex items-center gap-1.5"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.5 1.5a5 5 0 0 1 5 5c0 3.5-5 8-5 8s-5-4.5-5-8a5 5 0 0 1 5-5Z"/><circle cx="7.5" cy="6.5" r="1.6"/></svg>{featured.place}</span>
            </div>
            <p class="mt-5 text-base lg:text-lg leading-relaxed text-white/90 max-w-2xl">{featured.desc}</p>
            <a href={featured.gcal} target="_blank" rel="noopener" class="mt-7 inline-flex items-center gap-2 bg-white text-ink-950 font-semibold rounded-full py-3.5 px-7 hover:-translate-y-0.5 hover:shadow-lg transition-all">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3.5" width="13" height="11" rx="2"/><path d="M2 7h13M6 1.5v3M11 1.5v3M8.5 10.5h0" stroke-linecap="round"/></svg>
              {labels.addCal}
            </a>
          </div>
        </div>
      </article>

      {/* DEMAIS EVENTOS */}
      {rest.length > 0 && (
        <div class="grid md:grid-cols-2 gap-6 mt-6">
          {rest.map((e, i) => (
            <article class:list={['group bg-ink-50 border border-ink-200 rounded-2xl p-6 lg:p-7 flex gap-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl', e.style.ring]} data-reveal data-reveal-delay={(i % 3) + 1}>
              <div class="shrink-0">
                <div class:list={['text-white rounded-xl px-4 py-3 text-center min-w-[72px] bg-gradient-to-br', e.style.grad]}>
                  <div class="font-display text-3xl font-medium leading-none">{e.day}</div>
                  <div class="text-[0.65rem] uppercase tracking-widest mt-1">{e.month}</div>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <span class:list={['inline-block text-xs font-semibold uppercase tracking-wide px-2.5 py-1 rounded-full mb-2', e.style.pill]}>{e.tag}</span>
                <h3 class="font-display text-xl lg:text-2xl text-ink-950 leading-tight">{e.title}</h3>
                <div class="mt-1.5 text-sm text-ink-500 capitalize">{e.weekday} · {e.time} · {e.place}</div>
                <p class="mt-3 text-ink-700 leading-relaxed text-sm">{e.desc}</p>
                <a href={e.gcal} target="_blank" rel="noopener" class:list={['mt-4 inline-flex items-center gap-1.5 text-sm font-medium transition-colors', e.style.accent]}>
                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3.5" width="11" height="9.5" rx="2"/><path d="M2 6.5h11M5 1.5v3M10 1.5v3" stroke-linecap="round"/></svg>
                  {labels.addCal}
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  )}
</Section>

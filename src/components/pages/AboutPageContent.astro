---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const values = {
  pt: [
    { t: 'Cristo no centro', d: 'Tudo o que fazemos parte da pessoa e obra de Jesus.' },
    { t: 'Família', d: 'Cuidar uns dos outros como uma casa cuida dos seus.' },
    { t: 'Generosidade', d: 'Servir antes de ser servido. Dar antes de receber.' },
    { t: 'Excelência simples', d: 'Fazer bem-feito, sem perder a alma.' },
    { t: 'Missão', d: 'Levar esperança onde há sede de sentido.' },
    { t: 'Liberdade', d: 'Onde o Espírito do Senhor está, há liberdade.' },
  ],
  en: [
    { t: 'Christ at the center', d: 'Everything we do flows from the person and work of Jesus.' },
    { t: 'Family', d: 'Caring for one another like a household cares for its own.' },
    { t: 'Generosity', d: 'Serve before being served. Give before receiving.' },
    { t: 'Simple excellence', d: 'Do it well, without losing the soul.' },
    { t: 'Mission', d: 'Bring hope where there is hunger for meaning.' },
    { t: 'Freedom', d: 'Where the Spirit of the Lord is, there is freedom.' },
  ],
  es: [
    { t: 'Cristo en el centro', d: 'Todo lo que hacemos parte de la persona y obra de Jesús.' },
    { t: 'Familia', d: 'Cuidarnos unos a otros como una casa cuida a los suyos.' },
    { t: 'Generosidad', d: 'Servir antes de ser servido. Dar antes de recibir.' },
    { t: 'Excelencia sencilla', d: 'Hacer bien hecho, sin perder el alma.' },
    { t: 'Misión', d: 'Llevar esperanza donde hay sed de sentido.' },
    { t: 'Libertad', d: 'Donde está el Espíritu del Señor, hay libertad.' },
  ],
}[lang];

const heading = {
  pt: { story: 'Nossa história', mission: 'Nossa missão', values: 'Nossos valores' },
  en: { story: 'Our story', mission: 'Our mission', values: 'Our values' },
  es: { story: 'Nuestra historia', mission: 'Nuestra misión', values: 'Nuestros valores' },
}[lang];

const storyText = {
  pt: 'A Freedom Church começou como um sonho: ver brasileiros longe de casa encontrando família, propósito e a presença de Deus. O que começou pequeno hoje é uma comunidade vibrante que recebe pessoas de toda história, idade e nacionalidade.',
  en: 'Freedom Church began as a dream: to see Brazilians far from home finding family, purpose and the presence of God. What started small is today a vibrant community that welcomes people from every story, age and nationality.',
  es: 'Freedom Church comenzó como un sueño: ver brasileños lejos de casa encontrando familia, propósito y la presencia de Dios. Lo que empezó pequeño hoy es una comunidad vibrante que recibe a personas de toda historia, edad y nacionalidad.',
}[lang];

const missionText = {
  pt: 'Tornar Jesus conhecido entre os brasileiros nos Estados Unidos, formando discípulos que vivem livres, amam profundamente e servem com alegria.',
  en: 'To make Jesus known among Brazilians in the United States, forming disciples who live free, love deeply and serve with joy.',
  es: 'Dar a conocer a Jesús entre los brasileños en Estados Unidos, formando discípulos que viven libres, aman profundamente y sirven con alegría.',
}[lang];
---

<PageHero pageKey="about" />

<Section bg="light">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-5">
      <span class="eyebrow">{heading.story}</span>
      <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">
        {heading.story}
      </h2>
    </div>
    <div class="lg:col-span-7">
      <p class="text-lg text-ink-700 leading-relaxed">{storyText}</p>
    </div>
  </div>
</Section>

<Section bg="tint">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-5">
      <span class="eyebrow">{heading.mission}</span>
      <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">
        {heading.mission}
      </h2>
    </div>
    <div class="lg:col-span-7">
      <blockquote class="font-display text-2xl lg:text-3xl text-ink-900 leading-relaxed italic border-l-4 border-gold-500 pl-6">
        "{missionText}"
      </blockquote>
    </div>
  </div>
</Section>

<Section bg="light">
  <SectionHeader eyebrow={heading.values} title={heading.values} />
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-200 rounded-2xl overflow-hidden">
    {values.map((v, i) => (
      <div class="bg-ink-50 p-8 group hover:bg-ink-950 transition-colors duration-300">
        <div class="text-gold-500 text-3xl font-display font-light mb-3">
          {String(i + 1).padStart(2, '0')}
        </div>
        <h3 class="text-xl text-ink-950 group-hover:text-ink-50 transition-colors">{v.t}</h3>
        <p class="mt-3 text-sm text-ink-600 group-hover:text-ink-300 leading-relaxed transition-colors">{v.d}</p>
      </div>
    ))}
  </div>
</Section>

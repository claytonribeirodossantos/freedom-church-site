---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const labels = {
  pt: {
    name: 'Seu nome', namePh: 'Como gostaria de ser chamado',
    email: 'Email (opcional)', emailPh: 'voce@email.com',
    subject: 'Assunto', subjectPh: 'Resuma seu pedido em uma frase',
    request: 'Seu pedido', requestPh: 'Conte o que está no seu coração. Vamos orar.',
    anon: 'Manter meu pedido em sigilo (apenas pastores)',
    privacyCheck: 'Li e concordo com a Política de Privacidade',
    submit: 'Enviar pedido',
    sending: 'Enviando...',
    success: 'Recebemos seu pedido. Estamos orando por você.',
    error: 'Houve um problema. Tente novamente ou escreva direto pra ' + church.contact.email,
    verseRef: 'Filipenses 4:6-7',
    verse: 'Não andem ansiosos por coisa alguma, mas em tudo, pela oração e súplicas, e com ação de graças, apresentem seus pedidos a Deus.',
  },
  en: {
    name: 'Your name', namePh: 'How you would like to be called',
    email: 'Email (optional)', emailPh: 'you@email.com',
    subject: 'Subject', subjectPh: 'Summarize your request in one sentence',
    request: 'Your request', requestPh: 'Share what is in your heart. We will pray.',
    anon: 'Keep my request confidential (pastors only)',
    privacyCheck: 'I read and agree with the Privacy Policy',
    submit: 'Send request',
    sending: 'Sending...',
    success: 'We received your request. We are praying for you.',
    error: 'There was a problem. Try again or write directly to ' + church.contact.email,
    verseRef: 'Philippians 4:6-7',
    verse: 'Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.',
  },
  es: {
    name: 'Tu nombre', namePh: 'Cómo te gustaría ser llamado',
    email: 'Correo (opcional)', emailPh: 'tu@email.com',
    subject: 'Asunto', subjectPh: 'Resume tu petición en una frase',
    request: 'Tu petición', requestPh: 'Comparte lo que hay en tu corazón. Vamos a orar.',
    anon: 'Mantener mi petición en confidencialidad (solo pastores)',
    privacyCheck: 'Leí y acepto la Política de Privacidad',
    submit: 'Enviar petición',
    sending: 'Enviando...',
    success: 'Recibimos tu petición. Estamos orando por ti.',
    error: 'Hubo un problema. Inténtalo de nuevo o escribe a ' + church.contact.email,
    verseRef: 'Filipenses 4:6-7',
    verse: 'Por nada estéis afanosos, sino sean conocidas vuestras peticiones delante de Dios en toda oración y ruego, con acción de gracias.',
  },
}[lang];
---

<PageHero pageKey="prayer" />

<Section bg="light" watermark="dark">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-7">
      <form id="prayer-form" class="space-y-6 w-full" data-lang={lang}>
        <input type="hidden" name="access_key" value={church.web3FormsAccessKey} />
        <input type="hidden" name="subject" value="Pedido de oração — Freedom Church" />
        <input type="hidden" name="from_name" value="Freedom Church (Site)" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div>
          <label for="prayer-name" class="block text-sm font-medium text-ink-900 mb-2">{labels.name}</label>
          <input
            id="prayer-name"
            name="name"
            type="text"
            required
            placeholder={labels.namePh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-email" class="block text-sm font-medium text-ink-900 mb-2">{labels.email}</label>
          <input
            id="prayer-email"
            name="email"
            type="email"
            placeholder={labels.emailPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-topic" class="block text-sm font-medium text-ink-900 mb-2">{labels.subject}</label>
          <input
            id="prayer-topic"
            name="topic"
            type="text"
            placeholder={labels.subjectPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-request" class="block text-sm font-medium text-ink-900 mb-2">{labels.request}</label>
          <textarea
            id="prayer-request"
            name="message"
            rows="6"
            required
            placeholder={labels.requestPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900 resize-none"
          ></textarea>
        </div>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="confidential" value="Sim/Yes" class="mt-1 w-4 h-4 accent-gold-500" />
          <span class="text-sm text-ink-700">{labels.anon}</span>
        </label>
        <div class="flex items-start gap-3">
          <input id="prayer-privacy" type="checkbox" name="privacy_consent" required
            class="mt-1 w-4 h-4 rounded border-ink-300 text-gold-600 focus:ring-2 focus:ring-gold-200" />
          <label for="prayer-privacy" class="text-sm text-ink-700 cursor-pointer">
            {labels.privacyCheck}
          </label>
        </div>
        <button type="submit" class="btn btn-primary" data-submit-btn data-label-submit={labels.submit} data-label-sending={labels.sending}>
          {labels.submit}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div id="prayer-success" class="hidden p-5 rounded-xl bg-green-50 border border-green-200 text-green-900 text-sm">
          ✓ {labels.success}
        </div>
        <div id="prayer-error" class="hidden p-5 rounded-xl bg-red-50 border border-red-200 text-red-900 text-sm">
          ✗ {labels.error}
        </div>
      </form>
    </div>
    <div class="lg:col-span-5">
      <div class="bg-ink-950 text-ink-50 rounded-3xl p-8 lg:p-10 lg:sticky lg:top-28">
        <blockquote class="font-display text-xl leading-relaxed italic text-ink-200">
          "{labels.verse}"
        </blockquote>
        <cite class="block mt-6 text-xs uppercase tracking-widest text-gold-400 not-italic">
          — {labels.verseRef}
        </cite>
      </div>
    </div>
  </div>
</Section>

<script>
  const form = document.getElementById('prayer-form') as HTMLFormElement | null;
  const successEl = document.getElementById('prayer-success');
  const errorEl = document.getElementById('prayer-error');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit-btn]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    successEl?.classList.add('hidden');
    errorEl?.classList.add('hidden');

    const sendingLabel = submitBtn.dataset.labelSending ?? 'Sending...';
    const submitLabel = submitBtn.dataset.labelSubmit ?? 'Send';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.6';
    submitBtn.innerHTML = sendingLabel;

    try {
      const formData = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (data.success) {
        successEl?.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error(data.message || 'submit failed');
      }
    } catch (err) {
      console.warn('prayer submit error:', err);
      errorEl?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '';
      submitBtn.innerHTML = submitLabel + ' <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }
  });
</script>

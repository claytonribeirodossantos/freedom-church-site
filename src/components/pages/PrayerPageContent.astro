---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const labels = {
  pt: {
    name: 'Seu nome',
    namePh: 'Como gostaria de ser chamado',
    email: 'Email (opcional)',
    emailPh: 'voce@email.com',
    subject: 'Assunto',
    subjectPh: 'Resuma seu pedido em uma frase',
    request: 'Seu pedido',
    requestPh: 'Conte o que está no seu coração. Vamos orar.',
    anon: 'Manter meu pedido em sigilo (apenas pastores)',
    submit: 'Enviar pedido',
    verseRef: 'Filipenses 4:6-7',
    verse: 'Não andem ansiosos por coisa alguma, mas em tudo, pela oração e súplicas, e com ação de graças, apresentem seus pedidos a Deus.',
  },
  en: {
    name: 'Your name',
    namePh: 'How you would like to be called',
    email: 'Email (optional)',
    emailPh: 'you@email.com',
    subject: 'Subject',
    subjectPh: 'Summarize your request in one sentence',
    request: 'Your request',
    requestPh: 'Share what is in your heart. We will pray.',
    anon: 'Keep my request confidential (pastors only)',
    submit: 'Send request',
    verseRef: 'Philippians 4:6-7',
    verse: 'Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.',
  },
  es: {
    name: 'Tu nombre',
    namePh: 'Cómo te gustaría ser llamado',
    email: 'Correo (opcional)',
    emailPh: 'tu@email.com',
    subject: 'Asunto',
    subjectPh: 'Resume tu petición en una frase',
    request: 'Tu petición',
    requestPh: 'Comparte lo que hay en tu corazón. Vamos a orar.',
    anon: 'Mantener mi petición en confidencialidad (solo pastores)',
    submit: 'Enviar petición',
    verseRef: 'Filipenses 4:6-7',
    verse: 'Por nada estéis afanosos, sino sean conocidas vuestras peticiones delante de Dios en toda oración y ruego, con acción de gracias.',
  },
}[lang];
---

<PageHero pageKey="prayer" />

<Section bg="light">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-7">
      <form class="space-y-6">
        <div>
          <label for="prayer-name" class="block text-sm font-medium text-ink-900 mb-2">{labels.name}</label>
          <input
            id="prayer-name"
            name="name"
            type="text"
            required
            placeholder={labels.namePh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-email" class="block text-sm font-medium text-ink-900 mb-2">{labels.email}</label>
          <input
            id="prayer-email"
            name="email"
            type="email"
            placeholder={labels.emailPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-subject" class="block text-sm font-medium text-ink-900 mb-2">{labels.subject}</label>
          <input
            id="prayer-subject"
            name="subject"
            type="text"
            placeholder={labels.subjectPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900"
          />
        </div>
        <div>
          <label for="prayer-request" class="block text-sm font-medium text-ink-900 mb-2">{labels.request}</label>
          <textarea
            id="prayer-request"
            name="request"
            rows="6"
            required
            placeholder={labels.requestPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900 resize-none"
          ></textarea>
        </div>
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="confidential" class="mt-1 w-4 h-4 accent-gold-500" />
          <span class="text-sm text-ink-700">{labels.anon}</span>
        </label>
        <button type="submit" class="btn btn-primary">
          {labels.submit}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
    </div>
    <div class="lg:col-span-5">
      <div class="bg-ink-950 text-ink-50 rounded-3xl p-8 lg:p-10 sticky top-24">
        <blockquote class="font-display text-xl leading-relaxed italic text-ink-200">
          "{labels.verse}"
        </blockquote>
        <cite class="block mt-6 text-xs uppercase tracking-widest text-gold-400 not-italic">
          — {labels.verseRef}
        </cite>
      </div>
    </div>
  </div>
</Section>

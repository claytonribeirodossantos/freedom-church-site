---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { getChannelVideos, extractSeries, extractPastor, cleanTitle } from '../../lib/youtube';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

// Build-time fetch (server-side from Cloudflare during build). Snapshot pra fallback.
const buildTimeVideos = await getChannelVideos();
const buildTimeSermons = buildTimeVideos.map((v) => ({
  id: v.id,
  title: v.title,
  publishedAt: v.publishedAt.toISOString(),
  series: extractSeries(v.title),
  pastor: extractPastor(v.title),
  cleanTitle: cleanTitle(v.title),
  thumbnail: v.thumbnailUrl,
  watchUrl: v.watchUrl,
}));

const initialJSON = JSON.stringify(buildTimeSermons);

const labels = {
  pt: { all: 'Todas', filter: 'Filtrar por série', loading: 'Carregando pregações...', empty: 'Em breve novas pregações.', subscribe: 'Inscrever no canal', watch: 'Assistir', latest: 'Mais recente' },
  en: { all: 'All', filter: 'Filter by series', loading: 'Loading sermons...', empty: 'New sermons coming soon.', subscribe: 'Subscribe to channel', watch: 'Watch', latest: 'Latest' },
  es: { all: 'Todas', filter: 'Filtrar por serie', loading: 'Cargando prédicas...', empty: 'Pronto nuevas prédicas.', subscribe: 'Suscribirse al canal', watch: 'Ver', latest: 'Más reciente' },
}[lang];

const dateLocale = lang === 'pt' ? 'pt-BR' : lang === 'en' ? 'en-US' : 'es-ES';
const hasBuildData = buildTimeSermons.length > 0;
---

<PageHero pageKey="sermons" />

<Section bg="light">
  <div
    id="sermon-state"
    data-channel-id={church.social.youtubeChannelId}
    data-lang={lang}
    data-date-locale={dateLocale}
    data-label-all={labels.all}
    data-label-filter={labels.filter}
    data-label-latest={labels.latest}
    data-has-initial={hasBuildData ? '1' : '0'}
  >
    <!-- Initial sermons (from build) embedded as JSON -->
    <script id="sermons-initial" type="application/json" set:html={initialJSON} />

    <!-- Loading state (only shown if no build-time data) -->
    {!hasBuildData && (
      <div id="sermon-loading" class="flex flex-col items-center justify-center py-24">
        <div class="w-16 h-16 rounded-full border-4 border-ink-200 border-t-gold-500 animate-spin"></div>
        <p class="mt-6 text-ink-500 text-sm">{labels.loading}</p>
      </div>
    )}

    <!-- Content area -->
    <div id="sermon-content" class:list={[!hasBuildData && 'hidden']}>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-12">
        <div id="sermon-filters" class="flex flex-wrap items-center gap-3">
          <span class="text-sm text-ink-600 mr-2">{labels.filter}:</span>
        </div>
        <a href={church.social.youtube} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium text-gold-600 hover:text-gold-700">
          {labels.subscribe}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Carrossel -->
      <div class="relative group/carousel">
        <button
          type="button"
          data-carousel-prev
          aria-label="Anterior"
          class="hidden md:flex absolute -left-4 lg:-left-5 top-[28%] -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-ink-950 text-ink-50 items-center justify-center shadow-xl hover:bg-gold-500 hover:text-ink-950 transition-all disabled:opacity-0"
        >
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m14 5-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Próximo"
          class="hidden md:flex absolute -right-4 lg:-right-5 top-[28%] -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-ink-950 text-ink-50 items-center justify-center shadow-xl hover:bg-gold-500 hover:text-ink-950 transition-all disabled:opacity-0"
        >
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m8 5 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div id="sermon-grid" class="sermon-track flex gap-5 lg:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-1 px-1"></div>
      </div>
    </div>

    <!-- Empty fallback -->
    <div id="sermon-empty" class="hidden text-center py-24">
      <p class="text-ink-700 text-lg">{labels.empty}</p>
      <a href={church.social.youtube} target="_blank" rel="noopener" class="mt-6 inline-flex btn btn-primary">
        {labels.subscribe}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</Section>

<style>
  .sermon-track { scrollbar-width: none; -ms-overflow-style: none; }
  .sermon-track::-webkit-scrollbar { display: none; }
</style>

<script>
  type Video = {
    id: string;
    title: string;
    publishedAt: string;
    series: string;
    pastor: string;
    cleanTitle: string;
    thumbnail: string;
    watchUrl: string;
  };

  const state = document.getElementById('sermon-state') as HTMLElement;
  const loading = document.getElementById('sermon-loading');
  const content = document.getElementById('sermon-content');
  const empty = document.getElementById('sermon-empty');
  const filtersEl = document.getElementById('sermon-filters');
  const gridEl = document.getElementById('sermon-grid');
  const initialScript = document.getElementById('sermons-initial');

  const channelId = state?.dataset.channelId ?? '';
  const dateLocale = state?.dataset.dateLocale ?? 'pt-BR';
  const labelAll = state?.dataset.labelAll ?? 'All';
  const labelLatest = state?.dataset.labelLatest ?? 'Latest';

  function sortByDate(list: Video[]): Video[] {
    return [...list].sort((a, b) => new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf());
  }

  let videos: Video[] = [];
  try {
    videos = sortByDate(JSON.parse(initialScript?.textContent || '[]'));
  } catch { videos = []; }

  function decodeEntities(s: string): string {
    return s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
            .replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&apos;/g, "'");
  }

  function extractSeries(title: string): string {
    const partMatch = title.match(/\|\s*([^|]+?)\s*\|\s*Part\s*\d+/i);
    if (partMatch) return partMatch[1].trim();
    const pipes = title.split('|').map(s => s.trim()).filter(Boolean);
    if (pipes.length >= 3) {
      const middle = pipes.slice(1, -1);
      if (middle.length > 0) return middle[0];
    }
    if (/sunday\s+service/i.test(title)) return 'Sunday Service';
    if (/culto/i.test(title)) return 'Culto Dominical';
    return 'Mensagem';
  }

  function extractPastor(title: string): string {
    const m = title.match(/^(Pastor[a]?\.?\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?|Pr\.?[a]?\.?\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?)/i);
    return m ? m[1].trim() : 'Freedom Church';
  }

  function cleanTitle(title: string): string {
    return title
      .replace(/^(Pastor[a]?\.?|Pr\.?[a]?\.?)\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?\s*\|\s*/i, '')
      .replace(/\s*\|\s*Freedom Church.*$/i, '')
      .replace(/\s*-\s*Freedom Church.*$/i, '')
      .replace(/\s*\|\s*Part\s*(\d+)/i, ' · Parte $1')
      .trim();
  }

  function videoFromRss(item: Record<string, any>): Video {
    const title = decodeEntities(item.title || '');
    const idMatch = (item.guid || '').match(/yt:video:([A-Za-z0-9_-]+)/)
      || (item.link || '').match(/v=([A-Za-z0-9_-]+)/);
    const id = idMatch ? idMatch[1] : '';
    return {
      id,
      title,
      publishedAt: item.pubDate || item.published || new Date().toISOString(),
      series: extractSeries(title),
      pastor: extractPastor(title),
      cleanTitle: cleanTitle(title),
      thumbnail: `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`,
      watchUrl: `https://www.youtube.com/watch?v=${id}`,
    };
  }

  // Multi-source fetch with fallbacks
  async function fetchLatest(): Promise<Video[] | null> {
    const feedUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;

    // Source 1: rss2json
    try {
      const r = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feedUrl)}&count=50`);
      if (r.ok) {
        const d = await r.json();
        if (d.status === 'ok' && Array.isArray(d.items) && d.items.length > 0) {
          return d.items.map(videoFromRss).filter((v: Video) => v.id);
        }
      }
    } catch (err) {
      console.warn('rss2json failed:', err);
    }

    // Source 2: allorigins.win (CORS proxy)
    try {
      const r = await fetch(`https://api.allorigins.win/raw?url=${encodeURIComponent(feedUrl)}`);
      if (r.ok) {
        const xml = await r.text();
        const entries = xml.split('<entry>').slice(1);
        const vids = entries.map((entry: string) => {
          const idM = entry.match(/<yt:videoId>([^<]+)<\/yt:videoId>/);
          const titleM = entry.match(/<title>([^<]+)<\/title>/);
          const pubM = entry.match(/<published>([^<]+)<\/published>/);
          if (!idM || !titleM) return null;
          const title = decodeEntities(titleM[1]);
          return {
            id: idM[1],
            title,
            publishedAt: pubM ? pubM[1] : new Date().toISOString(),
            series: extractSeries(title),
            pastor: extractPastor(title),
            cleanTitle: cleanTitle(title),
            thumbnail: `https://i.ytimg.com/vi/${idM[1]}/maxresdefault.jpg`,
            watchUrl: `https://www.youtube.com/watch?v=${idM[1]}`,
          } as Video;
        }).filter((v: Video | null): v is Video => v !== null);
        if (vids.length > 0) return vids;
      }
    } catch (err) {
      console.warn('allorigins failed:', err);
    }

    return null;
  }

  let currentFilter = 'all';

  function formatDate(dateStr: string): string {
    try {
      return new Intl.DateTimeFormat(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })
        .format(new Date(dateStr));
    } catch {
      return dateStr;
    }
  }

  function renderFilters() {
    if (!filtersEl) return;
    Array.from(filtersEl.querySelectorAll('button')).forEach(b => b.remove());

    const series = Array.from(new Set(videos.map(v => v.series)));
    const pills = [labelAll, ...series];
    pills.forEach((label, i) => {
      const btn = document.createElement('button');
      btn.textContent = label;
      btn.dataset.filter = i === 0 ? 'all' : label;
      btn.className = 'filter-pill px-4 py-2 rounded-full text-sm transition-colors border';
      const isActive = (currentFilter === 'all' && i === 0) || currentFilter === label;
      if (isActive) {
        btn.classList.add('bg-ink-950', 'text-ink-50', 'border-ink-950');
      } else {
        btn.classList.add('border-ink-200', 'text-ink-700', 'hover:border-ink-950', 'hover:text-ink-950');
      }
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter ?? 'all';
        renderFilters();
        renderGrid();
      });
      filtersEl.appendChild(btn);
    });
  }

  function renderGrid() {
    if (!gridEl) return;
    gridEl.innerHTML = '';
    const visible = currentFilter === 'all' ? videos : videos.filter(v => v.series === currentFilter);

    visible.forEach((v, idx) => {
      const date = formatDate(v.publishedAt);
      const isLatest = idx === 0 && currentFilter === 'all';
      const card = document.createElement('a');
      card.href = v.watchUrl;
      card.target = '_blank';
      card.rel = 'noopener';
      card.className = 'group block shrink-0 snap-start w-[290px] sm:w-[360px] lg:w-[400px]';
      const latestBadge = isLatest
        ? `<div class="absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-ink-950 bg-gold-500 px-2.5 py-1 rounded-full shadow-lg"><span class="w-1.5 h-1.5 rounded-full bg-ink-950 animate-pulse"></span>${labelLatest}</div>`
        : '';
      card.innerHTML = `
        <div class="relative aspect-video rounded-2xl overflow-hidden bg-ink-950 card-editorial ${isLatest ? 'ring-2 ring-gold-500 ring-offset-2 ring-offset-ink-50' : ''}">
          ${latestBadge}
          <img src="${v.thumbnail}" alt="${v.cleanTitle.replace(/"/g, '&quot;')}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://i.ytimg.com/vi/${v.id}/hqdefault.jpg'" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-gold-500 flex items-center justify-center group-hover:scale-110 transition-transform shadow-xl">
              <svg width="22" height="22" fill="currentColor" class="text-ink-950 ml-0.5"><path d="M5 3v22l18-11z"/></svg>
            </div>
          </div>
          <div class="absolute top-3 left-3 text-xs uppercase tracking-widest text-gold-400 bg-ink-950/80 backdrop-blur px-2.5 py-1 rounded">${v.series}</div>
        </div>
        <h3 class="mt-5 text-xl text-ink-950 group-hover:text-gold-600 transition-colors leading-snug font-display">${v.cleanTitle}</h3>
        <div class="mt-2 flex items-center gap-2 text-sm text-ink-500">
          <span>${v.pastor}</span>
          <span class="w-1 h-1 rounded-full bg-ink-400"></span>
          <span>${date}</span>
        </div>
      `;
      gridEl.appendChild(card);
    });
    gridEl.scrollLeft = 0;
    updateArrows();
  }

  // Carousel arrows
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
  function scrollAmount(): number {
    const first = gridEl?.querySelector('a');
    return first ? (first as HTMLElement).offsetWidth + 24 : 380;
  }
  function updateArrows() {
    if (!gridEl || !prevBtn || !nextBtn) return;
    const max = gridEl.scrollWidth - gridEl.clientWidth - 4;
    prevBtn.disabled = gridEl.scrollLeft <= 4;
    nextBtn.disabled = gridEl.scrollLeft >= max;
  }
  prevBtn?.addEventListener('click', () => gridEl?.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => gridEl?.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));
  gridEl?.addEventListener('scroll', updateArrows, { passive: true });

  // Initial render (from build-time snapshot if available)
  if (videos.length > 0) {
    loading?.classList.add('hidden');
    content?.classList.remove('hidden');
    renderFilters();
    renderGrid();
  }

  // Refresh from network in background
  fetchLatest().then((latest) => {
    if (latest && latest.length > 0) {
      videos = sortByDate(latest);
      loading?.classList.add('hidden');
      content?.classList.remove('hidden');
      empty?.classList.add('hidden');
      renderFilters();
      renderGrid();
    } else if (videos.length === 0) {
      loading?.classList.add('hidden');
      empty?.classList.remove('hidden');
    }
  });
</script>

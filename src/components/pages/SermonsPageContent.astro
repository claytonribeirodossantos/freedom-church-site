---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { formatDate } from '../../i18n/format';
import { getChannelVideos, extractSeries, extractPastor, cleanTitle } from '../../lib/youtube';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const videos = await getChannelVideos();
const sermons = videos.map((v) => ({
  ...v,
  series: extractSeries(v.title),
  pastor: extractPastor(v.title),
  cleanTitle: cleanTitle(v.title),
}));

const seriesList = Array.from(new Set(sermons.map((s) => s.series)));

const labels = {
  pt: { all: 'Todas', filter: 'Filtrar por série', empty: 'Carregando pregações...', subscribe: 'Inscrever no canal' },
  en: { all: 'All', filter: 'Filter by series', empty: 'Loading sermons...', subscribe: 'Subscribe to channel' },
  es: { all: 'Todas', filter: 'Filtrar por serie', empty: 'Cargando prédicas...', subscribe: 'Suscribirse al canal' },
}[lang];
---

<PageHero pageKey="sermons" />

<Section bg="light">
  {sermons.length === 0 ? (
    <p class="text-center text-ink-500 py-12">{labels.empty}</p>
  ) : (
    <>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-12">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-sm text-ink-600 mr-2">{labels.filter}:</span>
          <button data-filter="all" class="filter-pill px-4 py-2 rounded-full text-sm border border-ink-950 bg-ink-950 text-ink-50">
            {labels.all}
          </button>
          {seriesList.map((s) => (
            <button data-filter={s} class="filter-pill px-4 py-2 rounded-full text-sm border border-ink-200 text-ink-700 hover:border-ink-950 hover:text-ink-950 transition-colors">
              {s}
            </button>
          ))}
        </div>
        <a href={church.social.youtube} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium text-gold-600 hover:text-gold-700">
          {labels.subscribe}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12" data-sermon-grid>
        {sermons.map((s) => {
          const date = formatDate(s.publishedAt, lang);
          return (
            <a
              href={s.watchUrl}
              target="_blank"
              rel="noopener"
              class="sermon-card group block"
              data-series={s.series}
            >
              <div class="relative aspect-video rounded-xl overflow-hidden bg-ink-950 card-editorial">
                <img
                  src={s.thumbnailUrl}
                  alt={s.cleanTitle}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.src = `https://i.ytimg.com/vi/${this.dataset.id}/hqdefault.jpg`"
                  data-id={s.id}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-16 h-16 rounded-full bg-gold-500 flex items-center justify-center group-hover:scale-110 transition-transform shadow-xl">
                    <svg width="22" height="22" fill="currentColor" class="text-ink-950 ml-0.5"><path d="M5 3v22l18-11z"/></svg>
                  </div>
                </div>
                <div class="absolute top-3 left-3 text-xs uppercase tracking-widest text-gold-400 bg-ink-950/80 backdrop-blur px-2.5 py-1 rounded">
                  {s.series}
                </div>
              </div>
              <h3 class="mt-5 text-xl text-ink-950 group-hover:text-gold-600 transition-colors leading-snug">
                {s.cleanTitle}
              </h3>
              <div class="mt-2 flex items-center gap-2 text-sm text-ink-500">
                <span>{s.pastor}</span>
                <span class="w-1 h-1 rounded-full bg-ink-400"></span>
                <span>{date}</span>
              </div>
            </a>
          );
        })}
      </div>
    </>
  )}
</Section>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.sermon-card');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter;
      pills.forEach((p) => {
        p.classList.remove('bg-ink-950', 'text-ink-50', 'border-ink-950');
        p.classList.add('border-ink-200', 'text-ink-700');
      });
      pill.classList.add('bg-ink-950', 'text-ink-50', 'border-ink-950');
      pill.classList.remove('border-ink-200', 'text-ink-700');

      cards.forEach((card) => {
        if (filter === 'all' || card.dataset.series === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const updated = {
  pt: 'Última atualização: 24 de maio de 2026',
  en: 'Last updated: May 24, 2026',
  es: 'Última actualización: 24 de mayo de 2026',
}[lang];

const sections = {
  pt: [
    { h: '1. Quais dados coletamos', p: 'Coletamos apenas o necessário: nome e email quando você se cadastra na newsletter, preenche um formulário de contato ou faz um pedido de oração. Pagamentos são processados pelo Stripe (não armazenamos dados de cartão).' },
    { h: '2. Como usamos seus dados', p: 'Para responder seu contato, enviar a newsletter (se você optar), processar doações e nos comunicar com você como igreja. Nunca vendemos dados.' },
    { h: '3. Pedidos de oração', p: 'Pedidos marcados como confidenciais são acessados apenas pelos pastores. Pedidos não marcados como confidenciais podem ser compartilhados com a equipe de intercessão.' },
    { h: '4. Cookies', p: 'Usamos cookies essenciais para o site funcionar. Não usamos cookies de rastreamento de terceiros.' },
    { h: '5. Seus direitos', p: 'Você pode pedir o acesso, correção ou exclusão dos seus dados a qualquer momento escrevendo para o email abaixo.' },
    { h: '6. Contato', p: `Dúvidas sobre privacidade: ${church.contact.email}` },
  ],
  en: [
    { h: '1. What data we collect', p: 'We collect only what is needed: name and email when you subscribe to the newsletter, fill a contact form, or submit a prayer request. Payments are processed by Stripe (we do not store card data).' },
    { h: '2. How we use your data', p: 'To respond to your contact, send the newsletter (if you opt in), process donations, and communicate with you as a church. We never sell data.' },
    { h: '3. Prayer requests', p: 'Requests marked as confidential are accessed only by pastors. Non-confidential requests may be shared with the intercession team.' },
    { h: '4. Cookies', p: 'We use essential cookies for the site to work. We do not use third-party tracking cookies.' },
    { h: '5. Your rights', p: 'You can request access, correction, or deletion of your data at any time by writing to the email below.' },
    { h: '6. Contact', p: `Privacy questions: ${church.contact.email}` },
  ],
  es: [
    { h: '1. Qué datos recopilamos', p: 'Solo recopilamos lo necesario: nombre y correo cuando te suscribes a la newsletter, llenas un formulario de contacto o envías una petición de oración. Los pagos los procesa Stripe (no guardamos datos de tarjeta).' },
    { h: '2. Cómo usamos tus datos', p: 'Para responderte, enviar la newsletter (si te suscribes), procesar donaciones y comunicarnos como iglesia. Nunca vendemos datos.' },
    { h: '3. Peticiones de oración', p: 'Las peticiones marcadas como confidenciales solo son vistas por los pastores. Las no confidenciales pueden compartirse con el equipo de intercesión.' },
    { h: '4. Cookies', p: 'Usamos cookies esenciales para que el sitio funcione. No usamos cookies de seguimiento de terceros.' },
    { h: '5. Tus derechos', p: 'Puedes pedir acceso, corrección o eliminación de tus datos en cualquier momento escribiendo al correo de abajo.' },
    { h: '6. Contacto', p: `Dudas sobre privacidad: ${church.contact.email}` },
  ],
}[lang];
---

<PageHero pageKey="privacy" />

<Section bg="light" watermark="dark">
  <article class="max-w-3xl mx-auto">
    <p class="text-sm text-ink-500 mb-10">{updated}</p>
    <div class="space-y-10">
      {sections.map((s) => (
        <section>
          <h2 class="font-display text-2xl text-ink-950 mb-3">{s.h}</h2>
          <p class="text-ink-700 leading-relaxed">{s.p}</p>
        </section>
      ))}
    </div>
  </article>
</Section>

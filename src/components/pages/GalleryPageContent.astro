---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const photos = {
  pt: [
    {
      src: '/uploads/galeria/momento-oracao.jpg',
      tag: 'Oração',
      title: 'Momento de oração',
      desc: 'Quando a igreja se reúne, o Espírito se move.',
    },
    {
      src: '/uploads/galeria/parede-de-fotos.jpg',
      tag: 'Memórias',
      title: 'Parede de memórias',
      desc: 'Cada rosto, uma história. Cada história, uma vida tocada.',
    },
    {
      src: '/uploads/galeria/jantar-elegante.jpg',
      tag: 'Comunhão',
      title: 'Jantar especial',
      desc: 'Mesa preparada, comunhão à mesa.',
    },
  ],
  en: [
    {
      src: '/uploads/galeria/momento-oracao.jpg',
      tag: 'Prayer',
      title: 'Prayer moment',
      desc: 'When the church gathers, the Spirit moves.',
    },
    {
      src: '/uploads/galeria/parede-de-fotos.jpg',
      tag: 'Memories',
      title: 'Wall of memories',
      desc: 'Every face, a story. Every story, a life touched.',
    },
    {
      src: '/uploads/galeria/jantar-elegante.jpg',
      tag: 'Fellowship',
      title: 'Special dinner',
      desc: 'Table prepared, fellowship at the table.',
    },
  ],
  es: [
    {
      src: '/uploads/galeria/momento-oracao.jpg',
      tag: 'Oración',
      title: 'Momento de oración',
      desc: 'Cuando la iglesia se reúne, el Espíritu se mueve.',
    },
    {
      src: '/uploads/galeria/parede-de-fotos.jpg',
      tag: 'Memorias',
      title: 'Pared de memorias',
      desc: 'Cada rostro, una historia. Cada historia, una vida tocada.',
    },
    {
      src: '/uploads/galeria/jantar-elegante.jpg',
      tag: 'Comunión',
      title: 'Cena especial',
      desc: 'Mesa preparada, comunión a la mesa.',
    },
  ],
}[lang];

const labels = {
  pt: { follow: 'Veja mais no nosso Instagram', followCta: 'Seguir' },
  en: { follow: 'See more on our Instagram', followCta: 'Follow' },
  es: { follow: 'Ve más en nuestro Instagram', followCta: 'Seguir' },
}[lang];
---

<PageHero pageKey="gallery" />

<Section bg="light" watermark="dark">
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {photos.map((p, i) => (
      <article class="group" data-reveal data-reveal-delay={(i % 3) + 1}>
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-ink-900 shadow-lg">
          <img
            src={p.src}
            alt={p.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-ink-950 via-ink-950/60 to-transparent pointer-events-none">
            <div class="text-xs uppercase tracking-widest text-gold-400 mb-1">{p.tag}</div>
            <div class="font-display text-xl text-ink-50">{p.title}</div>
            <div class="mt-1 text-xs text-ink-300">{p.desc}</div>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<Section bg="dark">
  <div class="text-center max-w-2xl mx-auto">
    <p class="text-lg text-ink-300">{labels.follow}</p>
    <a
      href={church.social.instagram}
      target="_blank"
      rel="noopener"
      class="mt-6 inline-flex btn btn-primary !bg-gold-500 !text-ink-950 hover:!bg-gold-400"
    >
      {labels.followCta} {church.social.instagramHandle}
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</Section>

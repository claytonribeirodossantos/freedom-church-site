---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const promises = {
  pt: [
    'Devocional curto para a semana',
    'Anúncios e próximos eventos',
    'Link da pregação da semana',
    'Histórias da nossa comunidade',
  ],
  en: [
    'Short devotional for the week',
    'Announcements and upcoming events',
    'Link to the sermon of the week',
    'Stories from our community',
  ],
  es: [
    'Breve devocional para la semana',
    'Anuncios y próximos eventos',
    'Enlace a la prédica de la semana',
    'Historias de nuestra comunidad',
  ],
}[lang];

const labels = {
  pt: { name: 'Seu nome', namePh: 'Como você gosta de ser chamado', email: 'Seu melhor email', emailPh: 'voce@email.com', submit: 'Quero receber', includes: 'O que vem no email', privacy: 'Sem spam. Cancele quando quiser.' },
  en: { name: 'Your name', namePh: 'How you like to be called', email: 'Your best email', emailPh: 'you@email.com', submit: 'Sign me up', includes: 'What you will get', privacy: 'No spam. Unsubscribe anytime.' },
  es: { name: 'Tu nombre', namePh: 'Cómo te gusta que te llamen', email: 'Tu mejor correo', emailPh: 'tu@email.com', submit: 'Quiero recibir', includes: 'Qué incluye el correo', privacy: 'Sin spam. Cancela cuando quieras.' },
}[lang];
---

<PageHero pageKey="newsletter" />

<Section bg="light" watermark="dark">
  <div class="grid lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-7">
      <form class="bg-ink-100 rounded-3xl p-8 lg:p-12 space-y-6 w-full">
        <div>
          <label for="n-name" class="block text-sm font-medium text-ink-900 mb-2">{labels.name}</label>
          <input id="n-name" name="name" type="text" required placeholder={labels.namePh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 bg-ink-50 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900" />
        </div>
        <div>
          <label for="n-email" class="block text-sm font-medium text-ink-900 mb-2">{labels.email}</label>
          <input id="n-email" name="email" type="email" required placeholder={labels.emailPh}
            class="w-full px-4 py-3 rounded-lg border border-ink-200 bg-ink-50 focus:border-ink-950 focus:outline-none focus:ring-2 focus:ring-gold-200 text-ink-900" />
        </div>
        <button type="submit" class="w-full btn btn-primary !bg-gold-500 !text-ink-950 hover:!bg-gold-400">
          {labels.submit}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="text-xs text-center text-ink-500">{labels.privacy}</p>
      </form>
    </div>
    <div class="lg:col-span-5">
      <div class="text-xs uppercase tracking-widest text-gold-600 mb-4">{labels.includes}</div>
      <ul class="space-y-3">
        {promises.map((p) => (
          <li class="flex items-start gap-3 text-ink-800">
            <span class="mt-1 w-5 h-5 shrink-0 rounded-full bg-gold-500/15 text-gold-600 flex items-center justify-center">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3"><path d="m2 6 3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

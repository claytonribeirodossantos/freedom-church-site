---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const verse = {
  pt: { ref: '2 Coríntios 9:7', text: 'Cada um contribua segundo propôs no seu coração; não com tristeza, ou por necessidade; porque Deus ama ao que dá com alegria.' },
  en: { ref: '2 Corinthians 9:7', text: 'Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver.' },
  es: { ref: '2 Corintios 9:7', text: 'Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre.' },
}[lang];

const amounts = [25, 50, 100, 250, 500, 1000];

const purposes = {
  pt: [
    { t: 'Ministério geral', d: 'Sustento da igreja, equipe, manutenção e comunidade.' },
    { t: 'Missões', d: 'Levar o Evangelho dentro e fora da nossa cidade.' },
    { t: 'Ação social', d: 'Cuidado prático com famílias em necessidade.' },
  ],
  en: [
    { t: 'General ministry', d: 'Supporting the church, team, maintenance and community.' },
    { t: 'Missions', d: 'Bringing the Gospel inside and beyond our city.' },
    { t: 'Outreach', d: 'Practical care for families in need.' },
  ],
  es: [
    { t: 'Ministerio general', d: 'Sostenimiento de la iglesia, equipo, mantenimiento y comunidad.' },
    { t: 'Misiones', d: 'Llevar el Evangelio dentro y fuera de nuestra ciudad.' },
    { t: 'Acción social', d: 'Cuidado práctico con familias en necesidad.' },
  ],
}[lang];

const labels = {
  pt: { quick: 'Doação rápida', custom: 'Outro valor', one: 'Única', recur: 'Mensal', donate: 'Doar com segurança', other: 'Outras formas de contribuir', purpose: 'Para onde vai sua oferta', stripe: 'Pagamento seguro via Stripe (USD)' },
  en: { quick: 'Quick gift', custom: 'Other amount', one: 'One-time', recur: 'Monthly', donate: 'Give securely', other: 'Other ways to give', purpose: 'Where your gift goes', stripe: 'Secure payment via Stripe (USD)' },
  es: { quick: 'Donación rápida', custom: 'Otro monto', one: 'Única', recur: 'Mensual', donate: 'Donar de forma segura', other: 'Otras formas de ofrendar', purpose: 'A dónde va tu ofrenda', stripe: 'Pago seguro vía Stripe (USD)' },
}[lang];
---

<PageHero pageKey="give" />

<Section bg="light">
  <div class="max-w-3xl mx-auto text-center">
    <blockquote class="font-display text-2xl lg:text-3xl text-ink-900 leading-relaxed italic">
      "{verse.text}"
    </blockquote>
    <cite class="block mt-4 text-sm uppercase tracking-widest text-gold-600 not-italic">— {verse.ref}</cite>
  </div>
</Section>

<Section bg="tint">
  <div class="max-w-2xl mx-auto">
    <div class="bg-ink-50 rounded-3xl p-8 lg:p-12 shadow-xl border border-ink-200">
      <div class="flex gap-2 mb-6">
        <button class="flex-1 py-3 rounded-lg text-sm font-medium bg-ink-950 text-ink-50">
          {labels.one}
        </button>
        <button class="flex-1 py-3 rounded-lg text-sm font-medium bg-ink-100 text-ink-700 hover:bg-ink-200 transition-colors">
          {labels.recur}
        </button>
      </div>

      <div class="text-xs uppercase tracking-widest text-ink-500 mb-3">{labels.quick}</div>
      <div class="grid grid-cols-3 gap-2 mb-3">
        {amounts.map((a) => (
          <button class="py-3 rounded-lg border border-ink-200 text-ink-900 font-medium hover:border-gold-500 hover:text-gold-600 transition-colors">
            ${a}
          </button>
        ))}
      </div>
      <input
        type="number"
        placeholder={labels.custom}
        class="w-full px-4 py-3 rounded-lg border border-ink-200 focus:border-ink-950 focus:outline-none text-ink-900"
      />

      <a href="#" class="mt-6 w-full btn btn-primary !bg-gold-500 !text-ink-950 hover:!bg-gold-400">
        {labels.donate}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <p class="mt-4 text-xs text-center text-ink-500">{labels.stripe}</p>
    </div>
  </div>
</Section>

<Section bg="light">
  <div class="max-w-2xl mb-12">
    <span class="eyebrow">{labels.purpose}</span>
    <h2 class="mt-4 text-3xl lg:text-4xl text-ink-950 leading-tight">{labels.purpose}</h2>
  </div>
  <div class="grid md:grid-cols-3 gap-px bg-ink-200 rounded-2xl overflow-hidden">
    {purposes.map((p) => (
      <div class="bg-ink-50 p-8">
        <h3 class="text-xl text-ink-950">{p.t}</h3>
        <p class="mt-3 text-sm text-ink-600 leading-relaxed">{p.d}</p>
      </div>
    ))}
  </div>
</Section>

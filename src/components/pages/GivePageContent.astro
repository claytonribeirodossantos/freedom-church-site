---
import PageHero from '../PageHero.astro';
import Section from '../Section.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { church } from '../../data/church';

const lang = getLangFromUrl(Astro.url);

const verse = {
  pt: { ref: '2 Coríntios 9:7', text: 'Cada um contribua segundo propôs no seu coração; não com tristeza, ou por necessidade; porque Deus ama ao que dá com alegria.' },
  en: { ref: '2 Corinthians 9:7', text: 'Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver.' },
  es: { ref: '2 Corintios 9:7', text: 'Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre.' },
}[lang];

const labels = {
  pt: {
    intro: 'Sua oferta sustenta vidas',
    introBody: 'Recebemos suas contribuições por três aplicativos seguros e fáceis. Escolha o que você já usa.',
    sendVia: 'Enviar via',
    copy: 'Copiar',
    copied: 'Copiado!',
    open: 'Abrir app',
    note: 'Nenhuma taxa adicional.',
  },
  en: {
    intro: 'Your gift sustains lives',
    introBody: 'We receive your contributions through three safe and easy apps. Choose the one you already use.',
    sendVia: 'Send via',
    copy: 'Copy',
    copied: 'Copied!',
    open: 'Open app',
    note: 'No extra fees.',
  },
  es: {
    intro: 'Tu ofrenda sostiene vidas',
    introBody: 'Recibimos tus contribuciones por tres aplicaciones seguras y fáciles. Elige la que ya usas.',
    sendVia: 'Enviar por',
    copy: 'Copiar',
    copied: '¡Copiado!',
    open: 'Abrir app',
    note: 'Sin tarifas adicionales.',
  },
}[lang];

const methods = [
  {
    name: 'Zelle',
    color: '#6D1ED4',
    colorDark: '#4A129A',
    identifier: church.giving.zelle.identifier,
    instructions: {
      pt: 'Abra seu banco, escolha Zelle e envie para o email abaixo. Aparece como "Freedom Church".',
      en: 'Open your bank, choose Zelle and send to the email below. Appears as "Freedom Church".',
      es: 'Abre tu banco, elige Zelle y envía al correo de abajo. Aparece como "Freedom Church".',
    }[lang],
    url: '',
    icon: 'M12 0L2 7v10l10 7 10-7V7L12 0zm0 4.5l6 4.2v7.6l-6 4.2-6-4.2V8.7l6-4.2z',
  },
  {
    name: 'Venmo',
    color: '#008CFF',
    colorDark: '#0062CC',
    identifier: church.giving.venmo.handle,
    instructions: {
      pt: 'Abra o app Venmo e busque o usuário abaixo. Confirme o nome "Freedom Church" antes de enviar.',
      en: 'Open the Venmo app and search for the username below. Confirm "Freedom Church" before sending.',
      es: 'Abre la app Venmo y busca el usuario de abajo. Confirma "Freedom Church" antes de enviar.',
    }[lang],
    url: church.giving.venmo.url,
    icon: 'M19.5 4c.5 1.5.5 3 .5 4.5 0 5-3.5 10-7 14h-5L4 6h5l1.5 11C12 14 14 9.5 14 6.5c0-.7 0-1.3-.5-2L19.5 4z',
  },
  {
    name: 'Cash App',
    color: '#00D54B',
    colorDark: '#00A83B',
    identifier: church.giving.cashapp.handle,
    instructions: {
      pt: 'Abra o Cash App, toque em "Send" e digite o $cashtag abaixo.',
      en: 'Open Cash App, tap "Send" and enter the $cashtag below.',
      es: 'Abre Cash App, toca "Send" e ingresa el $cashtag de abajo.',
    }[lang],
    url: church.giving.cashapp.url,
    icon: 'M20.5 8.4l-1.4-.8c-1.4-.8-3-1.4-4.6-1.4-1.6 0-2.5.7-2.5 1.7 0 1 .9 1.5 3 2.2 3.4 1.2 5 2.7 5 5.3 0 3-2.5 5.2-6.5 5.5l-.3 1.6c0 .3-.3.5-.6.5h-1.4c-.4 0-.7-.4-.6-.7l.3-1.6c-1.7-.3-3.3-1-4.6-2-.3-.3-.3-.7 0-.9l1.5-1.4c.2-.2.5-.2.7 0 1.1.9 2.5 1.5 4 1.5 1.8 0 3-.8 3-2 0-1.2-1-1.6-3.5-2.5-2.8-1-4.5-2.4-4.5-5 0-2.7 2.1-4.6 5.6-5l.3-1.6c0-.3.3-.5.6-.5h1.4c.4 0 .7.4.6.7l-.3 1.5c1.4.3 2.7.9 3.8 1.7.3.2.3.6.1.9l-1.4 1.4c-.2.2-.5.2-.7.1z',
  },
];
---

<PageHero pageKey="give" />

<Section bg="light">
  <div class="max-w-3xl mx-auto text-center" data-reveal>
    <blockquote class="font-display text-2xl lg:text-3xl text-ink-900 leading-relaxed italic">
      "{verse.text}"
    </blockquote>
    <cite class="block mt-4 text-sm uppercase tracking-widest text-gold-600 not-italic">— {verse.ref}</cite>
  </div>
</Section>

<Section bg="tint" watermark="dark">
  <div class="max-w-2xl mb-12" data-reveal>
    <span class="eyebrow">{labels.intro}</span>
    <h2 class="mt-4 mega text-ink-950" style="font-size: clamp(2rem, 5vw, 3.5rem)">{labels.intro}</h2>
    <p class="mt-5 text-lg text-ink-700 leading-relaxed">{labels.introBody}</p>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {methods.map((m, i) => (
      <article
        class="group bg-ink-50 rounded-3xl overflow-hidden border border-ink-200/70 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col"
        data-reveal
        data-reveal-delay={i + 1}
      >
        <!-- cabeçalho colorido da marca -->
        <div class="relative overflow-hidden p-7 lg:p-8 text-white" style={`background: linear-gradient(135deg, ${m.color}, ${m.colorDark});`}>
          <div class="pointer-events-none absolute -top-10 -right-10 w-36 h-36 rounded-full bg-white/10"></div>
          <div class="pointer-events-none absolute -bottom-12 -left-6 w-28 h-28 rounded-full bg-white/5"></div>
          <div class="relative flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300">
              <svg width="32" height="32" fill="white" viewBox="0 0 24 24"><path d={m.icon} /></svg>
            </div>
            <div>
              <h3 class="font-display text-2xl leading-none">{m.name}</h3>
              <div class="mt-1.5 text-xs uppercase tracking-[0.18em] text-white/80">{labels.sendVia} {m.name}</div>
            </div>
          </div>
        </div>

        <div class="p-7 lg:p-8 flex flex-col flex-1">
          <p class="text-sm text-ink-600 leading-relaxed">{m.instructions}</p>

          <div class="mt-6 p-4 rounded-2xl bg-ink-100 border border-ink-200 flex items-center justify-between gap-3">
            <code class="text-base text-ink-950 font-semibold font-mono truncate" data-copy-target>{m.identifier}</code>
            <button
              type="button"
              class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink-950 bg-gold-500 hover:bg-gold-400 px-3 py-2 rounded-full transition-colors"
              data-copy={m.identifier}
              data-label-copy={labels.copy}
              data-label-copied={labels.copied}
            >
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10" stroke-linecap="round"/></svg>
              {labels.copy}
            </button>
          </div>

          <div class="flex-1"></div>
          {m.url && (
            <a
              href={m.url}
              target="_blank"
              rel="noopener"
              class="mt-5 w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-full text-sm font-semibold text-white hover:-translate-y-0.5 hover:shadow-lg transition-all"
              style={`background: linear-gradient(135deg, ${m.color}, ${m.colorDark});`}
            >
              {labels.open} {m.name}
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <p class="mt-10 text-center text-sm text-ink-500">{labels.note}</p>
</Section>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      const labelCopy = btn.dataset.labelCopy ?? 'Copy';
      const labelCopied = btn.dataset.labelCopied ?? 'Copied!';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = labelCopied;
        btn.classList.add('text-green-600');
        setTimeout(() => {
          btn.textContent = labelCopy;
          btn.classList.remove('text-green-600');
        }, 2000);
      } catch (err) {
        console.warn('clipboard failed:', err);
      }
    });
  });
</script>

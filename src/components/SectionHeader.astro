---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={['max-w-2xl mb-12 lg:mb-16', alignClass]} data-reveal>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl text-ink-950 leading-tight">
    {title}
  </h2>
  {intro && <p class="mt-5 text-lg text-ink-700 leading-relaxed">{intro}</p>}
</div>

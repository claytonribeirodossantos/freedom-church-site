---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { formatDate, pickLocalized } from '../i18n/format';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allSermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = allSermons.find((s) => s.data.featured) ?? allSermons[0];

const fallback = {
  pt: { title: 'Mensagem mais recente', pastor: 'Pr Adaelton & Pra Jheini', date: 'Disponível no YouTube' },
  en: { title: 'Latest message', pastor: 'Ps. Adaelton & Ps. Jheini', date: 'Available on YouTube' },
  es: { title: 'Mensaje más reciente', pastor: 'Pr Adaelton & Pra Jheini', date: 'Disponible en YouTube' },
}[lang];

const copy = {
  pt: { body: 'Toda semana compartilhamos mensagens que conectam a Palavra de Deus à sua vida real. Assista, ouça, compartilhe.', watchAll: 'Ver todas as pregações', listen: 'Assistir agora' },
  en: { body: "Every week we share messages that connect God's Word to your real life. Watch, listen, share.", watchAll: 'View all sermons', listen: 'Watch now' },
  es: { body: 'Cada semana compartimos mensajes que conectan la Palabra de Dios con tu vida real. Mira, escucha, comparte.', watchAll: 'Ver todas las prédicas', listen: 'Ver ahora' },
}[lang];

const data = featured?.data;
const youtubeId = data?.youtubeId ?? church.sampleSermon.youtubeId;
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
const thumbUrl = `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
const series = data?.series ?? 'Sunday Service';
const title = data ? pickLocalized(data, 'title', lang) : fallback.title;
const pastor = data?.pastor ?? fallback.pastor;
const date = data ? formatDate(data.date, lang) : fallback.date;
---

<section class="relative py-32 lg:py-40 bg-ink-950 text-cream-50 overflow-hidden">
  <!-- decorative gradient -->
  <div
    class="absolute inset-0 opacity-50"
    style="background: radial-gradient(60% 80% at 50% 0%, rgba(200, 71, 45, 0.25), transparent 60%);"
  ></div>

  <div class="container-page relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end mb-16">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow" style="color: var(--color-amber-400);">{t('section.sermons.eyebrow')}</span>
        <h2
          class="mt-6 font-display font-medium tracking-tight leading-[0.95] text-cream-50"
          style="font-size: clamp(2.5rem, 6vw, 5.5rem)"
        >
          {lang === 'pt' ? <>A Palavra que <span class="italic text-amber-400 font-light">transforma.</span></> :
           lang === 'en' ? <>The Word that <span class="italic text-amber-400 font-light">transforms.</span></> :
           <>La Palabra que <span class="italic text-amber-400 font-light">transforma.</span></>}
        </h2>
      </div>
      <div class="lg:col-span-5" data-reveal data-reveal-delay="1">
        <p class="text-lg text-cream-300 leading-relaxed">{copy.body}</p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-center" data-reveal data-reveal-delay="2">
      <a
        href={watchUrl}
        target="_blank"
        rel="noopener"
        class="lg:col-span-8 block relative aspect-video rounded-3xl overflow-hidden bg-ink-900 group cursor-pointer card-editorial"
      >
        <img
          src={thumbUrl}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/30 to-transparent"></div>

        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 lg:w-24 lg:h-24 rounded-full bg-clay-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-amber-400 transition-all duration-300 shadow-2xl">
            <svg width="34" height="34" fill="currentColor" class="text-cream-50 ml-1.5"><path d="M5 3v22l18-11z"/></svg>
          </div>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-10">
          <div class="text-xs uppercase tracking-[0.22em] text-amber-400 mb-3">{series}</div>
          <div class="font-display text-3xl lg:text-4xl text-cream-50 leading-tight">{title}</div>
          <div class="mt-3 flex items-center gap-3 text-sm text-cream-300">
            <span>{pastor}</span>
            <span class="w-1 h-1 rounded-full bg-cream-400"></span>
            <span>{date}</span>
          </div>
        </div>
      </a>

      <aside class="lg:col-span-4 space-y-4">
        {allSermons.slice(0, 3).map((s) => {
          const sTitle = pickLocalized(s.data, 'title', lang);
          const sUrl = `https://www.youtube.com/watch?v=${s.data.youtubeId}`;
          return (
            <a
              href={sUrl}
              target="_blank"
              rel="noopener"
              class="block group p-5 rounded-2xl bg-ink-900 border border-ink-800 hover:border-clay-500 hover:bg-ink-800 transition-all"
            >
              <div class="text-xs uppercase tracking-[0.22em] text-amber-400 mb-2">{s.data.series}</div>
              <div class="font-display text-lg text-cream-50 leading-snug group-hover:text-amber-400 transition-colors">{sTitle}</div>
              <div class="mt-2 text-xs text-cream-400">{s.data.pastor} · {s.data.duration}</div>
            </a>
          );
        })}

        <a href={localizedPath(lang, '/pregacoes')} class="block py-3 text-center text-sm font-medium text-amber-400 hover:text-amber-300 transition-colors">
          {copy.watchAll} →
        </a>
      </aside>
    </div>
  </div>
</section>

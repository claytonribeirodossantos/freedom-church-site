---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { formatDate } from '../i18n/format';
import { getChannelVideos, extractSeries, extractPastor, cleanTitle } from '../lib/youtube';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const videos = await getChannelVideos();
const sorted = [...videos].sort((a, b) => b.publishedAt.valueOf() - a.publishedAt.valueOf());
const featured = sorted[0];
const others = sorted.slice(1, 4);

const featTitle = featured ? cleanTitle(featured.title) : 'Última mensagem';
const featSeries = featured ? extractSeries(featured.title) : 'Sunday Service';
const featPastor = featured ? extractPastor(featured.title) : 'Pr Adaelton';
// publishedAt may be epoch (unknown date, from the fallback list) — omit it then.
const featDate = featured && featured.publishedAt.getFullYear() > 2000 ? formatDate(featured.publishedAt, lang) : '';
const featWatch = featured?.watchUrl ?? `https://www.youtube.com/watch?v=${church.sampleSermon.youtubeId}`;
const featThumb = featured?.thumbnailUrl ?? `https://i.ytimg.com/vi/${church.sampleSermon.youtubeId}/maxresdefault.jpg`;
const featId = featured?.id ?? church.sampleSermon.youtubeId;

const copy = {
  pt: { body: 'Toda semana compartilhamos mensagens que conectam a Palavra de Deus à sua vida real. Assista, ouça, compartilhe.', watchAll: 'Ver todas as pregações' },
  en: { body: "Every week we share messages that connect God's Word to your real life. Watch, listen, share.", watchAll: 'View all sermons' },
  es: { body: 'Cada semana compartimos mensajes que conectan la Palabra de Dios con tu vida real. Mira, escucha, comparte.', watchAll: 'Ver todas las prédicas' },
}[lang];
---

<section class="relative py-32 lg:py-40 bg-ink-950 text-ink-50 overflow-hidden">
  <div class="absolute inset-0 opacity-50" style="background: radial-gradient(60% 80% at 50% 0%, rgba(201, 169, 97, 0.2), transparent 60%);"></div>

  <div class="container-page relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end mb-16">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow eyebrow-light">{t('section.sermons.eyebrow')}</span>
        <h2 class="mt-6 mega text-ink-50" style="font-size: clamp(2.5rem, 6vw, 5.5rem)">
          {lang === 'pt' ? <>A Palavra que <span class="italic text-gold-400 font-light">transforma.</span></> :
           lang === 'en' ? <>The Word that <span class="italic text-gold-400 font-light">transforms.</span></> :
           <>La Palabra que <span class="italic text-gold-400 font-light">transforma.</span></>}
        </h2>
      </div>
      <div class="lg:col-span-5" data-reveal data-reveal-delay="1">
        <p class="text-lg text-ink-300 leading-relaxed">{copy.body}</p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-center" data-reveal data-reveal-delay="2" data-sermon-feature data-channel-id={church.social.youtubeChannelId} data-locale={lang === 'pt' ? 'pt-BR' : lang === 'en' ? 'en-US' : 'es-ES'}>
      <a href={featWatch} target="_blank" rel="noopener" class="lg:col-span-8 block relative aspect-video rounded-3xl overflow-hidden bg-ink-900 group cursor-pointer tilt-card card-image-zoom" data-reveal-scale data-feat-link>
        <img
          src={featThumb}
          alt={featTitle}
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
          loading="lazy"
          onerror={`this.src='https://i.ytimg.com/vi/${featId}/hqdefault.jpg'`}
          data-feat-img
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/30 to-transparent"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 lg:w-24 lg:h-24 rounded-full bg-gold-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-gold-400 transition-all duration-300 shadow-2xl">
            <svg width="34" height="34" fill="currentColor" class="text-ink-950 ml-1.5"><path d="M5 3v22l18-11z"/></svg>
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-10">
          <div class="text-xs uppercase tracking-[0.22em] text-gold-400 mb-3" data-feat-series>{featSeries}</div>
          <div class="font-display text-3xl lg:text-4xl text-ink-50 leading-tight" data-feat-title>{featTitle}</div>
          <div class="mt-3 flex items-center gap-3 text-sm text-ink-300">
            <span data-feat-pastor>{featPastor}</span>
            <span class="w-1 h-1 rounded-full bg-ink-400" data-feat-sep class:list={[!featDate && 'hidden']}></span>
            <span data-feat-date>{featDate}</span>
          </div>
        </div>
      </a>

      <aside class="lg:col-span-4 space-y-4">
        {others.map((v) => {
          const title = cleanTitle(v.title);
          const series = extractSeries(v.title);
          const pastor = extractPastor(v.title);
          return (
            <a href={v.watchUrl} target="_blank" rel="noopener" class="block group p-5 rounded-2xl bg-ink-900 border border-ink-800 hover:border-gold-500 hover:bg-ink-800 transition-all">
              <div class="text-xs uppercase tracking-[0.22em] text-gold-400 mb-2">{series}</div>
              <div class="font-display text-lg text-ink-50 leading-snug group-hover:text-gold-400 transition-colors">{title}</div>
              <div class="mt-2 text-xs text-ink-400">{pastor}</div>
            </a>
          );
        })}

        <a href={localizedPath(lang, '/pregacoes')} class="block py-3 text-center text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors">
          {copy.watchAll} →
        </a>
      </aside>
    </div>
  </div>
</section>

<script>
  // Atualiza o vídeo em destaque ao vivo (caso o site não tenha sido reconstruído hoje)
  const root = document.querySelector<HTMLElement>('[data-sermon-feature]');
  if (root) {
    const channelId = root.dataset.channelId ?? '';
    const locale = root.dataset.locale ?? 'pt-BR';
    const feedUrl = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;

    const decode = (s: string) => s.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&apos;/g,"'");
    const clean = (t: string) => t
      .replace(/^(Pastor[a]?\.?|Pr\.?[a]?\.?)\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?\s*\|\s*/i,'')
      .replace(/\s*\|\s*Freedom Church.*$/i,'').replace(/\s*-\s*Freedom Church.*$/i,'')
      .replace(/\s*\|\s*Part\s*(\d+)/i,' · Parte $1').trim();
    const series = (t: string) => {
      const pm = t.match(/\|\s*([^|]+?)\s*\|\s*Part\s*\d+/i); if (pm) return pm[1].trim();
      const p = t.split('|').map(s=>s.trim()).filter(Boolean); if (p.length>=3) return p[1];
      if (/sunday\s+service/i.test(t)) return 'Sunday Service';
      if (/culto/i.test(t)) return 'Culto'; return 'Mensagem';
    };
    const pastor = (t: string) => { const m = t.match(/^(Pastor[a]?\.?\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?|Pr\.?[a]?\.?\s+[A-Za-zÀ-ÿ]+(?:\s+[A-Za-zÀ-ÿ]+)?)/i); return m ? m[1].trim() : 'Freedom Church'; };

    async function latest(): Promise<{id:string,title:string,pub:string}|null> {
      // rss2json
      try {
        const r = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feedUrl)}&count=10`);
        if (r.ok) { const d = await r.json();
          if (d.status==='ok' && d.items?.length) {
            const items = d.items.map((it:any)=>({ id: ((it.guid||'').match(/yt:video:([\w-]+)/)||(it.link||'').match(/v=([\w-]+)/)||[])[1]||'', title: decode(it.title||''), pub: it.pubDate||it.published||'' })).filter((v:any)=>v.id);
            items.sort((a:any,b:any)=>new Date(b.pub).valueOf()-new Date(a.pub).valueOf());
            if (items[0]) return items[0];
          }
        }
      } catch {}
      // allorigins
      try {
        const r = await fetch(`https://api.allorigins.win/raw?url=${encodeURIComponent(feedUrl)}`);
        if (r.ok) { const xml = await r.text();
          const entries = xml.split('<entry>').slice(1).map((e:string)=>{
            const id=(e.match(/<yt:videoId>([^<]+)<\/yt:videoId>/)||[])[1]||'';
            const title=(e.match(/<title>([^<]+)<\/title>/)||[])[1]||'';
            const pub=(e.match(/<published>([^<]+)<\/published>/)||[])[1]||'';
            return { id, title: decode(title), pub };
          }).filter((v:any)=>v.id);
          entries.sort((a:any,b:any)=>new Date(b.pub).valueOf()-new Date(a.pub).valueOf());
          if (entries[0]) return entries[0];
        }
      } catch {}
      return null;
    }

    latest().then((v) => {
      if (!v) return;
      const link = root.querySelector<HTMLAnchorElement>('[data-feat-link]');
      const img = root.querySelector<HTMLImageElement>('[data-feat-img]');
      // Só atualiza se for um vídeo diferente do que veio do build
      if (link && link.href.includes(v.id)) return;
      if (link) link.href = `https://www.youtube.com/watch?v=${v.id}`;
      if (img) { img.src = `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`; img.onerror = () => { img.src = `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`; }; }
      const setTxt = (sel:string, val:string) => { const el = root.querySelector(sel); if (el) el.textContent = val; };
      setTxt('[data-feat-series]', series(v.title));
      setTxt('[data-feat-title]', clean(v.title));
      setTxt('[data-feat-pastor]', pastor(v.title));
      try {
        if (v.pub) {
          setTxt('[data-feat-date]', new Intl.DateTimeFormat(locale,{year:'numeric',month:'long',day:'numeric'}).format(new Date(v.pub)));
          root.querySelector('[data-feat-sep]')?.classList.remove('hidden');
        }
      } catch {}
    });
  }
</script>

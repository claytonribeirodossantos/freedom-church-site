---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { formatDate, pickLocalized } from '../i18n/format';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allSermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = allSermons.find((s) => s.data.featured) ?? allSermons[0];

const fallback = {
  pt: { series: 'Sunday Service', title: 'Mensagem mais recente', pastor: 'Pr Adaelton & Pra Jheini', date: 'Disponível no YouTube' },
  en: { series: 'Sunday Service', title: 'Latest message', pastor: 'Ps. Adaelton & Ps. Jheini', date: 'Available on YouTube' },
  es: { series: 'Sunday Service', title: 'Mensaje más reciente', pastor: 'Pr Adaelton & Pra Jheini', date: 'Disponible en YouTube' },
}[lang];

const bodyCopy = {
  pt: { body: 'Toda semana compartilhamos mensagens que conectam a Palavra de Deus à sua vida real. Assista, ouça, compartilhe.', watchAll: 'Ver todas as pregações' },
  en: { body: "Every week we share messages that connect God's Word to your real life. Watch, listen, share.", watchAll: 'View all sermons' },
  es: { body: 'Cada semana compartimos mensajes que conectan la Palabra de Dios con tu vida real. Mira, escucha, comparte.', watchAll: 'Ver todas las prédicas' },
}[lang];

const data = featured?.data;
const youtubeId = data?.youtubeId ?? church.sampleSermon.youtubeId;
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
const thumbUrl = `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
const series = data?.series ?? fallback.series;
const title = data ? pickLocalized(data, 'title', lang) : fallback.title;
const pastor = data?.pastor ?? fallback.pastor;
const date = data ? formatDate(data.date, lang) : fallback.date;
---

<section class="bg-ink-100 py-24 lg:py-32">
  <div class="container-page">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <a
          href={watchUrl}
          target="_blank"
          rel="noopener"
          class="block relative aspect-video rounded-2xl overflow-hidden bg-ink-950 shadow-2xl group cursor-pointer"
        >
          <img
            src={thumbUrl}
            alt={title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-ink-950/20 to-transparent"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-20 h-20 rounded-full bg-gold-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-xl">
              <svg width="28" height="28" fill="currentColor" class="text-ink-950 ml-1"><path d="M5 3v22l18-11z"/></svg>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-ink-50">
            <div class="text-xs uppercase tracking-widest text-gold-400 mb-1">{series}</div>
            <div class="font-display text-2xl">{title}</div>
          </div>
        </a>
      </div>

      <div class="lg:col-span-5 order-1 lg:order-2">
        <span class="eyebrow">{t('section.sermons.eyebrow')}</span>
        <h2 class="mt-4 text-4xl lg:text-5xl text-ink-950 leading-tight">
          {t('section.sermons.title')}
        </h2>
        <div class="mt-6 flex items-center gap-3 text-sm text-ink-500">
          <span>{pastor}</span>
          <span class="w-1 h-1 rounded-full bg-ink-400"></span>
          <span>{date}</span>
        </div>
        <p class="mt-6 text-ink-700 leading-relaxed">{bodyCopy.body}</p>
        <a href={localizedPath(lang, '/pregacoes')} class="mt-8 inline-flex btn btn-ghost">
          {bodyCopy.watchAll}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

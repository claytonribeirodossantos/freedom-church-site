---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Slideshow images — cross-fade automático no hero
const slides = [
  'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?w=2400&q=85&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?w=2400&q=85&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1543269865-cbf427effbad?w=2400&q=85&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1601379760883-1bb497ef661b?w=2400&q=85&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1490489944944-49b1c20da414?w=2400&q=85&auto=format&fit=crop',
];

const headline = {
  pt: ['Liberte-se', 'em', 'Cristo.'],
  en: ['Find', 'freedom in', 'Christ.'],
  es: ['Libérate', 'en', 'Cristo.'],
}[lang];

const sub = {
  pt: 'Igreja para todas as nações em Kensington, Maryland.\nDomingos · 10h30.',
  en: 'A church for every nation in Kensington, Maryland.\nSundays · 10:30 AM.',
  es: 'Una iglesia para todas las naciones en Kensington, Maryland.\nDomingos · 10:30 AM.',
}[lang];

const slideDuration = 6; // seconds each slide is visible
const total = slides.length;
const totalDuration = total * slideDuration;
---

<section class="relative min-h-screen overflow-hidden bg-ink-950 text-ink-50">
  <!-- Slideshow background -->
  <div class="absolute inset-0 overflow-hidden">
    {slides.map((src, i) => (
      <img
        src={src}
        alt=""
        class="hero-slide absolute inset-0 w-full h-full object-cover"
        style={`animation: hero-fade ${totalDuration}s ease-in-out ${i * slideDuration}s infinite; opacity: ${i === 0 ? 1 : 0};`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
      />
    ))}

    <!-- Overlays -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(5,5,5,0.55) 0%, rgba(5,5,5,0.7) 60%, rgba(5,5,5,0.92) 100%);"></div>
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(60% 80% at 25% 30%, rgba(201, 169, 97, 0.4), transparent 60%);"></div>
    <div class="absolute inset-0 grain"></div>
  </div>

  <!-- Top corner -->
  <div class="absolute top-24 lg:top-32 left-0 right-0 z-10">
    <div class="container-page flex items-start justify-between">
      <span class="eyebrow eyebrow-light animate-(--animate-fade-in)">
        {t('hero.eyebrow')}
      </span>
      <div class="hidden md:flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-ink-300 animate-(--animate-fade-in)">
        <span class="relative flex w-2 h-2">
          <span class="absolute inline-flex w-full h-full rounded-full bg-gold-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-gold-500"></span>
        </span>
        <span>{lang === 'pt' ? 'Kensington · Maryland · EUA' : lang === 'en' ? 'Kensington · Maryland · USA' : 'Kensington · Maryland · EUA'}</span>
      </div>
    </div>
  </div>

  <!-- Mega headline -->
  <div class="relative z-10 container-page min-h-screen flex flex-col justify-center pt-44 pb-32">
    <h1
      class="mega mt-12 text-ink-50"
      style="font-size: clamp(3.5rem, 11vw, 11rem)"
    >
      {headline.map((word, i) => (
        <span
          class="block animate-(--animate-blur-in)"
          style={`animation-delay: ${i * 140 + 200}ms`}
        >
          {i === headline.length - 1
            ? <span class="italic font-light text-gold-400">{word}</span>
            : word}
        </span>
      ))}
    </h1>

    <p
      class="mt-12 lg:mt-14 text-xl lg:text-2xl text-ink-200 leading-relaxed max-w-xl whitespace-pre-line animate-(--animate-fade-up)"
      style="animation-delay: 700ms"
    >
      {sub}
    </p>

    <div
      class="mt-12 flex flex-wrap items-center gap-4 animate-(--animate-fade-up)"
      style="animation-delay: 900ms"
    >
      <a href={localizedPath(lang, '/sou-novo-aqui')} class="btn btn-primary">
        {t('hero.cta.primary')}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href={localizedPath(lang, '/live')} class="btn btn-ghost-light" data-live-cta>
        <span class="relative flex w-2 h-2" data-live-dot>
          <span class="absolute inline-flex w-full h-full rounded-full bg-ink-500 opacity-75"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-ink-500"></span>
        </span>
        <span data-live-label>{t('hero.cta.secondary')}</span>
      </a>
    </div>

    <!-- Slideshow dots indicator -->
    <div class="absolute bottom-32 left-0 right-0 z-10">
      <div class="container-page flex items-center gap-2 justify-center md:justify-start">
        {slides.map((_, i) => (
          <span
            class="hero-dot block w-8 h-0.5 rounded-full bg-ink-50/30"
            style={`animation: hero-dot-fill ${totalDuration}s linear ${i * slideDuration}s infinite;`}
          ></span>
        ))}
      </div>
    </div>
  </div>

  <!-- Marquee de versículos -->
  <div class="absolute bottom-0 left-0 right-0 bg-ink-50 text-ink-950 py-5 overflow-hidden border-y border-ink-200">
    <div class="marquee">
      <div class="marquee-track marquee-track-slow">
        {[...Array(6)].flatMap((_, k) => [
          <span class="font-display italic text-lg whitespace-nowrap">João 8:32 — "Conhecereis a verdade, e a verdade vos libertará."</span>,
          <span class="text-gold-500">✦</span>,
          <span class="font-display italic text-lg whitespace-nowrap">2 Coríntios 3:17 — "Onde está o Espírito do Senhor, aí há liberdade."</span>,
          <span class="text-gold-500">✦</span>,
        ])}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes hero-fade {
    0%, 16% { opacity: 1; transform: scale(1.05); }
    20%, 96% { opacity: 0; transform: scale(1.15); }
    100% { opacity: 1; transform: scale(1.05); }
  }
  @keyframes hero-dot-fill {
    0%, 16% { background-color: var(--color-gold-500); }
    20%, 100% { background-color: rgba(250, 250, 247, 0.3); }
  }
</style>

---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Vídeo MP4 hospedado direto no projeto + imagem de fallback
const heroVideo = '/hero/intro.mp4';
const heroImage = 'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?w=2400&q=90&auto=format&fit=crop';

const headline = {
  pt: ['Seja livre', 'em', 'Cristo.'],
  en: ['Find', 'freedom in', 'Christ.'],
  es: ['Libérate', 'en', 'Cristo.'],
}[lang];

const sub = {
  pt: 'Igreja para todas as nações em Kensington, Maryland.\nDomingos · 10h30.',
  en: 'A church for every nation in Kensington, Maryland.\nSundays · 10:30 AM.',
  es: 'Una iglesia para todas las naciones en Kensington, Maryland.\nDomingos · 10:30 AM.',
}[lang];
---

<section class="relative min-h-screen overflow-hidden bg-ink-950 text-ink-50" data-hero>
  <!-- Background layers with depth (mouse parallax) -->
  <div class="absolute inset-0 overflow-hidden" data-hero-bg>
    <!-- Main video — moves slower with mouse + Ken Burns subtle -->
    <div class="absolute inset-0" data-parallax-layer="0.6">
      <video
        class="hero-video absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={heroImage}
        data-hero-video
      >
        <source src={heroVideo} type="video/mp4" />
      </video>
      <!-- Fallback image (mostrada se vídeo falhar) -->
      <img
        src={heroImage}
        alt=""
        class="hero-image-fallback absolute inset-0 w-full h-full object-cover hidden"
        loading="eager"
      />
    </div>

    <!-- Animated golden light leak — moves opposite -->
    <div class="absolute inset-0 hero-light-leak" data-parallax-layer="-0.3"></div>

    <!-- Floating particles (subtle) -->
    <div class="absolute inset-0 pointer-events-none" data-parallax-layer="-0.8">
      <div class="hero-particle absolute" style="top: 20%; left: 10%; animation-delay: 0s"></div>
      <div class="hero-particle absolute" style="top: 50%; left: 80%; animation-delay: 3s"></div>
      <div class="hero-particle absolute" style="top: 70%; left: 30%; animation-delay: 6s"></div>
      <div class="hero-particle absolute" style="top: 30%; left: 60%; animation-delay: 9s"></div>
      <div class="hero-particle absolute" style="top: 80%; left: 70%; animation-delay: 1.5s"></div>
    </div>

    <!-- Dark gradient overlay -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(5,5,5,0.55) 0%, rgba(5,5,5,0.7) 60%, rgba(5,5,5,0.95) 100%);"></div>

    <!-- Golden radial accent -->
    <div class="absolute inset-0 opacity-30 hero-glow" style="background: radial-gradient(60% 80% at 25% 30%, rgba(201, 169, 97, 0.45), transparent 60%);"></div>

    <!-- Grain texture -->
    <div class="absolute inset-0 grain"></div>
  </div>

  <!-- Top corner info -->
  <div class="absolute top-24 lg:top-32 left-0 right-0 z-10">
    <div class="container-page flex items-start justify-between">
      <span class="eyebrow eyebrow-light animate-(--animate-fade-in)">
        {t('hero.eyebrow')}
      </span>
      <div class="hidden md:flex items-center gap-3 text-xs uppercase tracking-[0.22em] text-ink-300 animate-(--animate-fade-in)">
        <span class="relative flex w-2 h-2">
          <span class="absolute inline-flex w-full h-full rounded-full bg-gold-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-gold-500"></span>
        </span>
        <span>{lang === 'pt' ? 'Kensington · Maryland · EUA' : lang === 'en' ? 'Kensington · Maryland · USA' : 'Kensington · Maryland · EUA'}</span>
      </div>
    </div>
  </div>

  <!-- Mega headline -->
  <div class="relative z-10 container-page min-h-screen flex flex-col justify-center pt-44 pb-32">
    <h1
      class="mega mt-12 text-ink-50"
      style="font-size: clamp(3rem, 11vw, 11rem)"
    >
      {headline.map((word, i) => (
        <span
          class="block animate-(--animate-blur-in)"
          style={`animation-delay: ${i * 140 + 200}ms`}
        >
          {i === headline.length - 1
            ? <span class="italic font-light text-gold-400">{word}</span>
            : word}
        </span>
      ))}
    </h1>

    <p
      class="mt-10 lg:mt-14 text-lg sm:text-xl lg:text-2xl text-ink-200 leading-relaxed max-w-xl whitespace-pre-line animate-(--animate-fade-up)"
      style="animation-delay: 700ms"
    >
      {sub}
    </p>

    <div
      class="mt-10 flex flex-wrap items-center gap-3 lg:gap-4 animate-(--animate-fade-up)"
      style="animation-delay: 900ms"
    >
      <a href={localizedPath(lang, '/sou-novo-aqui')} class="btn btn-primary">
        {t('hero.cta.primary')}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href={localizedPath(lang, '/live')} class="btn btn-ghost-light" data-live-cta>
        <span class="relative flex w-2 h-2" data-live-dot>
          <span class="absolute inline-flex w-full h-full rounded-full bg-ink-500 opacity-75"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-ink-500"></span>
        </span>
        <span data-live-label>{t('hero.cta.secondary')}</span>
      </a>
    </div>
  </div>

  <!-- Marquee de versículos -->
  <div class="absolute bottom-0 left-0 right-0 bg-ink-50 text-ink-950 py-5 overflow-hidden border-y border-ink-200">
    <div class="marquee">
      <div class="marquee-track marquee-track-slow">
        {[...Array(6)].flatMap((_, k) => [
          <span class="font-display italic text-base sm:text-lg whitespace-nowrap">João 8:32 — "Conhecereis a verdade, e a verdade vos libertará."</span>,
          <span class="text-gold-500">✦</span>,
          <span class="font-display italic text-base sm:text-lg whitespace-nowrap">2 Coríntios 3:17 — "Onde está o Espírito do Senhor, aí há liberdade."</span>,
          <span class="text-gold-500">✦</span>,
        ])}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Video subtle Ken Burns (not too aggressive since video already moves) */
  .hero-video {
    animation: hero-ken-burns 30s ease-in-out infinite alternate;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero-image-fallback-anim {
    animation: hero-ken-burns 25s ease-in-out infinite alternate;
    transform-origin: 30% 50%;
    will-change: transform;
  }
  @keyframes hero-ken-burns {
    0%   { transform: scale(1.0) translate(0, 0); }
    100% { transform: scale(1.08) translate(-1%, -0.5%); }
  }

  /* Animated golden light leak — moves continuously */
  .hero-light-leak {
    background:
      radial-gradient(circle at 20% 50%, rgba(201, 169, 97, 0.20), transparent 35%),
      radial-gradient(circle at 80% 30%, rgba(232, 160, 85, 0.18), transparent 30%),
      radial-gradient(circle at 50% 70%, rgba(201, 169, 97, 0.12), transparent 40%);
    animation: hero-light-leak 14s ease-in-out infinite alternate;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }
  @keyframes hero-light-leak {
    0%   { transform: translate(0, 0) scale(1) rotate(0deg);    opacity: 0.6; }
    33%  { transform: translate(3%, -2%) scale(1.05) rotate(2deg);  opacity: 0.9; }
    66%  { transform: translate(-2%, 3%) scale(0.95) rotate(-1deg); opacity: 0.7; }
    100% { transform: translate(2%, 2%) scale(1.03) rotate(1deg);   opacity: 0.85; }
  }

  /* Glow that pulses softly */
  .hero-glow {
    animation: hero-glow-pulse 8s ease-in-out infinite alternate;
  }
  @keyframes hero-glow-pulse {
    0%   { opacity: 0.25; }
    100% { opacity: 0.4; }
  }

  /* Floating particles */
  .hero-particle {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold-400);
    box-shadow: 0 0 12px var(--color-gold-500), 0 0 24px var(--color-gold-400);
    animation: hero-particle-float 12s ease-in-out infinite;
    opacity: 0;
  }
  @keyframes hero-particle-float {
    0%, 100% { opacity: 0; transform: translateY(0) scale(1); }
    20%      { opacity: 0.9; transform: translateY(-20px) scale(1.2); }
    50%      { opacity: 0.6; transform: translateY(-60px) scale(1); }
    80%      { opacity: 0.3; transform: translateY(-100px) scale(0.8); }
  }
</style>

<script>
  // Video fallback: if MP4 fails, swap to static image
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const imgFallback = document.querySelector<HTMLImageElement>('.hero-image-fallback');
  if (video && imgFallback) {
    let videoOk = false;
    video.addEventListener('loadeddata', () => { videoOk = true; });
    video.addEventListener('error', () => {
      video.classList.add('hidden');
      imgFallback.classList.remove('hidden');
      imgFallback.classList.add('hero-image-fallback-anim');
    });
    setTimeout(() => {
      if (!videoOk) {
        video.classList.add('hidden');
        imgFallback.classList.remove('hidden');
        imgFallback.classList.add('hero-image-fallback-anim');
      }
    }, 6000);
  }

  // Mouse parallax — different layers move at different rates
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const layers = document.querySelectorAll<HTMLElement>('[data-parallax-layer]');

  if (hero && layers.length > 0 && window.matchMedia('(pointer: fine)').matches) {
    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;

    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      // Normalize -1 to 1
      targetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      targetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
    });

    function animate() {
      // Smooth follow
      currentX += (targetX - currentX) * 0.06;
      currentY += (targetY - currentY) * 0.06;

      layers.forEach((layer) => {
        const speed = parseFloat(layer.dataset.parallaxLayer ?? '0');
        const x = currentX * speed * 30;
        const y = currentY * speed * 20;
        layer.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      });

      requestAnimationFrame(animate);
    }
    animate();
  }
</script>

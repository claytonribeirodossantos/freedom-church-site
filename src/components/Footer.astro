---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navColumns = {
  pt: [
    { title: 'Vivência', links: [
      { label: 'Cultos', href: '/cultos' },
      { label: 'Pregações', href: '/pregacoes' },
      { label: 'Eventos', href: '/eventos' },
      { label: 'Ao vivo', href: '/live' },
    ]},
    { title: 'Comunidade', links: [
      { label: 'Sobre', href: '/sobre' },
      { label: 'Liderança', href: '/lideranca' },
      { label: 'Ministérios', href: '/ministerios' },
      { label: 'Kids', href: '/kids' },
      { label: 'Jovens', href: '/jovens' },
    ]},
    { title: 'Ação', links: [
      { label: 'Sou Novo Aqui', href: '/sou-novo-aqui' },
      { label: 'Pedidos de Oração', href: '/pedidos-de-oracao' },
      { label: 'Contribua', href: '/contribua' },
      { label: 'Contato', href: '/contato' },
    ]},
  ],
  en: [
    { title: 'Connect', links: [
      { label: 'Services', href: '/cultos' },
      { label: 'Sermons', href: '/pregacoes' },
      { label: 'Events', href: '/eventos' },
      { label: 'Live', href: '/live' },
    ]},
    { title: 'Community', links: [
      { label: 'About', href: '/sobre' },
      { label: 'Leadership', href: '/lideranca' },
      { label: 'Ministries', href: '/ministerios' },
      { label: 'Kids', href: '/kids' },
      { label: 'Youth', href: '/jovens' },
    ]},
    { title: 'Engage', links: [
      { label: "I'm New Here", href: '/sou-novo-aqui' },
      { label: 'Prayer Requests', href: '/pedidos-de-oracao' },
      { label: 'Give', href: '/contribua' },
      { label: 'Contact', href: '/contato' },
    ]},
  ],
  es: [
    { title: 'Conexión', links: [
      { label: 'Cultos', href: '/cultos' },
      { label: 'Prédicas', href: '/pregacoes' },
      { label: 'Eventos', href: '/eventos' },
      { label: 'En vivo', href: '/live' },
    ]},
    { title: 'Comunidad', links: [
      { label: 'Nosotros', href: '/sobre' },
      { label: 'Liderazgo', href: '/lideranca' },
      { label: 'Ministerios', href: '/ministerios' },
      { label: 'Niños', href: '/kids' },
      { label: 'Jóvenes', href: '/jovens' },
    ]},
    { title: 'Acción', links: [
      { label: 'Soy Nuevo Aquí', href: '/sou-novo-aqui' },
      { label: 'Peticiones de Oración', href: '/pedidos-de-oracao' },
      { label: 'Ofrendar', href: '/contribua' },
      { label: 'Contacto', href: '/contato' },
    ]},
  ],
}[lang];
---

<footer class="relative bg-ink-950 text-cream-200 overflow-hidden mt-32">
  <!-- decorative gradient -->
  <div
    class="absolute inset-0 opacity-50"
    style="background: radial-gradient(60% 60% at 50% 0%, rgba(200, 71, 45, 0.18), transparent 60%);"
  ></div>

  <div class="container-page relative z-10 pt-24 lg:pt-32 pb-12">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 pb-20">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-4">
          <img src="/logo.png" alt="" class="w-14 h-14 object-contain invert" loading="lazy" />
          <span class="font-display text-3xl font-medium text-cream-50">
            Freedom <span class="italic font-light text-clay-400">Church</span>
          </span>
        </div>
        <p class="mt-8 font-display italic text-2xl lg:text-3xl text-cream-100 leading-snug max-w-md">
          "{church.tagline[lang]}"
        </p>
        <p class="mt-6 text-cream-400 text-sm max-w-md leading-relaxed">
          {lang === 'pt'
            ? 'Uma comunidade de fé para todas as nações em Kensington, Maryland. Brasileiros, americanos, latinos — todos são bem-vindos. Cultos aos domingos às 10h30.'
            : lang === 'en'
              ? 'A community of faith for every nation in Kensington, Maryland. Brazilians, Americans, Latinos — everyone is welcome. Sunday services at 10:30 AM.'
              : 'Una comunidad de fe para todas las naciones en Kensington, Maryland. Brasileños, americanos, latinos — todos son bienvenidos. Cultos los domingos a las 10:30 AM.'}
        </p>

        <div class="mt-10 flex gap-3">
          <a href={church.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-11 h-11 inline-flex items-center justify-center rounded-full border border-ink-700 hover:border-clay-500 hover:bg-clay-500 hover:text-cream-50 transition-all">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 0 0-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.73 1.46 1.38 2.13.67.65 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.73 2.13-1.38a5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
          </a>
          <a href={church.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="w-11 h-11 inline-flex items-center justify-center rounded-full border border-ink-700 hover:border-clay-500 hover:bg-clay-500 hover:text-cream-50 transition-all">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
          </a>
        </div>
        <p class="mt-4 text-xs text-cream-500">{church.social.instagramHandle}</p>
      </div>

      <div class="lg:col-span-4 grid grid-cols-3 gap-6">
        {navColumns.map((col) => (
          <div>
            <h4 class="text-xs font-semibold text-amber-400 uppercase tracking-[0.18em] mb-5">
              {col.title}
            </h4>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={localizedPath(lang, link.href)} class="text-sm text-cream-300 hover:text-clay-400 transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="lg:col-span-3">
        <h4 class="text-xs font-semibold text-amber-400 uppercase tracking-[0.18em] mb-5">
          {t('footer.address')}
        </h4>
        <address class="not-italic text-sm text-cream-300 leading-relaxed">
          {church.address.street}<br />
          {church.address.city}, {church.address.state} {church.address.zip}<br />
          {church.address.country}
        </address>
        <a href={church.address.googleMapsUrl} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-sm text-clay-400 hover:text-clay-300 font-medium group">
          {lang === 'pt' ? 'Ver no mapa' : lang === 'en' ? 'View on map' : 'Ver en el mapa'}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <h4 class="mt-10 text-xs font-semibold text-amber-400 uppercase tracking-[0.18em] mb-3">
          {lang === 'pt' ? 'Próximo culto' : lang === 'en' ? 'Next service' : 'Próximo culto'}
        </h4>
        <p class="text-2xl font-display text-cream-50">
          {lang === 'pt' ? 'Domingo · 10h30' : lang === 'en' ? 'Sunday · 10:30 AM' : 'Domingo · 10:30 AM'}
        </p>
      </div>
    </div>

    <hr class="border-ink-800" />

    <div class="mt-10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-cream-500">
      <p>© {year} Freedom Church. {t('footer.rights')}</p>
      <nav class="flex gap-6">
        <a href={localizedPath(lang, '/privacidade')} class="hover:text-cream-200 transition-colors">
          {lang === 'pt' ? 'Privacidade' : lang === 'en' ? 'Privacy' : 'Privacidad'}
        </a>
        <a href={localizedPath(lang, '/termos')} class="hover:text-cream-200 transition-colors">
          {lang === 'pt' ? 'Termos' : lang === 'en' ? 'Terms' : 'Términos'}
        </a>
      </nav>
    </div>
  </div>
</footer>

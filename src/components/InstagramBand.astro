---
import { getLangFromUrl } from '../i18n/utils';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);

const copy = {
  pt: {
    eyebrow: 'Siga a gente',
    title: 'É no Instagram que tudo',
    titleEm: 'acontece primeiro.',
    desc: 'Stories do dia a dia, bastidores, avisos de evento, palavra e os momentos da nossa família. Toque para seguir e não perder nada.',
    cta: 'Seguir no Instagram',
  },
  en: {
    eyebrow: 'Follow us',
    title: 'Instagram is where it all',
    titleEm: 'happens first.',
    desc: 'Daily stories, behind the scenes, event updates, the Word, and our family moments. Tap to follow and never miss a thing.',
    cta: 'Follow on Instagram',
  },
  es: {
    eyebrow: 'Síguenos',
    title: 'En Instagram es donde todo',
    titleEm: 'pasa primero.',
    desc: 'Stories del día a día, detrás de cámaras, avisos de eventos, la Palabra y los momentos de nuestra familia. Toca para seguir y no perderte nada.',
    cta: 'Seguir en Instagram',
  },
}[lang];

const marquee = `${church.social.instagramHandle}  ✦  `;
---

<section class="relative bg-ink-950 text-cream-50 overflow-hidden py-24 lg:py-32 grain">
  <!-- animated gradient glows -->
  <div
    class="absolute -top-1/3 left-1/4 w-[40rem] h-[40rem] rounded-full opacity-40 blur-3xl animate-(--animate-float)"
    style="background: radial-gradient(circle, rgba(201,169,97,0.35), transparent 70%);"
  ></div>
  <div
    class="absolute -bottom-1/3 right-1/4 w-[36rem] h-[36rem] rounded-full opacity-30 blur-3xl animate-(--animate-pulse-soft)"
    style="background: radial-gradient(circle, rgba(228,99,71,0.30), transparent 70%);"
  ></div>

  <div class="container-page relative z-10">
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <span class="eyebrow eyebrow-light justify-center">{copy.eyebrow}</span>

      <!-- floating instagram glyph -->
      <div class="mt-8 mb-2 flex justify-center">
        <div class="w-20 h-20 rounded-3xl flex items-center justify-center animate-(--animate-float)"
          style="background: linear-gradient(45deg, #feda75 0%, #fa7e1e 25%, #d62976 50%, #962fbf 75%, #4f5bd5 100%);">
          <svg width="40" height="40" fill="#fff" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 0 0-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.73 1.46 1.38 2.13.67.65 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.73 2.13-1.38a5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
        </div>
      </div>

      <h2 class="mt-6 mega text-cream-50" style="font-size: clamp(2.25rem, 6vw, 4.5rem)">
        {copy.title} <em class="italic font-light text-gold-400">{copy.titleEm}</em>
      </h2>
      <p class="mt-6 text-lg text-ink-300 max-w-xl mx-auto leading-relaxed">{copy.desc}</p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={church.social.instagram}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 px-7 py-4 rounded-full font-medium text-white transition-all hover:-translate-y-1 hover:shadow-[0_18px_40px_-12px_rgba(214,41,118,0.7)]"
          style="background: linear-gradient(45deg, #feda75 0%, #fa7e1e 25%, #d62976 50%, #962fbf 75%, #4f5bd5 100%);"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" class="transition-transform group-hover:rotate-12"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Z"/></svg>
          {copy.cta}
        </a>

        {church.social.facebook && (
          <a
            href={church.social.facebook}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-3 px-7 py-4 rounded-full font-medium text-white transition-all hover:-translate-y-1 hover:shadow-[0_18px_40px_-12px_rgba(24,119,242,0.7)]"
            style="background: #1877F2;"
          >
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" class="transition-transform group-hover:rotate-12"><path d="M15.5 8.5h2.2V5.13c-.38-.05-1.69-.16-3.22-.16-3.19 0-5.37 1.95-5.37 5.52v2.51H6.06v3.46h3.05V24h3.74v-7.54h2.93l.46-3.46h-3.39v-2.17c0-1 .27-1.83 1.65-1.83Z"/></svg>
            Facebook
          </a>
        )}

        <a
          href={church.social.youtube}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 px-7 py-4 rounded-full font-medium text-white transition-all hover:-translate-y-1 hover:shadow-[0_18px_40px_-12px_rgba(255,0,0,0.6)]"
          style="background: #FF0000;"
        >
          <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24" class="transition-transform group-hover:rotate-12"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
          YouTube
        </a>
      </div>
    </div>
  </div>

  <!-- marquee strip -->
  <div class="marquee mt-16 opacity-90" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 8 }).map(() => (
        <span class="font-display italic text-3xl lg:text-5xl text-ink-700 whitespace-nowrap">{marquee}</span>
      ))}
    </div>
    <div class="marquee-track" aria-hidden="true">
      {Array.from({ length: 8 }).map(() => (
        <span class="font-display italic text-3xl lg:text-5xl text-ink-700 whitespace-nowrap">{marquee}</span>
      ))}
    </div>
  </div>
</section>

---
import { getLangFromUrl } from '../i18n/utils';
import { getPageContent } from '../i18n/pages';

interface Props {
  pageKey: string;
}

const { pageKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const c = getPageContent(pageKey, lang);
const titleLines = c.title.split('\n');
---

<section class="relative bg-ink-950 text-ink-50 overflow-hidden">
  <div
    class="absolute inset-0 opacity-30"
    style="background-image: radial-gradient(circle at 20% 30%, rgba(201,169,97,0.30), transparent 55%);"
  ></div>
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;"
  ></div>

  <div class="container-page relative z-10 py-24 lg:py-32">
    <div class="max-w-3xl">
      <span class="eyebrow !text-gold-400 animate-(--animate-fade-in)">{c.eyebrow}</span>
      <h1
        class="mt-5 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-medium leading-[1.05] tracking-tight animate-(--animate-fade-up)"
        style="animation-delay: 80ms"
      >
        {titleLines.map((line, i) => (
          <span class="block">
            {i === titleLines.length - 1 && titleLines.length > 1
              ? <span class="italic text-gold-400 font-light">{line}</span>
              : line}
          </span>
        ))}
      </h1>
      <p
        class="mt-6 text-lg text-ink-300 max-w-2xl leading-relaxed animate-(--animate-fade-up)"
        style="animation-delay: 200ms"
      >
        {c.subtitle}
      </p>
    </div>
  </div>
</section>

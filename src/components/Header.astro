---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { church } from '../data/church';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const followLabel = { pt: 'Seguir no Instagram', en: 'Follow on Instagram', es: 'Seguir en Instagram' }[lang];

// Mega menu — simplificado estilo transformchurch.us (4 itens principais)
const menu = {
  pt: [
    {
      label: 'Sobre',
      href: '/sobre',
      children: [
        { label: 'Quem somos', href: '/sobre' },
        { label: 'Liderança', href: '/lideranca' },
        { label: 'Sou novo aqui', href: '/sou-novo-aqui' },
      ],
    },
    {
      label: 'Conecte-se',
      href: '/cultos',
      children: [
        { label: 'Cultos', href: '/cultos' },
        { label: 'Pregações', href: '/pregacoes' },
        { label: 'Eventos', href: '/eventos' },
        { label: 'Galeria', href: '/galeria' },
        { label: 'Serviços pastorais', href: '/servicos-pastorais' },
      ],
    },
    {
      label: 'Ministérios',
      href: '/ministerios',
      children: [
        { label: 'Freedom Kids', href: '/kids' },
        { label: 'Freedom Youth', href: '/jovens' },
        { label: 'Todos os ministérios', href: '/ministerios' },
      ],
    },
    { label: 'Contribua', href: '/contribua' },
  ],
  en: [
    {
      label: 'About',
      href: '/sobre',
      children: [
        { label: 'Who we are', href: '/sobre' },
        { label: 'Leadership', href: '/lideranca' },
        { label: "I'm new here", href: '/sou-novo-aqui' },
      ],
    },
    {
      label: 'Connect',
      href: '/cultos',
      children: [
        { label: 'Services', href: '/cultos' },
        { label: 'Sermons', href: '/pregacoes' },
        { label: 'Events', href: '/eventos' },
        { label: 'Gallery', href: '/galeria' },
        { label: 'Pastoral services', href: '/servicos-pastorais' },
      ],
    },
    {
      label: 'Ministries',
      href: '/ministerios',
      children: [
        { label: 'Freedom Kids', href: '/kids' },
        { label: 'Freedom Youth', href: '/jovens' },
        { label: 'All ministries', href: '/ministerios' },
      ],
    },
    { label: 'Give', href: '/contribua' },
  ],
  es: [
    {
      label: 'Nosotros',
      href: '/sobre',
      children: [
        { label: 'Quiénes somos', href: '/sobre' },
        { label: 'Liderazgo', href: '/lideranca' },
        { label: 'Soy nuevo aquí', href: '/sou-novo-aqui' },
      ],
    },
    {
      label: 'Conéctate',
      href: '/cultos',
      children: [
        { label: 'Cultos', href: '/cultos' },
        { label: 'Prédicas', href: '/pregacoes' },
        { label: 'Eventos', href: '/eventos' },
        { label: 'Galería', href: '/galeria' },
        { label: 'Servicios pastorales', href: '/servicos-pastorais' },
      ],
    },
    {
      label: 'Ministerios',
      href: '/ministerios',
      children: [
        { label: 'Freedom Kids', href: '/kids' },
        { label: 'Freedom Youth', href: '/jovens' },
        { label: 'Todos los ministerios', href: '/ministerios' },
      ],
    },
    { label: 'Ofrendar', href: '/contribua' },
  ],
}[lang];

const liveLabel = { pt: 'Ao vivo', en: 'Live', es: 'En vivo' }[lang];
const nextLabel = { pt: 'Domingo · 10h30', en: 'Sunday · 10:30 AM', es: 'Domingo · 10:30 AM' }[lang];
const newHereLabel = t('nav.newHere');
---

<header
  class="fixed inset-x-0 top-0 z-40 transition-all duration-500 bg-ink-50/85 backdrop-blur-xl border-b border-ink-200/50"
  data-header
>
  <div class="container-page flex items-center justify-between h-20 lg:h-24">
    <a href={localizedPath(lang, '/')} class="flex items-center gap-3 group shrink-0">
      <img
        src="/logo.svg"
        alt="Freedom Church"
        class="w-10 h-10 lg:w-11 lg:h-11 object-contain transition-transform duration-500 group-hover:rotate-[8deg]"
      />
      <span class="hidden sm:block font-display text-lg lg:text-xl font-medium tracking-tight text-ink-950">
        Freedom <span class="italic font-light text-gold-500">Church</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
      {menu.map((item) => (
        item.children ? (
          <div class="relative group" data-dropdown>
            <button
              type="button"
              class="nav-underline flex items-center gap-1 text-sm font-medium text-ink-700 hover:text-gold-600 transition-colors py-2"
              data-dropdown-toggle
            >
              {item.label}
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:rotate-180 mt-px"><path d="m3 4 3 3 3-3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[240px]">
              <div class="bg-ink-50 border border-ink-200 rounded-2xl shadow-xl py-2 overflow-hidden">
                {item.children.map((child) => (
                  <a
                    href={localizedPath(lang, child.href)}
                    class="block px-5 py-2.5 text-sm text-ink-700 hover:bg-ink-100 hover:text-gold-600 transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={localizedPath(lang, item.href)}
            class="nav-underline text-sm font-medium text-ink-700 hover:text-gold-600 transition-colors"
          >
            {item.label}
          </a>
        )
      ))}

      <a
        href={localizedPath(lang, '/live')}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-700 hover:text-gold-600 transition-colors"
        data-live-cta
        title={nextLabel}
      >
        <span class="relative flex w-2 h-2" data-live-dot>
          <span class="absolute inline-flex w-full h-full rounded-full bg-ink-400 opacity-75"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-ink-400"></span>
        </span>
        <span data-live-label>{liveLabel}</span>
      </a>

      <a
        href={church.social.instagram}
        target="_blank"
        rel="noopener"
        aria-label={followLabel}
        title={followLabel}
        class="inline-flex items-center justify-center w-9 h-9 rounded-full text-ink-700 hover:text-cream-50 transition-all duration-300 hover:scale-110"
        style="background-image: linear-gradient(135deg, #C9A961, #E46347 55%, #A85AAE); background-size: 0% 0%; background-repeat: no-repeat; background-position: center;"
        onmouseover="this.style.backgroundSize='150% 150%'"
        onmouseout="this.style.backgroundSize='0% 0%'"
      >
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
      </a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <LanguageSwitcher />
      <a
        href={localizedPath(lang, '/sou-novo-aqui')}
        class="hidden md:inline-flex items-center gap-1.5 text-sm font-medium text-ink-900 border border-ink-300/70 hover:border-ink-950 hover:bg-ink-950 hover:text-cream-50 rounded-full py-2 px-4 transition-all whitespace-nowrap"
      >
        {newHereLabel}
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button
        type="button"
        class="lg:hidden p-2 -mr-2 text-ink-900"
        aria-label="Menu"
        data-mobile-menu-toggle
      >
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" data-icon-open>
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" data-icon-close class="hidden">
          <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (full-screen overlay) -->
  <div
    class="lg:hidden hidden fixed left-0 right-0 top-20 z-30 bg-ink-50 overflow-y-auto"
    style="height: calc(100dvh - 5rem);"
    data-mobile-menu
  >
    <nav class="container-page py-8 pb-32 flex flex-col gap-1">
      {menu.map((item) => (
        item.children ? (
          <details class="group border-b border-ink-200/70 py-2">
            <summary class="flex items-center justify-between py-3 text-2xl font-display font-medium text-ink-900 cursor-pointer">
              {item.label}
              <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="text-gold-500 transition-transform group-open:rotate-180">
                <path d="m6 9 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="pl-2 pb-3 flex flex-col gap-1">
              {item.children.map((child) => (
                <a
                  href={localizedPath(lang, child.href)}
                  class="py-2.5 text-base text-ink-700 hover:text-gold-600 transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={localizedPath(lang, item.href)}
            class="border-b border-ink-200/70 py-5 text-2xl font-display font-medium text-ink-900 hover:text-gold-600 transition-colors"
          >
            {item.label}
          </a>
        )
      ))}

      <a
        href={localizedPath(lang, '/live')}
        class="border-b border-ink-200/70 py-5 inline-flex items-center gap-3 text-2xl font-display font-medium text-ink-900 hover:text-gold-600 transition-colors"
        data-live-cta
      >
        <span class="w-2.5 h-2.5 rounded-full bg-ink-400" data-live-dot></span>
        <span data-live-label>{liveLabel}</span>
      </a>

      <a
        href={localizedPath(lang, '/sou-novo-aqui')}
        class="mt-8 btn btn-primary text-base py-4"
      >
        {newHereLabel}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <a
        href={church.social.instagram}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-full py-4 text-base font-medium text-cream-50"
        style="background: linear-gradient(135deg, #C9A961, #E46347 55%, #A85AAE);"
      >
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Z"/></svg>
        {followLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconOpen = toggle?.querySelector<HTMLElement>('[data-icon-open]');
  const iconClose = toggle?.querySelector<HTMLElement>('[data-icon-close]');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  // Close mobile menu when clicking a link
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });

  // Stronger shadow when scrolled
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 30) {
      header.classList.add('shadow-md');
    } else {
      header.classList.remove('shadow-md');
    }
  }, { passive: true });
</script>

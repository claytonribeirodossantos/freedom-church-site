---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nav = [
  { key: 'nav.about' as const, href: '/sobre' },
  { key: 'nav.services' as const, href: '/cultos' },
  { key: 'nav.sermons' as const, href: '/pregacoes' },
  { key: 'nav.events' as const, href: '/eventos' },
  { key: 'nav.ministries' as const, href: '/ministerios' },
  { key: 'nav.give' as const, href: '/contribua' },
];

const liveLabel = { pt: 'Ao vivo', en: 'Live', es: 'En vivo' }[lang];
const nextLabel = { pt: 'Domingo · 10h30', en: 'Sunday · 10:30 AM', es: 'Domingo · 10:30 AM' }[lang];
---

<header
  class="fixed inset-x-0 top-0 z-40 transition-all duration-500 header-light"
  data-header
>
  <div class="container-page flex items-center justify-between h-20 lg:h-24">
    <a href={localizedPath(lang, '/')} class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="Freedom Church"
        class="header-logo w-11 h-11 lg:w-12 lg:h-12 object-contain transition-all duration-500 group-hover:rotate-[8deg]"
      />
      <span class="header-brand hidden sm:block font-display text-xl lg:text-2xl font-medium tracking-tight">
        Freedom <span class="italic font-light text-gold-500">Church</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {nav.map((item) => (
        <a
          href={localizedPath(lang, item.href)}
          class="header-link text-sm font-medium transition-colors"
        >
          {t(item.key)}
        </a>
      ))}
      <a
        href={localizedPath(lang, '/live')}
        class="header-link inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
        data-live-cta
        title={nextLabel}
      >
        <span class="relative flex w-2 h-2" data-live-dot>
          <span class="absolute inline-flex w-full h-full rounded-full bg-ink-400 opacity-75"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-ink-400"></span>
        </span>
        <span data-live-label>{liveLabel}</span>
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <LanguageSwitcher />
      <a
        href={localizedPath(lang, '/sou-novo-aqui')}
        class="header-pill hidden md:inline-flex items-center gap-1.5 text-sm font-medium rounded-full py-2 px-5 transition-all"
      >
        {t('nav.newHere')}
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button
        type="button"
        class="header-link lg:hidden p-2 -mr-2"
        aria-label="Menu"
        data-mobile-menu-toggle
      >
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    class="lg:hidden hidden border-t border-ink-200/60 bg-ink-50/95 backdrop-blur-md"
    data-mobile-menu
  >
    <nav class="container-page py-6 flex flex-col gap-1">
      {nav.map((item) => (
        <a
          href={localizedPath(lang, item.href)}
          class="py-3 text-lg font-display font-medium text-ink-900 hover:text-gold-600 transition-colors"
        >
          {t(item.key)}
        </a>
      ))}
      <a
        href={localizedPath(lang, '/live')}
        class="py-3 inline-flex items-center gap-2 text-lg font-display font-medium text-ink-900 hover:text-gold-600 transition-colors"
        data-live-cta
      >
        <span class="w-2 h-2 rounded-full bg-ink-400" data-live-dot></span>
        <span data-live-label>{liveLabel}</span>
      </a>
      <a
        href={localizedPath(lang, '/sou-novo-aqui')}
        class="mt-4 btn btn-primary"
      >
        {t('nav.newHere')}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Default (over light or when scrolled): dark text */
  .header-light .header-link,
  .header-light .header-brand {
    color: var(--color-ink-700);
  }
  .header-light .header-link:hover,
  .header-light .header-brand:hover {
    color: var(--color-gold-600);
  }
  .header-light .header-brand {
    color: var(--color-ink-950);
  }
  .header-light .header-pill {
    color: var(--color-ink-900);
    border: 1px solid rgba(40, 36, 30, 0.25);
  }
  .header-light .header-pill:hover {
    background: var(--color-ink-950);
    color: var(--color-cream-50);
    border-color: var(--color-ink-950);
  }
  .header-light .header-logo {
    filter: none;
  }

  /* Over dark hero (top of page with dark hero): light text */
  .header-on-dark .header-link,
  .header-on-dark .header-brand {
    color: var(--color-ink-100);
  }
  .header-on-dark .header-link:hover,
  .header-on-dark .header-brand:hover {
    color: var(--color-gold-400);
  }
  .header-on-dark .header-brand {
    color: var(--color-cream-50);
  }
  .header-on-dark .header-pill {
    color: var(--color-cream-50);
    border: 1px solid rgba(250, 250, 247, 0.35);
  }
  .header-on-dark .header-pill:hover {
    background: var(--color-cream-50);
    color: var(--color-ink-950);
    border-color: var(--color-cream-50);
  }
  .header-on-dark .header-logo {
    /* Invert preto → branco */
    filter: invert(1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Dynamically adapt header colors based on what's behind it
  function updateHeaderTheme() {
    if (!header) return;
    const y = window.scrollY;
    const headerHeight = header.offsetHeight;

    // Find what section is currently behind the top of header
    const sampleY = headerHeight / 2;
    const elementBehind = document.elementFromPoint(window.innerWidth / 2, sampleY);

    // Walk up from the element to find the nearest section with bg info
    let isDark = false;
    let cur: HTMLElement | null = elementBehind as HTMLElement | null;
    while (cur && cur !== document.body) {
      const bg = window.getComputedStyle(cur).backgroundColor;
      // Parse RGB(A) and check if it's a dark color
      const match = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (match) {
        const [r, g, b] = [+match[1], +match[2], +match[3]];
        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        if (luminance < 0.5) {
          isDark = true;
          break;
        }
        // If we found a non-transparent light bg, we're done — header should be dark text
        if (!bg.includes('rgba') || !bg.endsWith(', 0)')) {
          break;
        }
      }
      cur = cur.parentElement;
    }

    // When scrolled, header has cream/light bg (so dark text always)
    const isScrolled = y > 30;

    if (isScrolled) {
      header.classList.remove('header-on-dark');
      header.classList.add('header-light');
      header.classList.add('bg-cream-50/90', 'backdrop-blur-xl', 'border-b', 'border-ink-200/40');
    } else {
      header.classList.remove('bg-cream-50/90', 'backdrop-blur-xl', 'border-b', 'border-ink-200/40');
      if (isDark) {
        header.classList.add('header-on-dark');
        header.classList.remove('header-light');
      } else {
        header.classList.add('header-light');
        header.classList.remove('header-on-dark');
      }
    }
  }

  // Run on load + scroll
  updateHeaderTheme();
  window.addEventListener('scroll', updateHeaderTheme, { passive: true });
  window.addEventListener('resize', updateHeaderTheme, { passive: true });
  // Also re-check after small delay to catch initial render
  setTimeout(updateHeaderTheme, 100);
  setTimeout(updateHeaderTheme, 500);
</script>

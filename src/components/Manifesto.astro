---
import { getLangFromUrl, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  pt: {
    eyebrow: 'Nossa igreja',
    statement: 'Nossa igreja é um lugar de adoração, comunhão e crescimento espiritual, onde juntos buscamos nos aproximar de Deus através da Sua Palavra e da presença do Espírito Santo.',
    invite: 'Venha participar dos nossos cultos e descubra o que Deus está fazendo em nosso meio.',
    cta: 'Venha como você é',
    btn: 'Visitar este domingo',
  },
  en: {
    eyebrow: 'Our church',
    statement: 'Our church is a place of worship, fellowship and spiritual growth, where together we seek to draw closer to God through His Word and the presence of the Holy Spirit.',
    invite: 'Come join our services and discover what God is doing among us.',
    cta: 'Come as you are',
    btn: 'Visit this Sunday',
  },
  es: {
    eyebrow: 'Nuestra iglesia',
    statement: 'Nuestra iglesia es un lugar de adoración, comunión y crecimiento espiritual, donde juntos buscamos acercarnos a Dios a través de Su Palabra y de la presencia del Espíritu Santo.',
    invite: 'Ven a participar de nuestros cultos y descubre lo que Dios está haciendo en medio de nosotros.',
    cta: 'Ven tal como eres',
    btn: 'Visitar este domingo',
  },
}[lang];

const keywords = {
  pt: ['Liberdade', 'Família', 'Palavra', 'Esperança', 'Comunidade', 'Missão', 'Gratidão', 'Cura'],
  en: ['Freedom', 'Family', 'The Word', 'Hope', 'Community', 'Mission', 'Gratitude', 'Healing'],
  es: ['Libertad', 'Familia', 'La Palabra', 'Esperanza', 'Comunidad', 'Misión', 'Gratitud', 'Sanidad'],
}[lang];
---

<section class="relative bg-ink-50 py-32 lg:py-40 overflow-hidden">
  <!-- decorative cross at edge -->
  <div
    class="absolute -top-12 -right-32 w-[36rem] h-[36rem] opacity-[0.05] animate-(--animate-float)"
    data-parallax="0.1"
  >
    <img src="/logo.png" alt="" class="w-full h-full object-contain" loading="lazy" />
  </div>

  <div class="container-page relative z-10">
    <div class="mb-10 lg:mb-12" data-reveal>
      <span class="eyebrow">{copy.eyebrow}</span>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-end" data-reveal>
      <div class="lg:col-span-8">
        <p class="font-display text-ink-950 leading-[1.18]" style="font-size: clamp(1.75rem, 4vw, 3.25rem)">
          {copy.statement}
        </p>
        <p class="mt-8 text-lg lg:text-xl text-ink-700 leading-relaxed max-w-2xl">
          {copy.invite}
        </p>
      </div>
      <div class="lg:col-span-4 lg:text-right" data-reveal data-reveal-delay="1">
        <div class="text-sm text-ink-500 mb-3">{copy.cta}</div>
        <a href={localizedPath(lang, '/sou-novo-aqui')} class="btn btn-dark">
          {copy.btn}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Marquee de palavras-chave -->
  <div class="relative z-10 mt-32 marquee">
    <div class="marquee-track">
      {[...Array(4)].flatMap((_) =>
        keywords.flatMap((k) => [
          <span class="font-display text-6xl lg:text-8xl text-ink-200 whitespace-nowrap" style="font-weight: 300">{k}</span>,
          <span class="text-gold-500 text-3xl">✦</span>,
        ])
      )}
    </div>
  </div>
</section>
